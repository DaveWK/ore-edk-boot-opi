INF MdeModulePkg/Bus/Usb/UsbMassStorageDxe/UsbMassStorageDxe.inf
INF Silicon/Spacemit/K1/Drivers/UsbHcdInitDxe/UsbHcd.inf

#
# Spinor flash support
#
INF Silicon/Spacemit/K1/Drivers/QspiDxe/QspiDxe.inf
INF Silicon/Spacemit/Drivers/Spi/SpiNorFlashDxe/SpiNorFlashDxe.inf

#
# GOP support
#
INF Silicon/Spacemit/K1/Drivers/HdmiGraphicsOutputDxe/HdmiGraphicsOutputDxe.inf

#
# Firmware Volume Block service
#
INF Silicon/Spacemit/Drivers/FlashFvbDxe/FlashFvbDxe.inf

# I2C Master Driver
INF MdeModulePkg/Bus/I2c/I2cDxe/I2cDxe.inf
INF Silicon/Spacemit/Drivers/I2CMaster/I2CMaster/I2cMaster.inf

# EEPROM Driver
INF Silicon/Spacemit/Drivers/I2CMaster/Eeprom/EepromDxe.inf

#
# GPIO support
#
INF Silicon/Spacemit/K1/Drivers/GPIO/K1xGpioDxe.inf

# boot logo
INF Silicon/Spacemit/Drivers/LogoDxe/LogoDxe.inf

#
# LED support
#
INF Silicon/Spacemit/K1/Drivers/LedControl/LedControl.inf

#
# TLV EEPROM support
#
INF Silicon/Spacemit/Drivers/I2CMaster/Tlv_Eeprom/TlvEeprom.inf

# platform info
INF Silicon/Spacemit/K1/Drivers/PlatformInfoDxe/PlatformInfoDxe.inf

#
# PCI
#
INF Silicon/Spacemit/Drivers/PciCpuIo2Dxe/PciCpuIo2Dxe.inf
INF Silicon/Spacemit/Override/MdeModulePkg/Bus/Pci/PciBusDxe/PciBusDxe.inf
INF Silicon/Spacemit/Override/MdeModulePkg/Bus/Pci/PciHostBridgeDxe/PciHostBridgeDxe.inf

#
# NVMe boot devices
#
INF MdeModulePkg/Bus/Pci/NvmExpressDxe/NvmExpressDxe.inf

#
# SMBIOS info
#
INF Silicon/Spacemit/K1/Drivers/PlatformSmbiosDxe/PlatformSmbiosDxe.inf

#
# HII
#

################################################################################
[FV.FVMAIN_COMPACT]
FvAlignment        = 16
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE
FvNameGuid         = 06486C29-CDFA-4FBE-8732-8EA1CC0168D6

INF Silicon/Spacemit/Sec/SecMain.inf

FILE FV_IMAGE = 91DA8A5D-2469-49C0-8E37-CA55B92F03E6 {
   # gLzmaCustomDecompressGuid =
   #   { 0xEE4E5898, 0x3914, 0x4259, { 0x9D, 0x6E, 0xDC, 0x7B, 0xD7, 0x94, 0x03, 0xCF }}
   SECTION GUIDED EE4E5898-3914-4259-9D6E-DC7BD79403CF PROCESSING_REQUIRED = TRUE {
     SECTION FV_IMAGE = DXEFV
   }
 }

!include Silicon/Spacemit/SpacemitFvRules.fdf.inc
