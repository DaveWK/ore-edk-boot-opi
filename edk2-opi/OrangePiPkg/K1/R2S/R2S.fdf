#
INF Silicon/Spacemit/Drivers/MmcDxe/MmcDxe.inf
INF Silicon/Spacemit/K1/Drivers/SdHostDxe/SdHostDxe.inf

#
# USB Support
#
INF Silicon/Spacemit/Override/MdeModulePkg/Bus/Pci/NonDiscoverablePciDeviceDxe/NonDiscoverablePciDeviceDxe.inf
INF Silicon/Spacemit/Override/MdeModulePkg/Bus/Pci/EhciDxe/EhciDxe.inf
INF MdeModulePkg/Bus/Pci/XhciDxe/XhciDxe.inf
INF MdeModulePkg/Bus/Usb/UsbBusDxe/UsbBusDxe.inf
