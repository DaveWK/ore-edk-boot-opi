+      - sizeof (EFI_ACPI_6_6_RIMT_IOMMU_NODE_STRUCTURE_HEADER))                       \
+      / sizeof (EFI_ACPI_6_6_RIMT_IOMMU_NODE_INTERRUPT_WIRE_STRUCTURE),               \
