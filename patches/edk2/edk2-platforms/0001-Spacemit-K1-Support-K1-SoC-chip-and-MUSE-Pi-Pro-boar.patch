+  BOOLEAN           IsEmmc;
+  BOOLEAN           IsMultiBlock;
+} BM_MMC_PARAMS;
+
+typedef struct {
+  UINTN                 Signature;
+  EFI_HANDLE            Handle;
+  EFI_MMC_HOST_PROTOCOL MmcHost;
+  EMBEDDED_GPIO         *Gpio;
+  BM_MMC_PARAMS         BmParams;
