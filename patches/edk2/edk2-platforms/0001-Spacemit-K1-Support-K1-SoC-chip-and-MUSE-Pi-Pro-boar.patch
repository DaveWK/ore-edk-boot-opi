+#include <Uefi.h>
+#include <Library/BaseLib.h>
+#include <Library/IoLib.h>
+#include <Library/DebugLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+
+#include "PlatformInfoDxe.h"
+
+#define MAX_FREQ_LV  7
+
+#define AP_ALLOW_FREQ_CHG        BIT18
+#define MC_REG_TABLE_EN          BIT10
+#define AP_DCLK_FC_DONE_INT_MSK  BIT15
+
+#define PMUAP_REG(n)  (K1_APMU_BASE + n)
+#define PMU_CC_CP  PMUAP_REG(0x000)
+/* sub-bits of PMU_CC_AP */
+#define CP_RD_ST_CLEAR  BIT31
+
+#define PMU_CC_AP  PMUAP_REG(0x004)
+/* sub-bits of PMU_CC_AP */
+#define AP_RD_ST_CLEAR     BIT31
+#define AP_ALLOW_FREQ_CHG  BIT18
+
+#define PMU_DEBUG_REG  PMUAP_REG(0x088)
+/* sub-bits of PMU_DEBUG_REG */
+#define AP_WFI_FC       BIT22
+#define CP_WFI_FC       BIT21
+#define AP_IDLE_IND     BIT12
+#define CP_IDLE_IND     BIT11
+#define AP_CLK_OFF_ACK  BIT4
+#define CP_CLK_OFF_ACK  BIT3
+#define MC_HALT         BIT2
+#define AP_HALT         BIT1
+#define CP_HALT         BIT0
+
+#define PMU_AP_IMR  PMUAP_REG(0x098)
+/* sub-bits of  */
+#define AP_DCLK_FC_DONE_INT_MSK  BIT15
+#define DCLK_FC_DONE_INT_MSK     BIT4
+
+#define PMU_AP_ISR  PMUAP_REG(0x0a0)
+/* sub-bits of  */
+#define AP_DCLK_FC_DONE_INT_STS  BIT15
+#define DCLK_FC_DONE_INT_STS     BIT4
+#define AP_FC_STS                BIT1
+
+#define PMU_MC_HW_SLP_TYPE  PMUAP_REG(0x0b0)
+/* sub-bits of PMU_MC_HW_SLP_TYPE */
+#define MC_REG_TABLE_EN  BIT10
+
+#define DFC_AP  PMUAP_REG(0x180)
+/* sub-bits of DFC_AP */
+#define DFC_FREQ_LV  0x1
+#define DFC_REQ      BIT0
+
+#define DFC_STATUS  PMUAP_REG(0x188)
+/* sub-bits of DFC_STATUS */
+#define DFC_CAUSE_SHIFT  0x7
+#define DFC_STS          BIT0
+
+#define DFC_LEVEL_0  PMUAP_REG(0x190)
+/* sub-bits of  */
+#define dfc_level_reg(n)  (DFC_LEVEL_0 + (n << 2))
+
+#define FC_LOCK_STATUS  PMUAP_REG(0x334)
+/* sub-bits of FC_LOCK_STATUS */
+#define CP_RD_STATUS  BIT1
+#define AP_RD_STATUS  BIT0
+
+#define DDR_BYPASS_26M   26
+#define DDR_BYPASS_312M  312
+#define DDR_BYPASS_416M  416
+
+#define DDR_BASE         0xc0000000
+#define DDR_MR_DATA      (DDR_BASE + 0x370)
+#define DDR_MR_REG       (DDR_BASE + 0x24)
+#define DDR_RFSH_TIMING  (DDR_BASE + 0x394)
+
+#define DDR_FP_NUM   4
+#define DDR_PLL_NUM  3
+
+/* AquilaC DDR */
+typedef enum {
+  DPLL_DIV1,
+  DPLL_DIV2,
+  DPLL_DIV3,
+  DPLL_DIV4,
+} PLL_DIV_V2;
+
+typedef enum {
+  DPLL_PLL2,
+  DPLL_PLL1,
+  DPLL_PLL_BYPASS,
+} PLL_SEL_V2;
+
+typedef struct {
+  UINT32    FreqLevel;
+  UINT32    McTimingNum;
+  UINT32    PLLSel;
+  UINT32    PLLDiv;
+  UINT32    DclkPdiv;
+  UINT32    DataRate;
+  UINT32    HighFreq;
+  UINT32    VolLevel;
+} DFC_LEVEL_CONFIG;
+
+typedef union {
+  struct {
+    UINT32    VolLevel : 4;
+    UINT32    McTimingNum : 2;
+    UINT32    HighFreq : 1;
+    UINT32    PLLOff : 1;
+    UINT32    PLLSel : 1;
+    UINT32    Kvco : 3;
+    UINT32    PLLBypass : 1;
+    UINT32    DclkPdiv : 1;
+    UINT32    PLLDiv : 2;
+    UINT32    PLLFbdiv : 7;
+    UINT32    BandSel : 1;
+    UINT32    PLLFrcdiv : 8;
+  } Bit;
+  UINT32    Ctrl;
+} DFC_LEVEL_CTRL;
+
+STATIC DFC_LEVEL_CONFIG  FreqLevels[MAX_FREQ_LV] =
+{
+  /*    fp 0 == fp 1 just fill in the blanks */
+  { 0, 0, DPLL_PLL1, DPLL_DIV4, DPLL_DIV1, 600,  0, 0 },
+  { 1, 0, DPLL_PLL1, DPLL_DIV4, DPLL_DIV1, 600,  0, 0 },
+  { 2, 0, DPLL_PLL1, DPLL_DIV3, DPLL_DIV1, 800,  0, 0 },
+  { 3, 0, DPLL_PLL2, DPLL_DIV3, DPLL_DIV1, 1066, 0, 0 },
+  { 4, 0, DPLL_PLL1, DPLL_DIV2, DPLL_DIV1, 1200, 0, 1 },
+  { 5, 1, DPLL_PLL2, DPLL_DIV2, DPLL_DIV1, 1600, 0, 2 },
+  { 6, 2, DPLL_PLL1, DPLL_DIV1, DPLL_DIV1, 2400, 1, 3 }
+};
+
+STATIC
+VOID
+UpdateDfcLevelArray (
+  IN PLATFORM_INFO_PROTOCOL  *This
+  )
+{
+  UINT32  I, DdrConfig, DdrPll1;
+
+  /*
+  DDR controller has two sources for clock, DDR PLL1 and DDR PLL2
+  PLL2 is fixed at 1600Mhz, PLL1 is set to 1333MHz when datarate is 2666 MT/s
+  otherwise PLL1 is set to 1200Mhz
+  */
+  if ((2666 != FreqLevels[ARRAY_SIZE (FreqLevels) - 1].DataRate)
+      && !EFI_ERROR (
+                     This->GetPlatformInfo (
+                                            This,
+                                            "ddr_datarate",
+                                            &DdrConfig,
+                                            sizeof (DdrConfig)
+                                            )
+                     )
+      && (2666 == DdrConfig))
+  {
+    DdrPll1 = 1333;
+    for (I = 0; I < ARRAY_SIZE (FreqLevels); I++) {
+      if (DPLL_PLL1 == FreqLevels[I].PLLSel) {
+        FreqLevels[I].DataRate =  (DdrPll1 * 2) / (FreqLevels[I].PLLDiv + 1);
+      }
+    }
+  }
+}
+
+STATIC
+INT32
+GetCurFreqLevel (
+  VOID
+  )
+{
+  UINT32  Level = MmioRead32 (DFC_STATUS);
+
+  Level = (Level >> 1) & 0x7;
+
+  return Level;
+}
+
+STATIC
+INT32
+FindDatarateFreqLevel (
+  UINT32  DataRate
+  )
+{
+  INT32  I;
+
+  for (I = ARRAY_SIZE (FreqLevels) - 1; I >= 0; I--) {
+    if (DataRate >= FreqLevels[I].DataRate) {
+      return FreqLevels[I].FreqLevel;
+    }
+  }
+
+  return FreqLevels[1].FreqLevel;
+}
+
+STATIC
+VOID
+ConfigCore (
+  VOID
+  )
+{
+  UINT32  Val;
+
+  /* ap allow freq-change voting */
+  Val  = MmioRead32 (PMU_CC_AP);
+  Val |= AP_ALLOW_FREQ_CHG;
+  MmioWrite32 (PMU_CC_AP, Val);
+
+  /* enable FFC DDR clock change */
+  Val  = MmioRead32 (PMU_MC_HW_SLP_TYPE);
+  Val &= ~MC_REG_TABLE_EN;
+  MmioWrite32 (PMU_MC_HW_SLP_TYPE, Val);
+}
+
+/* enable/disable ddr frequency change done interrupt */
+STATIC
+VOID
+EnableDfcInt (
+  BOOLEAN  Enable
+  )
+{
+  UINT32  Val;
+
+  Val = MmioRead32 (PMU_AP_IMR);
+  if (Enable) {
+    Val |= AP_DCLK_FC_DONE_INT_MSK;
+  } else {
+    Val &= ~AP_DCLK_FC_DONE_INT_MSK;
+  }
+
+  MmioWrite32 (PMU_AP_IMR, Val);
+}
+
+/* clear ddr frequency change done interrupt status*/
+STATIC
+VOID
+ClearDfcIntStatus (
+  VOID
+  )
+{
+  UINT32  Val;
+
+  Val  = MmioRead32 (PMU_AP_ISR);
+  Val &= ~(AP_DCLK_FC_DONE_INT_STS | AP_FC_STS);
+  MmioWrite32 (PMU_AP_ISR, Val);
+}
+
+STATIC
+EFI_STATUS
+ChangeDdrcFreq (
+  UINT32  Level
+  )
+{
+  UINT32  Timeout;
+
+  if (Level >= MAX_FREQ_LV) {
+    DEBUG ((DEBUG_ERROR, "%a: invalid %d freq Level\n", __func__, Level));
+    return EFI_INVALID_PARAMETER;
+  }
+
+  /* check if dfc in progress */
+  Timeout = 1000;
+  while (--Timeout) {
+    if (!(MmioRead32 (DFC_STATUS) & DFC_STS)) {
+      break;
+    }
+
+    gBS->Stall (10);
+  }
+
+  if (!Timeout) {
+    DEBUG (
+           (DEBUG_ERROR, "%a: another dfc is in pregress. status:0x%x\n",
+            __func__, MmioRead32 (DFC_STATUS))
+           );
+    return EFI_TIMEOUT;
+  }
+
+  /* trigger frequence change */
+  MmioWrite32 (DFC_AP, ((Level & 0x7) << DFC_FREQ_LV) | DFC_REQ);
+
+  Timeout = 1000;
+  while (--Timeout) {
+    gBS->Stall (10);
+    if (!(MmioRead32 (DFC_STATUS) & DFC_STS)) {
+      break;
+    }
+  }
+
+  if (!Timeout) {
+    DEBUG ((DEBUG_ERROR, "dfc error! status:0x%x\n", MmioRead32 (DFC_STATUS)));
+    return EFI_TIMEOUT;
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+WaitFreqChangeDone (
+  VOID
+  )
+{
+  UINT32  Val, Timeout = 100;
+
+  while (--Timeout) {
+    gBS->Stall (10);
+    Val = MmioRead32 (PMU_AP_ISR);
+    if (Val & AP_DCLK_FC_DONE_INT_STS) {
+      break;
+    }
+  }
+
+  if (!Timeout) {
+    DEBUG ((DEBUG_ERROR, "%a: Timeout! can not wait dfc done interrupt\n", __func__));
+    return EFI_TIMEOUT;
+  }
+
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+ChangeDdrDatarate (
+  IN PLATFORM_INFO_PROTOCOL  *This,
+  IN CHAR8                   *Name,
+  IN VOID                    *Info,
+  IN UINTN                   InfoSize
+  )
+{
+  EFI_STATUS  Status;
+  INT32       FreqCurr, FreqLevel;
+  UINT32      DataRate;
+
+  UpdateDfcLevelArray (This);
+
+  DataRate  = (UINT32)(UINTN)Info;
+  FreqCurr  = GetCurFreqLevel ();
+  FreqLevel = FindDatarateFreqLevel (DataRate);
+
+  if (FreqCurr == FreqLevel) {
+    /* dram frequency is same as the target already */
+    return EFI_SUCCESS;
+  }
+
+  ConfigCore ();
+
+  /* request change begin */
+  EnableDfcInt (TRUE);
+  Status = ChangeDdrcFreq (FreqLevel);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "%a: ChangeDdrcFreq fail. Status = %r\n", __func__, Status));
+    return Status;
+  }
+
+  /* wait for frequency change done */
+  Status = WaitFreqChangeDone ();
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "%a: WaitFreqChangeDone Timeout. Status = %r\n", __func__, Status));
+    return Status;
+  }
+
+  ClearDfcIntStatus ();
+  EnableDfcInt (FALSE);
+
+  DEBUG ((DEBUG_INFO, "Change DDR data rate to %dMT/s\n", FreqLevels[GetCurFreqLevel ()].DataRate));
+
+  return Status;
+}
diff --git a/Silicon/Spacemit/K1/Drivers/PlatformInfoDxe/PlatformInfoDxe.c b/Silicon/Spacemit/K1/Drivers/PlatformInfoDxe/PlatformInfoDxe.c
new file mode 100755
index 0000000000..b62ff964d3
--- /dev/null
+++ b/Silicon/Spacemit/K1/Drivers/PlatformInfoDxe/PlatformInfoDxe.c
@@ -0,0 +1,258 @@
+/** @file
+*
+*  Copyright (c) 2025, Spacemit Limited. All rights reserved.
+*
+*  SPDX-License-Identifier: BSD-2-Clause-Patent
+*
+**/
+
+#include <Uefi.h>
+#include <PiDxe.h>
+#include <Library/BaseLib.h>
+#include <Library/DebugLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/HobLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/MemoryManagementLib.h>
+
+#include "PlatformInfoDxe.h"
+
+STATIC const TLV_INFO_CONFIG  ConfigInfo[] = {
+  { "product_name",     TLV_CODE_PRODUCT_NAME,   TlvDataString    },
+  { "part#",            TLV_CODE_PART_NUMBER,    TlvDataString    },
+  { "serial#",          TLV_CODE_SERIAL_NUMBER,  TlvDataString    },
+  { "manufacture_date", TLV_CODE_MANUF_DATE,     TlvDataString    },
+  { "manufacturer",     TLV_CODE_MANUF_NAME,     TlvDataString    },
+  { "ddr_type",         TLV_CODE_DDR_TYPE,       TlvDataString    },
+  { "ddr_cs_num",       TLV_CODE_DDR_CSNUM,      TlvDataUint8     },
+  { "ddr_tx_odt",       TLV_CODE_DDR_TX_ODT,     TlvDataUint8     },
+  { "ddr_datarate",     TLV_CODE_DDR_DATARATE,   TlvDataUint16    },
+  { "ethaddr",          TLV_CODE_MAC_BASE,       TlvDataStructure },
+  { "wifi_addr",        TLV_CODE_WIFI_MAC_ADDR,  TlvDataStructure },
+  { "bt_addr",          TLV_CODE_BLUETOOTH_ADDR, TlvDataStructure }
+};
+
+STATIC
+EFI_STATUS
+ReadInfoFromTLV (
+  IN PLATFORM_INFO_PROTOCOL  *This,
+  IN CHAR8                   *Name,
+  OUT VOID                   *Info,
+  IN UINTN                   MaxSize
+  )
+{
+  UINT8                   Temp;
+  UINT32                  I, Tid;
+  EFI_STATUS              Status        = EFI_NOT_FOUND;
+  PLATFROM_INFO_INSTANCE  *InfoInstance = PLATFROM_INFO_INSTANCE_FROM_THIS (This);
+
+  for (I = 0; I < ARRAY_SIZE (ConfigInfo); I++) {
+    if (0 == AsciiStrCmp (Name, ConfigInfo[I].Name)) {
+      Tid    = ConfigInfo[I].Tid;
+      Status = InfoInstance->TlvInfoProtocol->GetTlvInfo (
+                                                          InfoInstance->TlvInfoProtocol,
+                                                          Tid,
+                                                          Info,
+                                                          MaxSize
+                                                          );
+      if (EFI_ERROR (Status)) {
+        DEBUG ((DEBUG_ERROR, "Failed(%r) to get TLV %a\n", Status, Name));
+      } else if ((TlvDataUint16 == ConfigInfo[I].Type) && (MaxSize >= sizeof (UINT16))) {
+        // convert it from big endian to little endian
+        Temp               = ((UINT8 *)Info)[0];
+        ((UINT8 *)Info)[0] = ((UINT8 *)Info)[1];
+        ((UINT8 *)Info)[1] = Temp;
+      }
+
+      break;
+    }
+  }
+
+  return Status;
+}
+
+STATIC
+EFI_STATUS
+GetMemLayoutInfo (
+  IN PLATFORM_INFO_PROTOCOL  *This,
+  IN CHAR8                   *Name,
+  OUT VOID                   *Info,
+  IN UINTN                   MaxItem
+  )
+{
+  EFI_PEI_HOB_POINTERS  Hob;
+  UINT64                I;
+  MEMORY_LAYOUT_INFO    *MemLayout;
+  EFI_STATUS            Status = EFI_NOT_FOUND;
+
+  if (NULL == Info) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  if (MaxItem < 1) {
+    return EFI_BUFFER_TOO_SMALL;
+  }
+
+  //
+  // Get the system memory bank info from memory hobs
+  //
+  Hob.Raw = GetFirstHob (EFI_HOB_TYPE_RESOURCE_DESCRIPTOR);
+  ASSERT (Hob.Raw != NULL);
+
+  I         = 0;
+  MemLayout = (MEMORY_LAYOUT_INFO *)Info;
+  while ((Hob.Raw != NULL) && (!END_OF_HOB_LIST (Hob)) && (I < (MaxItem - 1))) {
+    if (Hob.ResourceDescriptor->ResourceType == EFI_RESOURCE_SYSTEM_MEMORY) {
+      // update memory size
+      MemLayout[I].PhysicalAddress = Hob.ResourceDescriptor->PhysicalStart;
+      MemLayout[I].PhysicalSize    = Hob.ResourceDescriptor->ResourceLength;
+      DEBUG (
+             (DEBUG_VERBOSE, "Memory node: base=0x%lx, size=0x%lx\n",
+              MemLayout[I].PhysicalAddress, MemLayout[I].PhysicalSize)
+             );
+      I++;
+      Status = EFI_SUCCESS;
+    }
+
+    Hob.Raw = GET_NEXT_HOB (Hob);
+    Hob.Raw = GetNextHob (EFI_HOB_TYPE_RESOURCE_DESCRIPTOR, Hob.Raw);
+  }
+
+  MemLayout[I].PhysicalAddress = 0;
+  MemLayout[I].PhysicalSize    = 0;
+  return Status;
+}
+
+STATIC CONST SPACEMIT_PLATFROM_INFO  PlatformInfo[] = {
+  { "product_name",     ReadInfoFromTLV,  NULL              },
+  { "serial#",          ReadInfoFromTLV,  NULL              },
+  { "part#",            ReadInfoFromTLV,  NULL              },
+  { "manufacture_date", ReadInfoFromTLV,  NULL              },
+  { "manufacturer",     ReadInfoFromTLV,  NULL              },
+  { "ddr_type",         ReadInfoFromTLV,  NULL              },
+  { "ddr_cs_num",       ReadInfoFromTLV,  NULL              },
+  { "ddr_datarate",     ReadInfoFromTLV,  ChangeDdrDatarate },
+  { "ddr_tx_odt",       ReadInfoFromTLV,  NULL              },
+  { "ethaddr",          ReadInfoFromTLV,  NULL              },
+  { "wifi_addr",        ReadInfoFromTLV,  NULL              },
+  { "bt_addr",          ReadInfoFromTLV,  NULL              },
+  { "mem_layout",       GetMemLayoutInfo, NULL              }
+};
+
+STATIC
+EFI_STATUS
+GetK1PlatformInfo (
+  IN PLATFORM_INFO_PROTOCOL  *This,
+  IN CHAR8                   *Name,
+  OUT VOID                   *Info,
+  IN UINTN                   MaxSize
+  )
+{
+  INTN  I;
+
+  if ((Name == NULL) || (Info == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  for (I = 0; I < ARRAY_SIZE (PlatformInfo); I++) {
+    if ((0 == AsciiStrCmp (Name, PlatformInfo[I].Name)) &&
+        (NULL != PlatformInfo[I].ReadInfo))
+    {
+      SetMem (Info, MaxSize, 0);
+      return PlatformInfo[I].ReadInfo (This, Name, Info, MaxSize);
+    }
+  }
+
+  return EFI_NOT_FOUND;
+}
+
+STATIC
+EFI_STATUS
+SetK1PlatformInfo (
+  IN PLATFORM_INFO_PROTOCOL  *This,
+  IN CHAR8                   *Name,
+  IN VOID                    *Info,
+  IN UINTN                   InfoSize
+  )
+{
+  INTN  I;
+
+  if ((Name == NULL) || (Info == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  for (I = 0; I < ARRAY_SIZE (PlatformInfo); I++) {
+    if ((0 == AsciiStrCmp (Name, PlatformInfo[I].Name)) &&
+        (NULL != PlatformInfo[I].SetInfo))
+    {
+      return PlatformInfo[I].SetInfo (This, Name, Info, InfoSize);
+    }
+  }
+
+  return EFI_NOT_FOUND;
+}
+
+STATIC
+VOID
+PlatformMmioRemap (
+  VOID
+  )
+{
+  MapRegToGcdMmioSpace (K1_APMU_BASE, SIZE_4KB);
+}
+
+EFI_STATUS
+EFIAPI
+SpacemitK1PlatformInfoEntryPoint (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS              Status;
+  PLATFROM_INFO_INSTANCE  *InfoInstance;
+
+  InfoInstance = AllocateZeroPool (sizeof (PLATFROM_INFO_INSTANCE));
+  if (InfoInstance == NULL) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  InfoInstance->Signature                    = PLATFROM_INFO_SIGNATURE;
+  InfoInstance->PlatformInfo.GetPlatformInfo = GetK1PlatformInfo;
+  InfoInstance->PlatformInfo.SetPlatformInfo = SetK1PlatformInfo;
+
+  Status = gBS->InstallMultipleProtocolInterfaces (
+                                                   &InfoInstance->Handle,
+                                                   &gSpacemitPlatformInfoProtocolGuid,
+                                                   &InfoInstance->PlatformInfo,
+                                                   NULL
+                                                   );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "%a: Failed to install EmbeddedMmcHost protocols\n", __func__));
+    FreePool (InfoInstance);
+    return Status;
+  }
+
+  // Locate the TLV EEPROM protocol
+  Status = gBS->LocateProtocol (
+                                &gSpacemitTlvInfoProtocolGuid,
+                                NULL,
+                                (void *)&InfoInstance->TlvInfoProtocol
+                                );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "Fail to locate tlv eeprom protocol %r\n", Status));
+    Status = gBS->UninstallMultipleProtocolInterfaces (
+                                                       InfoInstance->Handle,
+                                                       &gSpacemitPlatformInfoProtocolGuid,
+                                                       &InfoInstance->PlatformInfo,
+                                                       NULL
+                                                       );
+    FreePool (InfoInstance);
+  }
+
+  if (!EFI_ERROR (Status)) {
+    PlatformMmioRemap ();
+  }
+
+  return Status;
+}
