+  IN UINTN                                       SourceY,
+  IN UINTN                                       DestinationX,
+  IN UINTN                                       DestinationY,
+  IN UINTN                                       Width,
+  IN UINTN                                       Height,
+  IN UINTN                                       Delta OPTIONAL // Number of BYTES in a row of the BltBuffer
+  );
+
