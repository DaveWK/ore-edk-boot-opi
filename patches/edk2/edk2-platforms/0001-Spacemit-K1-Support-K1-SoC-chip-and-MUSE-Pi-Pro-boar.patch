+#ifndef _SPACEMIT_LED_PCD_CONFIG_H_
+#define _SPACEMIT_LED_PCD_CONFIG_H_
+
+// LED device configuration structure
+typedef struct {
+  UINT32     GpioPin;     // GPIO pin number
+  BOOLEAN    ActiveState; // LED active state (TRUE=high active, FALSE=low active)
+  UINT8      Reserved[3];
+} LED_CONFIG;
+
+// LED blink timing configuration
+typedef struct {
+  UINT32    ShortTimeMs; // Short blink duration (milliseconds)
+  UINT32    PauseTimeMs; // Interval between blinks (milliseconds)
+  UINT32    LongTimeMs;  // Long on duration (milliseconds)
+} LED_TIMING_CONFIG;
+
+// LED configuration array
+typedef struct {
+  UINT16               Num;     // Number of LED devices
+  LED_TIMING_CONFIG    Timing;  // Blink timing configuration
+  LED_CONFIG           Data[1]; // LED configuration array
+} LED_CONFIG_ARRAY;
+
+#define LED_PATTERN_NORMAL      0  // Solid on
+#define LED_PATTERN_BOOTLOADER  1  // Short blink 1 time (bootloader error)
+#define LED_PATTERN_RAM         2  // Short blink 2 times (RAM error)
+#define LED_PATTERN_KERNEL      3  // Short blink 3 times (kernel error)
+#define LED_PATTERN_GRUB        4  // Short blink 4 times (GRUB error)
+
+#endif // _SPACEMIT_LED_PCD_CONFIG_H_
