+
+/**
+ * PciePreLinkConfigure() - Configure link capabilities and speed
+ *
+ * @regs_base: A pointer to the PCIe controller registers
+ * @CapSpeed: The capabilities and speed to configure
+ *
+ * Configure the link capabilities and speed in the PCIe root complex.
+ */
+STATIC void
+PciePreLinkConfigure (
+  IN UINT32  Port,
+  IN UINT32  CapSpeed
+  )
+{
+  UINT32  Val;
+
+  PcieDbiWriteEnable (Port, TRUE);
+
+  Val  = K1PcieDbiRead32 (Port, PCIE_LINK_CAPABILITY);
+  Val &= ~TARGET_LINK_SPEED_MASK;
+  Val |= CapSpeed;
+  K1PcieDbiWrite32 (Port, PCIE_LINK_CAPABILITY, Val);
+
+  Val  = K1PcieDbiRead32 (Port, PCIE_LINK_CTL_2);
+  Val &= ~TARGET_LINK_SPEED_MASK;
+  Val |= CapSpeed;
+  K1PcieDbiWrite32 (Port, PCIE_LINK_CTL_2, Val);
+
+  PcieDbiWriteEnable (Port, FALSE);
+}
+
+/**
+ * IsLinkUp() - Return the link state
+ *
+ * @regs_base: A pointer to the PCIe DBICS registers
+ *
+ * Return: 1 (true) for active line and 0 (false) for no link
+ */
+STATIC BOOLEAN
+IsLinkUp (
+  IN UINT32  Port
+  )
+{
+  UINT32  Val;
+
+  Val  = K1PcieDbiRead32 (Port, DW_PCIE_PORT_DEBUG0);
+  Val &= PORT_LOGIC_LTSSM_STATE_MASK;
+
+  return (Val == PORT_LOGIC_LTSSM_STATE_L0);
+}
+
+/**
+ * WaitLinkUp() - Wait for the link to come up
+ *
+ * @regs_base: A pointer to the PCIe controller registers
+ *
+ * Return: 1 (true) for active line and 0 (false) for no link (timeout)
+ */
+STATIC INT32
+WaitLinkUp (
+  IN UINT32  Port
+  )
+{
+  INT32  Timeout;
+
+  Timeout = PCIE_LINK_UP_TIMEOUT_MS;
+  while (!IsLinkUp (Port)) {
+    if (Timeout <= 0) {
+      return 0;
+    }
+
+    gBS->Stall (1 * 1000);
+    Timeout--;
+  }
+
+  return 1;
+}
+
+INT32
+PcieLinkUp (
+  IN UINT32  Port,
+  IN UINT32  CapSpeed
+  )
+{
+  UINT32  Val;
+
+  if (IsLinkUp (Port)) {
+    DEBUG ((DEBUG_INFO, "PCI Link already up before configuration!\n"));
+    return 1;
+  }
+
+  /* DW pre link configurations */
+  PciePreLinkConfigure (Port, CapSpeed);
+
+  /* Initiate link training */
+  Val  = K1PcieCtrlRead32 (Port, PCIE_CLK_RESET_CTRL);
+  Val |= LTSSM_EN;
+  Val &= ~APP_HOLD_PHY_RST;
+  K1PcieCtrlWrite32 (Port, PCIE_CLK_RESET_CTRL, Val);
+
+  /* Check that link was established */
+  if (!WaitLinkUp (Port)) {
+    return 0;
+  }
+
+  /*
+   * Link can be established in Gen 1. still need to wait
+   * till MAC nagaotiation is completed
+   */
+  gBS->Stall (100);
+
+  return 1;
+}
+
+/**
+  Perform PCIE slot reset using external GPIO pin.
+
+  @param [in] *PcieResetGpio  GPIO pin description.
+
+  @retval EFI_SUCEESS         PCIE slot reset succeeded.
+  @retval Other               Return error status.
+
+**/
+STATIC
+EFI_STATUS
+PcieResetSlot (
+  IN UINT32  Port
+  )
+{
+  UINT32  Val;
+
+  // switch pin to PCIe_perstn function
+  //   MmioWrite32 (
+  //                K1_MFPR_BASE + GPIO_REG_ADDR (Pcie_Reset_Gpio[Port][0]),
+  //                PCIE_PIN_CONFIG (Pcie_Reset_Gpio[Port][1])
+  //                );
+
+  /* Activate reset. */
+  /* set Perst# (fundamental reset) gpio low state*/
+  Val  = K1PcieCtrlRead32 (Port, PCIE_CLK_RESET_CTRL);
+  Val |= PCIE_RC_PERST;
+  K1PcieCtrlWrite32 (Port, PCIE_CLK_RESET_CTRL, Val);
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+VOID
+PcieHostInit (
+  IN UINT32  Port
+  )
+{
+  UINT32  Val;
+
+  gBS->Stall (100 * 1000);
+
+  /* Dectivate reset. */
+  /* set Perst# (fundamental reset) gpio high state*/
+  Val  = K1PcieCtrlRead32 (Port, PCIE_CLK_RESET_CTRL);
+  Val &= ~PCIE_RC_PERST;
+  K1PcieCtrlWrite32 (Port, PCIE_CLK_RESET_CTRL, Val);
+}
+
+STATIC VOID
+PcieHwInit (
+  IN UINT32  Port
+  )
+{
+  UINT32  I, Val;
+
+  MapRegToGcdMmioSpace (K1PcieReg[Port].Ctrl, 0x100);
+  MapRegToGcdMmioSpace (K1PcieReg[Port].PhyAhb, SIZE_4KB);
+  MapRegToGcdMmioSpace (K1PcieReg[Port].Phy, SIZE_4KB);
+  MapRegToGcdMmioSpace (K1PcieReg[0].Phy, SIZE_4KB);
+
+  for (I = 0; I < ARRAY_SIZE (Pcie_Reset_Gpio[0]); I++) {
+    /* switch pin to PCIe_perstn function */
+    MmioWrite32 (
+                 K1_MFPR_BASE + GPIO_REG_ADDR (Pcie_Reset_Gpio[Port][I].Index),
+                 PCIE_PIN_CONFIG (Pcie_Reset_Gpio[Port][I].Mux)
+                 );
+  }
+
+  /* enable pcie clk */
+  Val  = K1PcieCtrlRead32 (Port, PCIE_CLK_RESET_CTRL);
+  Val |= BIT0 | BIT1 | BIT2;
+  K1PcieCtrlWrite32 (Port, PCIE_CLK_RESET_CTRL, Val);
+
+  /* deassert pcie */
+  Val  = K1PcieCtrlRead32 (Port, PCIE_CLK_RESET_CTRL);
+  Val &= ~(BIT3 | BIT4 | BIT5 | BIT8);
+  Val |= BIT3 | BIT4 | BIT5;
+  K1PcieCtrlWrite32 (Port, PCIE_CLK_RESET_CTRL, Val);
+
+  /* hold the ltssm in detect quiet */
+  Val  = K1PcieCtrlRead32 (Port, PCIE_CLK_RESET_CTRL);
+  Val &= ~LTSSM_EN;
+  K1PcieCtrlWrite32 (Port, PCIE_CLK_RESET_CTRL, Val);
+}
+
+// wait portA rterm done
+STATIC void
+PciePortARterm (
+  IN UINT32  Port
+  )
+{
+  int     RdData;
+  UINT32  Val;
+
+  // REG32(PMUA_REG_BASE + 0x3CC) = 0x4000003f;
+  Val = 0x4000003f;
+  K1PcieCtrlWrite32 (0, PCIE_CLK_RESET_CTRL, Val);
+
+  // clear hold phy reset
+  // REG32(PMUA_REG_BASE + 0x3CC) &= 0xbfffffff;
+  Val  = K1PcieCtrlRead32 (0, PCIE_CLK_RESET_CTRL);
+  Val &= 0xbfffffff;
+  K1PcieCtrlWrite32 (0, PCIE_CLK_RESET_CTRL, Val);
+
+  // set refclk model
+  // REG32(0xC0B10000 + (0x17 << 2)) |= (0x1 << 10);
+  Val  = K1PciePhyRegRead32 (0, (0x17 << 2));
+  Val |= (0x1 << 10);
+  K1PciePhyRegWrite32 (0, (0x17 << 2), Val);
+
+  // REG32(0xC0B10000 + (0x17 << 2)) &= ~(0x3 << 8);
+  Val  = K1PciePhyRegRead32 (0, (0x17 << 2));
+  Val &= ~(0x3 << 8);
+  K1PciePhyRegWrite32 (0, (0x17 << 2), Val);
+
+ #ifndef PCIE_REF_CLK_OUTPUT
+  // receiver mode
+  // REG32(0xC0B10000 + (0x17 << 2)) |= 0x2 << 8;
+  Val  = K1PciePhyRegRead32 (0, (0x17 << 2));
+  Val |= 0x2 << 8;
+  K1PciePhyRegWrite32 (0, (0x17 << 2), Val);
+
+  // REG32(0xC0B10000 + (0x8 << 2)) &= ~(0x1 << 29);
+  Val  = K1PciePhyRegRead32 (0, (0x8 << 2));
+  Val &= ~(0x1 << 29);
+  K1PciePhyRegWrite32 (0, (0x8 << 2), Val);
+ #ifdef PCIE_SEL_24M_REF_CLK
+  // REG32(0xC0B10000 + (0x12 << 2)) &= 0xffff0fff;
+  Val  = K1PciePhyRegRead32 (0, (0x12 << 2));
+  Val &= 0xffff0fff;
+  K1PciePhyRegWrite32 (0, (0x12 << 2), Val);
+
+  // rc_cal_reg2 0x48
+  // REG32(0xC0B10000 + (0x12 << 2)) |= 0x00002000; x
+  Val  = K1PciePhyRegRead32 (0, (0x12 << 2));
+  Val |= 0x00002000;
+  K1PciePhyRegWrite32 (0, (0x12 << 2), Val);
+
+  // rc_cal_reg2 0x68
+  // REG32(0xC0B10000 + (0x8 << 2)) |= 0x3 << 29;
+  Val  = K1PciePhyRegRead32 (0, (0x8 << 2));
+  Val |= 0x3 << 29;
+  K1PciePhyRegWrite32 (0, (0x8 << 2), Val);
+ #elif PCIE_SEL_100M_REF_CLK
+  // rc_cal_reg2 0x48
+  // REG32(0xC0B10000 + (0x8 << 2)) |= 0x1 << 30;
+  Val  = K1PciePhyRegRead32 (0, (0x8 << 2));
+  Val |= 0x1 << 30;
+  K1PciePhyRegWrite32 (0, (0x8 << 2), Val);
+ #endif
+  // pll_reg9[3] en_rterm,only enable in receiver mode
+  // REG32(0xC0B10000 + (0x14 << 2)) |= (0x1 << 3);
+  Val  = K1PciePhyRegRead32 (0, (0x14 << 2));
+  Val |= (0x1 << 3);
+  K1PciePhyRegWrite32 (0, (0x14 << 2), Val);
+ #else
+  // driver mode
+  // REG32(0xC0B10000 + (0x17 << 2)) |= 0x1 << 8;
+  Val  = K1PciePhyRegRead32 (0, (0x17 << 2));
+  Val |= 0x1 << 8;
+  K1PciePhyRegWrite32 (0, (0x17 << 2), Val);
+
+  // REG32(0xC0B10000 + 0x400 + (0x17 << 2)) |= 0x1 << 8;
+  Val  = K1PciePhyRegRead32 (0, 0x400 + (0x17 << 2));
+  Val |= 0x1 << 8;
+  K1PciePhyRegWrite32 (0, 0x400 + (0x17 << 2), Val);
+
+  // REG32(0xC0B10000 + (0x12 << 2)) &= 0xffff0fff;
+  Val  = K1PciePhyRegRead32 (0, (0x12 << 2));
+  Val &= 0xffff0fff;
+  K1PciePhyRegWrite32 (0, (0x12 << 2), Val);
+
+  // select 24Mhz refclock input pll_reg1[15:13]=2
+  // REG32(0xC0B10000 + (0x12 << 2)) |= 0x00002000;
+  Val  = K1PciePhyRegRead32 (0, (0x12 << 2));
+  Val |= 0x00002000;
+  K1PciePhyRegWrite32 (0, (0x12 << 2), Val);
+
+  // pll_reg5[4] of lane0, enable refclk_100_n/p 100Mhz output
+  // REG32(0xC0B10000 + (0x13 << 2)) |= (0x1 << 4);
+  Val  = K1PciePhyRegRead32 (0, (0x13 << 2));
+  Val |= (0x1 << 4);
+  K1PciePhyRegWrite32 (0, (0x13 << 2), Val);
+
+  // pll_reg9[3] en_rterm,only enable in receiver mode
+  // REG32(0xC0B10000+(0x14<<2)) |= (0x1<<3);
+ #endif
+
+  // pll_reg1 of lane0, disable ssc pll_reg4[3:0]=4'h0
+  // REG32(0xC0B10000 + (0x12 << 2)) &= 0xfff0ffff;
+  Val  = K1PciePhyRegRead32 (0, (0x12 << 2));
+  Val &= 0xfff0ffff;
+  K1PciePhyRegWrite32 (0, (0x12 << 2), Val);
+
+  // PU_ADDR_CLK_CFG of lane0
+  // REG32(0xC0B10000 + (0x02 << 2)) = 0x00000B78;
+  Val = 0x00000B78;
+  K1PciePhyRegWrite32 (0, (0x02 << 2), Val);
+
+  // force rcv done
+  // REG32(0xC0B10000 + (0x06 << 2)) = 0x00000400;
+  Val = 0x00000400;
+  K1PciePhyRegWrite32 (0, (0x06 << 2), Val);
+  DEBUG ((DEBUG_INFO, "Now waiting portA resister tuning done...\n"));
+
+  // force PCIE mpu_u3/pu_rx_lfps
+  // REG32(PCIE_PUPHY_REG_BASE + 0x6 * 4) |= (0x1 << 17) | (0x1 << 15);
+  Val  = K1PciePhyRegRead32 (Port, (0x6 * 4));
+  Val |= ((0x1 << 17) | (0x1 << 15));
+  K1PciePhyRegWrite32 (Port, (0x6 * 4), Val);
+
+  // wait pm0 rterm done
+  do {
+    // RdData = REG32(0xC0B10000 + 0x21 * 4);
+    RdData = K1PciePhyRegRead32 (0, (0x21 * 4));
+    DEBUG ((DEBUG_VERBOSE, "porta redonly_reg2: %08x\n", RdData));
+  } while (((RdData >> 10) & 0x1) == 0);       // waiting PCIe portA readonly_reg2[2] r_tune_done==1
+}
+
+// force rterm value to porta/b/c
+STATIC void
+RtermForce (
+  IN UINT32  Port,
+  IN UINT32  PcieRcal
+  )
+{
+  INT32   I, Lane;
+  UINT32  Val = 0;
+
+  ASSERT (mDwPcies[Port] != NULL);
+  Lane = mDwPcies[Port]->NumLanes;
+
+  DEBUG ((DEBUG_INFO, "Pcie rcal = 0x%08x\n", PcieRcal));
+  DEBUG ((DEBUG_INFO, "pcie port id = %d, lane num = %d\n", Port, Lane));
+
+  // 2.write pma0 rterm value LSB[3:0](read0nly1[3:0]) to lane0/1 rx_reg1
+  for (I = 0; I < Lane; I++) {
+    Val  = K1PciePhyRegRead32 (Port, ((0x14 << 2) + 0x400 * I));
+    Val |= ((PcieRcal & 0xf) << 8);
+    K1PciePhyRegWrite32 (Port, ((0x14 << 2) + 0x400 * I), Val);
+  }
+
+  // 3.set lane0/1 rx_reg4 bit5=0
+  for (I = 0; I < Lane; I++) {
+    Val  = K1PciePhyRegRead32 (Port, ((0x15 << 2) + 0x400 * I));
+    Val &= ~(1 << 5);
+    K1PciePhyRegWrite32 (Port, ((0x15 << 2) + 0x400 * I), Val);
+  }
+
+  // 4.write pma0 rterm value MSB[7:4](readonly1[7:4]) to lane0/1 tx_reg1[7:4]
+  for (I = 0; I < Lane; I++) {
+    Val  = K1PciePhyRegRead32 (Port, ((0x19 << 2) + 0x400 * I));
+    Val |= ((PcieRcal >> 4) & 0xf) << 12;
+    K1PciePhyRegWrite32 (Port, ((0x19 << 2) + 0x400 * I), Val);
+  }
+
+  // 5.set lane0/1 tx_reg3 bit1=1
+  for (I = 0; I < Lane; I++) {
+    Val  = K1PciePhyRegRead32 (Port, ((0x19 << 2) + 0x400 * I));
+    Val |= (1 << 25);
+    K1PciePhyRegWrite32 (Port, ((0x19 << 2) + 0x400 * I), Val);
+  }
+
+  // 6.adjust rc calrefclk freq
+ #ifndef PCIE_REF_CLK_OUTPUT
+  // REG32(PCIE_PUPHY_REG_BASE + (0x8 << 2)) &= ~(0x1 << 29);
+  Val  = K1PciePhyRegRead32 (Port, (0x8 << 2));
+  Val &= ~(0x1 << 29);
+  K1PciePhyRegWrite32 (Port, (0x8 << 2), Val);
+ #ifdef PCIE_SEL_24M_REF_CLK
+  // REG32(PCIE_PUPHY_REG_BASE + (0x8 << 2)) |= 0x3 << 29; // rc_cal_reg2 0x68
+  Val  = K1PciePhyRegRead32 (Port, (0x8 << 2));
+  Val |= 0x3 << 29;
+  K1PciePhyRegWrite32 (Port, (0x8 << 2), Val);
+ #elif PCIE_SEL_100M_REF_CLK
+  // REG32(PCIE_PUPHY_REG_BASE + (0x8 << 2)) |= 0x1 << 30; // rc_cal_reg2 0x48
+  Val  = K1PciePhyRegRead32 (Port, (0x8 << 2));
+  Val |= 0x1 << 30;
+  K1PciePhyRegWrite32 (Port, (0x8 << 2), Val);
+ #endif
+ #else
+  // REG32(PCIE_PUPHY_REG_BASE + (0x8 << 2)) |= 0x3 << 29;
+  Val  = K1PciePhyRegRead32 (Port, (0x8 << 2));
+  Val |= 0x3 << 29;
+  K1PciePhyRegWrite32 (Port, (0x8 << 2), Val);
+ #endif
+
+  // 7.set lane0/1 rc_cal_reg1[6]=1
+  for (I = 0; I < Lane; I++) {
+    Val  = K1PciePhyRegRead32 (Port, ((0x8 << 2) + 0x400 * I));
+    Val &= ~(1 << 22);
+    K1PciePhyRegWrite32 (Port, ((0x8 << 2) + 0x400 * I), Val);
+  }
+
+  for (I = 0; I < Lane; I++) {
+    Val  = K1PciePhyRegRead32 (Port, ((0x8 << 2) + 0x400 * I));
+    Val |= (1 << 22);
+    K1PciePhyRegWrite32 (Port, ((0x8 << 2) + 0x400 * I), Val);
+  }
+
+  // release forc PCIE mpu_u3/pu_rx_lfps
+  Val  = K1PciePhyRegRead32 (Port, 0x6 * 4);
+  Val &= 0xFFFD7FFF;
+  K1PciePhyRegWrite32 (Port, 0x6 * 4, Val);
+}
+
+STATIC EFI_STATUS
+PciePhyInit (
+  IN UINT32  Port
+  )
+{
+  UINT32  RdData, PcieRcal;
+  UINT32  Val = 0;
+
+  DEBUG ((DEBUG_INFO, "%a: Init phy for PCIE port %d\n", __FUNCTION__, Port));
+  DEBUG ((DEBUG_VERBOSE, "init Rterm...\n"));
+  if (0 != Port) {
+    if (!PortAInitDone) {
+      PciePortARterm (Port);
+      // PcieRcal = REG32(0xC0B10000 + (0x21 << 2));
+      PcieRcal = K1PciePhyRegRead32 (0, (0x21 << 2));
+
+      // REG32(PMUA_REG_BASE + 0x3CC) &= ~0x4000003f;
+      Val  = K1PcieCtrlRead32 (0, PCIE_CLK_RESET_CTRL);
+      Val &= ~0x4000003f;
+      K1PcieCtrlWrite32 (0, PCIE_CLK_RESET_CTRL, Val);
+    } else {
+      // PcieRcal = REG32(0xC0B10000 + (0x21 << 2));
+      PcieRcal = K1PciePhyRegRead32 (0, (0x21 << 2));
+    }
+  } else {
+    do {
+      // RdData = REG32(0xC0B10000 + 0x21 * 4);
+      RdData = K1PciePhyRegRead32 (0, (0x21 << 2));
+    } while (((RdData >> 10) & 0x1) == 0);
+
+    // PcieRcal = REG32(0xC0B10000 + (0x21 << 2));
+    PcieRcal = K1PciePhyRegRead32 (0, (0x21 << 2));
+  }
+
+  RtermForce (Port, PcieRcal);
+
+  DEBUG ((DEBUG_VERBOSE, "init init_puphy...\n"));
+  Val  = K1PcieCtrlRead32 (Port, PCIE_CLK_RESET_CTRL);
+  Val &= 0xbfffffff;
+  K1PcieCtrlWrite32 (Port, PCIE_CLK_RESET_CTRL, Val);
+
+  // set refclk model
+  Val  = K1PciePhyRegRead32 (Port, (0x17 << 2));
+  Val |= (0x1 << 10);
+  K1PciePhyRegWrite32 (Port, (0x17 << 2), Val);
+
+  Val  = K1PciePhyRegRead32 (Port, (0x17 << 2));
+  Val &= ~(0x3 << 8);
+  K1PciePhyRegWrite32 (Port, (0x17 << 2), Val);
+
+  Val  = K1PciePhyRegRead32 (Port, 0x400 + (0x17 << 2));
+  Val |= (0x1 << 10);
+  K1PciePhyRegWrite32 (Port, 0x400 + (0x17 << 2), Val);
+
+  Val  = K1PciePhyRegRead32 (Port, 0x400 + (0x17 << 2));
+  Val &= ~(0x3 << 8);
+  K1PciePhyRegWrite32 (Port, 0x400+ (0x17 << 2), Val);
+ #ifndef PCIE_REF_CLK_OUTPUT
+  // receiver mode
+  REG32 (PCIE_PUPHY_REG_BASE + (0x17 << 2))         |= 0x2 << 8;
+  REG32 (PCIE_PUPHY_REG_BASE + 0x400 + (0x17 << 2)) |= 0x2 << 8;
+ #ifdef PCIE_SEL_24M_REF_CLK
+  Val  = K1PciePhyRegRead32 (Port, (0x12 << 2));
+  Val &= 0xffff0fff;
+  K1PciePhyRegWrite32 (Port, (0x12 << 2), Val);
+
+  Val  = K1PciePhyRegRead32 (Port, (0x12 << 2));
+  Val |= 0x00002000;
+  K1PciePhyRegWrite32 (Port, (0x12 << 2), Val);
+ #endif
+ #else
+  // driver mode
+  Val  = K1PciePhyRegRead32 (Port, (0x17 << 2));
+  Val |= 0x1 << 8;
+  K1PciePhyRegWrite32 (Port, (0x17 << 2), Val);
+
+  Val  = K1PciePhyRegRead32 (Port, 0x400 + (0x17 << 2));
+  Val |= 0x1 << 8;
+  K1PciePhyRegWrite32 (Port, 0x400 + (0x17 << 2), Val);
+
+  Val  = K1PciePhyRegRead32 (Port, (0x12 << 2));
+  Val &= 0xffff0fff;
+  K1PciePhyRegWrite32 (Port, (0x12 << 2), Val);
+
+  Val  = K1PciePhyRegRead32 (Port, (0x12 << 2));
+  Val |= 0x00002000;
+  K1PciePhyRegWrite32 (Port, (0x12 << 2), Val);
+
+  Val  = K1PciePhyRegRead32 (Port, (0x13 << 2));
+  Val |= (0x1 << 4);
+  K1PciePhyRegWrite32 (Port, (0x13 << 2), Val);
+
+  if (0 == Port) {
+    // REG32(0xC0B10000+(0x14<<2)) |= (0x1<<3);//pll_reg9[3] en_rterm,only enable in receiver mode
+    Val  = K1PciePhyRegRead32 (0, (0x14 << 2));
+    Val |= (0x1 << 3);
+    K1PciePhyRegWrite32 (0, (0x14 << 2), Val);
+  }
+
+ #endif
+
+  // pll_reg1 of lane0, disable ssc pll_reg4[3:0]=4'h0
+  Val  = K1PciePhyRegRead32 (Port, (0x12 << 2));
+  Val &= 0xfff0ffff;
+  K1PciePhyRegWrite32 (Port, (0x12 << 2), Val);
+
+  // PU_ADDR_CLK_CFG of lane0
+  Val = 0x00000B78;
+  K1PciePhyRegWrite32 (Port, (0x02 << 2), Val);
+
+  // PU_ADDR_CLK_CFG of lane1
+  Val = 0x00000B78;
+  K1PciePhyRegWrite32 (Port, 0x400 + (0x02 << 2), Val);
+
+  // force rcv done
+  Val = 0x00000400;
+  K1PciePhyRegWrite32 (Port, (0x06 << 2), Val);
+
+  DEBUG ((DEBUG_VERBOSE, "waiting pll lock...\n"));
+  do {
+    RdData = K1PciePhyRegRead32 (Port, 0x8);
+  } while ((RdData & 0x1) == 0);
+
+  if (Port == 0) {
+    PortAInitDone = TRUE;
+  }
+
+  DEBUG ((DEBUG_INFO, "finish init_puphy...\n"));
+  return 0;
+}
+
+STATIC void
+PcieSetRCMode (
+  IN UINT32  Port
+  )
+{
+  UINT32  Val;
+
+  Val  = K1PcieCtrlRead32 (Port, PCIE_CLK_RESET_CTRL);
+  Val |= DEVICE_TYPE_RC;
+  K1PcieCtrlWrite32 (Port, PCIE_CLK_RESET_CTRL, Val);
+
+  Val  = K1PcieCtrlRead32 (Port, PCIE_CTRL_LOGIC);
+  Val |= PCIE_IGNORE_PERSTN;
+  K1PcieCtrlWrite32 (Port, PCIE_CTRL_LOGIC, Val);
+}
+
+void
+PcieSetupHost (
+  IN UINT32  Port
+  )
+{
+  UINT32  Val;
+
+  /* setup RC BARs */
+  K1PcieDbiWrite32 (Port, PCI_BASE_ADDRESSREG_OFFSET, PCI_BASE_ADDRESS_MEM_TYPE_64);
+  K1PcieDbiWrite32 (Port, PCI_BASE_ADDRESSREG_OFFSET + 4, 0);
+
+  /* setup interrupt pins */
+  Val  = K1PcieDbiRead32 (Port, PCI_INT_LINE_OFFSET);
+  Val &= ~0xffff;
+  Val |= 0x100;
+  K1PcieDbiWrite32 (Port, PCI_INT_LINE_OFFSET, Val);
+
+  /* setup bus numbers */
+  Val  = K1PcieDbiRead32 (Port, PCI_BRIDGE_PRIMARY_BUS_REGISTER_OFFSET);
+  Val &= ~0xffffff;
+  Val |= 0xff0100;
+  K1PcieDbiWrite32 (Port, PCI_BRIDGE_PRIMARY_BUS_REGISTER_OFFSET, Val);
+
+  /* setup command register */
+  Val  = K1PcieDbiRead32 (Port, PCI_COMMAND_OFFSET);
+  Val &= ~0xffff;
+  Val |= EFI_PCI_COMMAND_IO_SPACE | EFI_PCI_COMMAND_MEMORY_SPACE | EFI_PCI_COMMAND_BUS_MASTER
+         | EFI_PCI_COMMAND_SERR;
+  K1PcieDbiWrite32 (Port, PCI_COMMAND_OFFSET, Val);
+
+  /* Enable write permission for the DBI read-only register */
+  PcieDbiWriteEnable (Port, TRUE);
+  /* program correct class for RC */
+  Val  = K1PcieDbiRead32 (Port, PCI_REVISION_ID_OFFSET);
+  Val &= ~0xffff0000;
+  Val |= (PCI_CLASS_BRIDGE << 24) | (PCI_CLASS_BRIDGE_P2P << 16);
+  K1PcieDbiWrite32 (Port, PCI_REVISION_ID_OFFSET, Val);
+  /* Better disable write permission right after the update */
+  PcieDbiWriteEnable (Port, FALSE);
+
+  Val  = K1PcieDbiRead32 (Port, DW_PCIE_LINK_WIDTH_SPEED_CONTROL);
+  Val |= DW_PCIE_PORT_LOGIC_SPEED_CHANGE;
+  K1PcieDbiWrite32 (Port, DW_PCIE_LINK_WIDTH_SPEED_CONTROL, Val);
+
+  Val  = K1PcieDbiRead32 (Port, PCI_CACHELINE_SIZE_OFFSET);
+  Val &= ~0xFF;
+  Val |= SYS_PCI_CACHE_LINE_SIZE;
+  K1PcieDbiWrite32 (Port, PCI_CACHELINE_SIZE_OFFSET, Val);
+}
+
+STATIC
+VOID
+PcieInitId (
+  IN UINT32  Port
+  )
+{
+  PcieDbiWriteEnable (Port, TRUE);
+  K1PcieDbiWrite32 (Port, PCI_VENDOR_ID_OFFSET, K1_PCIE_VENDOR_ID | (k1_PCIE_DEVICE_ID << 16));
+  PcieDbiWriteEnable (Port, FALSE);
+}
+
+/**
+  Obtain resources and perform a low-level PCIE controllers
+  configuration.
+
+  @param [in]  Port             PCIE root complex port number.
+
+  @retval EFI_SUCEESS       PCIE configuration successful.
+  @retval Other             Return error status.
+
+**/
+EFI_STATUS
+EFIAPI
+K1PciHostBridgeInit (
+  UINTN  Port
+  )
+{
+  ASSERT (Port < ARRAY_SIZE (K1PcieReg));
+
+  PcieHwInit (Port);
+  PcieResetSlot (Port);
+  PciePhyInit (Port);
+  PcieSetRCMode (Port);
+  PcieHostInit (Port);
+  PcieSetupHost (Port);
+  PcieInitId (Port);
+
+  if (!PcieLinkUp (Port, LINK_SPEED_GEN_2)) {
+    DEBUG ((DEBUG_ERROR, "%a: PCIE-%d: Link down\n", __FUNCTION__, Port));
+    return EFI_DEVICE_ERROR;
+  }
+
+  DEBUG (
+         (DEBUG_INFO, "%a: PCIE-%d: Link up (Gen%d-x%d)\n", __FUNCTION__, Port,
+          GetLinkSpeed (Port),
+          GetLinkWidth (Port))
+         );
+
+  return EFI_SUCCESS;
+}
+
+/**
+  Constructor to configure K1 PCI Host Bridge.
+
+  @param  ImageHandle   The image handle.
+  @param  SystemTable   The system table.
+
+  @retval EFI_SUCCESS   Configure successfully.
+  @retval Other         Return error status.
+
+**/
+EFI_STATUS
+EFIAPI
+K1PciHostBridgeDxeConstructor (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS                             Status;
+  DW_PCIE_CONTROLLER_CONFIGS             *DwPcieControllerConfigs   = NULL;
+  PCI_ROOT_BRIDGE_RESOURCE_CONFIG_ARRAY  *RootBridgeResourceConfigs = NULL;
+  UINTN                                  SegMax                     = 0;
+  UINTN                                  Index;
+
+  DwPcieControllerConfigs =
+    (DW_PCIE_CONTROLLER_CONFIGS *)PcdGetPtr (PcdDwPcieControllerConfigTable);
+  if (DwPcieControllerConfigs ==  NULL) {
+    DEBUG ((DEBUG_ERROR, "(%a) DW PCIe controller configs not found\n", __func__));
+    return EFI_UNSUPPORTED;
+  }
+
+  RootBridgeResourceConfigs =
+    (PCI_ROOT_BRIDGE_RESOURCE_CONFIG_ARRAY *)PcdGetPtr (PcdBoardPciRootBridgeResourceConfigTable);
+  if (RootBridgeResourceConfigs == NULL) {
+    DEBUG ((DEBUG_ERROR, "(%a) Root Bridge resource configs not found\n", __func__));
+    return EFI_UNSUPPORTED;
+  }
+
+  //
+  // On K1, each PCIe controller is treated as a Root Bridge, so the
+  // number of configs should be equal.
+  //
+  if (DwPcieControllerConfigs->Num != RootBridgeResourceConfigs->ArrayNum) {
+    DEBUG (
+           (DEBUG_ERROR, "(%a) DwPcieControllerConfigs->Num should be equal to "
+                         "RootBridgeResourceConfigs->ArrayNum\n", __func__)
+           );
+    return EFI_UNSUPPORTED;
+  }
+
+  //
+  // Perhaps some of the Root Bridge resource configs are disabled, it means
+  // that the corresponding DW PCIe controllers are disabled too.
+  // For convenience, we allocate a space for mDwPcies that it can store all of
+  // the DW_PCIE* pointers, no matter the controller is enabled or not. The
+  // pointers in mDwPcies for the disabled controllers will be kept NULL.
+  //
+  mDwPciesCount = DwPcieControllerConfigs->Num;
+  mDwPcies      = (DW_PCIE **)AllocateZeroPool (sizeof (DW_PCIE *) * mDwPciesCount);
+  ASSERT (mDwPcies != NULL);
+
+  for (Index = 0; Index < mDwPciesCount; Index++) {
+    if (!RootBridgeResourceConfigs->ArrayData[Index].IsEnabled ||
+        (DwPcieControllerConfigs->Data[Index].ControllerMode != DW_PCIE_CONTROLLER_MODE_RC))
+    {
+      continue;
+    }
+
+    mDwPcies[Index] = DwPcieAllocateInstance (Index);
+    if (mDwPcies[Index] == NULL) {
+      DEBUG ((DEBUG_ERROR, "(%a) DwPcies[%u]: Failed to allocate instance\n", __func__, Index));
+      continue;
+    }
+
+    Status = DwPcieResourceSetup (
+                                  mDwPcies[Index],
+                                  &DwPcieControllerConfigs->Data[Index],
+                                  &RootBridgeResourceConfigs->ArrayData[Index]
+                                  );
+    if (EFI_ERROR (Status)) {
+      DEBUG (
+             (DEBUG_ERROR, "(%a) DwPcies[%u]: Failed to init DW PCIe controller resources\n",
+              __func__, Index)
+             );
+      continue;
+    }
+
+    Status = K1PciHostBridgeInit (Index);
+    if (EFI_ERROR (Status)) {
+      DEBUG (
+             (DEBUG_ERROR, "(%a) DwPcies[%u]: Failed to init DW PCIe controller\n",
+              __func__, Index)
+             );
+      continue;
+    }
+
+    Status = DwPcieHostInit (mDwPcies[Index]);
+    if (EFI_ERROR (Status)) {
+      DEBUG (
+             (DEBUG_ERROR, "(%a) DwPcies[%u]: Failed to init DW PCIe controller host mode\n",
+              __func__, Index)
+             );
+      continue;
+    }
+
+    if (RootBridgeResourceConfigs->ArrayData[Index].Segment > SegMax) {
+      SegMax = RootBridgeResourceConfigs->ArrayData[Index].Segment;
+    }
+  }
+
+  Status = DwPcieRootPortArrayInit (SegMax);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "(%a) DwPcieRootPortArrayInit failed\n", __func__));
+  }
+
+  for (Index = 0; Index < mDwPciesCount; Index++) {
+    if (mDwPcies[Index] == NULL) {
+      continue;
+    }
+
+    Status = DwPcieRootPortArrayRegisterElement (&mDwPcies[Index]->Rp);
+    if (EFI_ERROR (Status)) {
+      DEBUG (
+             (DEBUG_ERROR, "(%a) DwPcies[%u]: DwPcieRootPortArrayRegisterElement failed\n",
+              __func__, Index)
+             );
+      DwPcieRootPortArrayDeinit ();
+      break;
+    }
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+  Destructor to free resources.
+
+  @param  ImageHandle   The image handle.
+  @param  SystemTable   The system table.
+
+  @retval EFI_SUCCESS   Always returns EFI_SUCCESS.
+
+**/
+EFI_STATUS
+EFIAPI
+K1PciHostBridgeDxeDestructor (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  UINTN  Index;
+
+  DwPcieRootPortArrayDeinit ();
+
+  if (mDwPcies == NULL) {
+    return EFI_SUCCESS;
+  }
+
+  for (Index = 0; Index < mDwPciesCount; Index++) {
+    if (mDwPcies[Index] == NULL) {
+      continue;
+    }
+
+    DwPcieFreeInstance (mDwPcies[Index]);
+    mDwPcies[Index] = NULL;
+  }
+
+  mDwPciesCount = 0;
+
+  FreePool (mDwPcies);
+  mDwPcies = NULL;
+
+  return EFI_SUCCESS;
+}
