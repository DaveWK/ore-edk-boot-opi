diff --git a/Silicon/Spacemit/K1/Drivers/HdmiGraphicsOutputDxe/Dpu.c b/Silicon/Spacemit/K1/Drivers/HdmiGraphicsOutputDxe/Dpu.c
new file mode 100644
index 0000000000..e781c80242
--- /dev/null
+++ b/Silicon/Spacemit/K1/Drivers/HdmiGraphicsOutputDxe/Dpu.c
@@ -0,0 +1,175 @@
+/** @file
+  This file implements the DPU HDMI interface initial.
+
+  Copyright (c) 2024, Spacemit. All rights reserved.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#include "Display.h"
+
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/CacheMaintenanceLib.h>
+#include <Library/DebugLib.h>
+#include <Library/IoLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/PcdLib.h>
+
+#include <Library/MemoryManagementLib.h>
+
+extern EFI_STATUS
+SpacemitHdmiProbe (
+  VOID
+  );
+
+_DISPLAY_MODEINFO  Hdmi1080pModeInfo = {
+  .Name           = "1920x1080-60",
+  .Refresh        = 60,
+  .Xres           = 1920,
+  .Yres           = 1080,
+  .RealXres       = 1920,
+  .RealYres       = 1080,
+  .LeftMargin     = 148,
+  .RightMargin    = 88,
+  .HsyncLen       = 44,
+  .UpperMargin    = 36,
+  .LowerMargin    = 4,
+  .VsyncLen       = 5,
+  .HsyncInvert    = 0,
+  .VsyncInvert    = 0,
+  .InvertPixClock = 0,
+  .PixClockFreq   = 148500,
+  .PixFmtOut      = OUTFMT_RGB888,
+  .Width          = 0,
+  .Height         = 0,
+};
+
+STATIC VOID
+HdmiDpuWrite (
+  UINT32  Offset,
+  UINT32  Val
+  )
+{
+  MmioWrite32 (HDMI_DPU_REG_BASE + Offset, Val);
+}
+
+STATIC VOID
+HdmiDpuInit (
+  _DISPLAY_MODEINFO  *HdmiModeInfo,
+  UINT64             FbBase
+  )
+{
+  UINT32  Vsync, Hsync, Vbp, Vfp, Hbp, Hfp, Vsp, Hsp;
+  UINT32  RegVal = 0;
+
+  Vsync = HdmiModeInfo->VsyncLen & 0x3ff;
+  Hsync = HdmiModeInfo->HsyncLen & 0x3ff;
+  Vbp   = HdmiModeInfo->UpperMargin & 0xfff;
+  Vfp   = HdmiModeInfo->LowerMargin & 0xfff;
+  Hbp   = HdmiModeInfo->LeftMargin & 0xfff;
+  Hfp   = HdmiModeInfo->RightMargin & 0xfff;
+  Vsp   = HdmiModeInfo->VsyncInvert ? 0 : 1;
+  Hsp   = HdmiModeInfo->HsyncInvert ? 0 : 1;
+
+  DEBUG ((DEBUG_VERBOSE, "%a Vsync %d Hsync %d \n", __func__, Vsync, Hsync));
+  DEBUG ((DEBUG_VERBOSE, "%a Vbp %d Vfp %d Vsp %d\n", __func__, Vbp, Vfp, Vsp));
+  DEBUG ((DEBUG_VERBOSE, "%a Hbp %d Hfp %d Hsp %d\n", __func__, Hbp, Hfp, Hsp));
+
+  HdmiDpuWrite (0xa1c, 0x2223);
+  HdmiDpuWrite (0x18000, (HdmiModeInfo->Yres << 16) | HdmiModeInfo->Xres);
+  HdmiDpuWrite (0x18018, 0x20);
+  HdmiDpuWrite (0x1807c, 0x100);
+  RegVal = (Hbp << 16) | Hfp;
+  HdmiDpuWrite (0x18080, RegVal);
+  RegVal = (Vbp << 16) | Vfp;
+  HdmiDpuWrite (0x18084, RegVal);
+  RegVal = (Vsp << 28) | (Vsync << 16) | (Hsp << 12) | (Hsync);
+  HdmiDpuWrite (0x18088, RegVal);
+  HdmiDpuWrite (0x1808c, (HdmiModeInfo->Yres << 16) | HdmiModeInfo->Xres);
+  HdmiDpuWrite (0x18090, HdmiModeInfo->PixFmtOut);
+  HdmiDpuWrite (0xd80, 0x202040);
+  HdmiDpuWrite (0xda0, (UINT32)(FbBase & 0xffffffff));
+  HdmiDpuWrite (0xda4, (UINT32)(FbBase >> 32));
+  HdmiDpuWrite (0xdb8, HdmiModeInfo->Xres * 4);
+  HdmiDpuWrite (0xdbc, (HdmiModeInfo->Yres << 16) | HdmiModeInfo->Xres);
+  HdmiDpuWrite (0xdc0, 0x0);
+  HdmiDpuWrite (0xdc4, ((HdmiModeInfo->Yres - 1) << 16) | (HdmiModeInfo->Xres - 1));
+  HdmiDpuWrite (0xdf0, 0x4);
+
+  HdmiDpuWrite (0x4c00, (HdmiModeInfo->Xres << 8) | 0x01);
+  HdmiDpuWrite (0x4c04, HdmiModeInfo->Yres);
+  HdmiDpuWrite (0x4c10, 0xff0000);
+  HdmiDpuWrite (0x4c14, 0xff);
+  HdmiDpuWrite (0x4c38, 0x7);
+  HdmiDpuWrite (0x4c48, 0x0);
+  HdmiDpuWrite (0x4c4c, (HdmiModeInfo->Xres - 1) << 16);
+  HdmiDpuWrite (0x4c50, HdmiModeInfo->Yres - 1);
+  HdmiDpuWrite (0x4c54, 0xff0000);
+
+  HdmiDpuWrite (0x560, 0x40008);
+  HdmiDpuWrite (0x588, 0x821);
+  HdmiDpuWrite (0x56c, 0x1);
+  HdmiDpuWrite (0x58c, 0x1);
+}
+
+VOID
+VideoSyncAll (
+  UINTN  FbAddress,
+  UINTN  FbSize
+  )
+{
+  WriteBackDataCacheRange ((VOID *)FbAddress, FbSize);
+}
+
+STATIC
+VOID
+DpuHdmiMmioRemap (
+  VOID
+  )
+{
+  MapRegToGcdMmioSpace (HDMI_REG_BASE, SIZE_4KB);
+  MapRegToGcdMmioSpace (HDMI_DPU_REG_BASE, SIZE_4KB);
+  MapRegToGcdMmioSpace (HDMI_DPU_REG_BASE + 0x4000, SIZE_4KB);
+  MapRegToGcdMmioSpace (HDMI_DPU_REG_BASE + 0x18000, SIZE_4KB);
+  MapRegToGcdMmioSpace (K1_APB_SPARE_BASE, SIZE_4KB);
+  MapRegToGcdMmioSpace (K1_APMU_BASE, SIZE_4KB);
+}
+
+EFI_STATUS
+HwInitializeDisplay (
+  VOID   **FbBase,
+  UINTN  *FbSize
+  )
+{
+  INT32   DpuId, RemoteDpuId;
+  UINT32  Xsize, Ysize, Bpix;
+
+  DpuHdmiMmioRemap ();
+
+  SpacemitHdmiProbe ();
+
+  RemoteDpuId = 1;
+  DEBUG ((DEBUG_VERBOSE, "RemoteDpuId  %d\n", RemoteDpuId));
+
+  DpuId = DPU_MODE_HDMI;
+  DEBUG ((DEBUG_VERBOSE, "DpuId %d\n", DpuId));
+
+  Bpix  = VIDEO_BPP32_BITS_PER_PIXEL;
+  Xsize = 1920;
+  Ysize = 1080;
+
+  *FbSize = Xsize * Ysize * VIDEO_BPP32_BYTES_PER_PIXEL;
+  *FbBase = AllocatePages (EFI_SIZE_TO_PAGES (*FbSize));
+  SetMem (*FbBase, *FbSize, 0);
+  VideoSyncAll ((UINTN)*FbBase, *FbSize);
+
+  DEBUG (
+         (DEBUG_INFO, "display: %dx%d, fb = 0x%x, size = 0x%x\n",
+          Xsize, Ysize, *FbBase, *FbSize)
+         );
+
+  HdmiDpuInit (&Hdmi1080pModeInfo, (UINTN)*FbBase);
+
+  return EFI_SUCCESS;
+}
