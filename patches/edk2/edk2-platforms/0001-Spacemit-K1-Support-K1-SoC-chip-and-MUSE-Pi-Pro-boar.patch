index 0000000000..4d6fe75f01
--- /dev/null
+++ b/Silicon/Spacemit/K1/Drivers/HdmiGraphicsOutputDxe/Hdmi.c
@@ -0,0 +1,444 @@
+/** @file
+  This file implements the HDMI controller initial.
+
+  Copyright (c) 2024, Spacemit. All rights reserved.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#include "Display.h"
+
+#include <Library/BaseLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/IoLib.h>
+#include <Library/PcdLib.h>
+#include <Library/DebugLib.h>
+
+#define SPACEMIT_HDMI_PHY_STATUS  0xC
+#define SPACEMIT_HDMI_PHY_HPD     0x1000
+#define K1_HDMI_POWER_CTRL        0x3f4
+
+#define APMU_POWER_STATUS_REG   0xf0
+#define APMU_HDMI_CLK_RES_CTRL  0x1B8
+
+CONST UINT8  PLL9_BIT0_1[3] = { 0x0, 0x1, 0x2 };
+
+STATIC EFI_STATUS
+HdmiWaitStatus (
+  UINT64  Reg,
+  UINT32  Mask,
+  UINT32  Check,
+  UINT32  TimeoutMs
+  )
+{
+  UINT32  TimeoutCount = TimeoutMs * 100;
+
+  while (1) {
+    if (Check == (MmioRead32 (Reg) & Mask)) {
+      break;
+    }
+
+    gBS->Stall (10);
+    if (!TimeoutCount--) {
+      return EFI_TIMEOUT;
+    }
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC UINT32
+HdmiRegRead (
+  UINT32  Offset
+  )
+{
+  return MmioRead32 (HDMI_REG_BASE + Offset);
+}
+
+STATIC VOID
+HdmiRegWrite (
+  UINT32  Offset,
+  UINT32  Val
+  )
+{
+  MmioWrite32 (HDMI_REG_BASE + Offset, Val);
+}
+
+STATIC INT32
+HdmiGetPlugInStatus (
+  VOID
+  )
+{
+  UINT32  Value;
+
+  Value = HdmiRegRead (SPACEMIT_HDMI_PHY_STATUS) & SPACEMIT_HDMI_PHY_HPD;
+
+  return !!Value;
+}
+
+STATIC EFI_STATUS
+HdmiPhyWaitForHpd (
+  UINT32  TimeoutMs
+  )
+{
+  UINT32  TimeoutCount = TimeoutMs * 10;
+
+  DEBUG ((DEBUG_VERBOSE, "%a() \n", __func__));
+
+  do {
+    if (HdmiGetPlugInStatus ()) {
+      DEBUG ((DEBUG_INFO, "%a() hdmi get hpd signal \n", __func__));
+      return EFI_SUCCESS;
+    }
+
+    gBS->Stall (100);
+  } while (TimeoutCount--);
+
+  return EFI_TIMEOUT;
+}
+
+INT32
+PowerOfTwo (
+  INT32  N
+  )
+{
+  INT32  Result = 1;
+
+  for (INT32 I = 0; I < N; I++) {
+    Result <<= 1;
+  }
+
+  return Result;
+}
+
+INT32
+Pll8Bit5_6 (
+  INT32  BitClock,
+  INT32  N
+  )
+{
+  INT32  Ret = 0;
+
+  BitClock = BitClock / N;
+
+  if (BitClock < 425) {
+    Ret = 3;
+  } else if (BitClock < 850) {
+    Ret = 2;
+  } else if (BitClock < 1700) {
+    Ret = 1;
+  } else {
+    Ret = 0;
+  }
+
+  return Ret;
+}
+
+INT32
+Pll6Bit4_5 (
+  INT32  BitClock,
+  INT32  N
+  )
+{
+  INT32  Ret = 0;
+
+  BitClock = BitClock / N;
+
+  if (BitClock <= 337) {
+    Ret = 0;
+  } else if (BitClock < 425) {
+    Ret = 1;
+  } else if (BitClock < 675) {
+    Ret = 0;
+  } else if (BitClock < 850) {
+    Ret = 1;
+  } else if (BitClock < 1350) {
+    Ret = 0;
+  } else if (BitClock < 1700) {
+    Ret = 1;
+  } else {
+    Ret = 0;
+  }
+
+  return Ret;
+}
+
+INT32
+Pll5Bit0_2 (
+  INT32  BitClock,
+  INT32  N
+  )
+{
+  INT32  Value = BitClock * PowerOfTwo (Pll8Bit5_6 (BitClock, N)) / N;
+  INT32  Ret;
+
+  if (Value < 1830) {
+    Ret = 0;
+  } else if (Value < 2030) {
+    Ret = 1;
+  } else if (Value < 2275) {
+    Ret = 2;
+  } else if (Value < 2520) {
+    Ret = 3;
+  } else if (Value < 2765) {
+    Ret = 4;
+  } else if (Value < 3015) {
+    Ret = 5;
+  } else if (Value < 3260) {
+    Ret = 6;
+  } else {
+    Ret = 7;
+  }
+
+  return Ret;
+}
+
+VOID
+HdmiPllRegCal (
+  INT32   BitClock,
+  INT32   RefClock,
+  INT32   N,
+  INT32   *TntegerPart,
+  UINT32  *HmdiE8Reg
+  )
+{
+  UINT64   IntPara   = 1000000000;
+  UINT64   Value     = (PowerOfTwo (Pll8Bit5_6 (BitClock, N))) * BitClock * IntPara / (N * (Pll6Bit4_5 (BitClock, N) + 1) * RefClock);
+  UINT64   Integer   = (PowerOfTwo (Pll8Bit5_6 (BitClock, N))) * BitClock / (N * (Pll6Bit4_5 (BitClock, N) + 1) * RefClock) * IntPara;
+  UINT64   Fraction  = Value - Integer;
+  BOOLEAN  Negative  = FALSE;
+  INT32    Bit       = 0;
+  INT32    Frac20bit = 0;
+  INT32    Pll2Reg   = 0;
+  INT32    Pll1Reg   = 0;
+  INT32    Pll0Reg   = 0;
+  INT32    I;
+
+  Negative     = Fraction > 500000000 ? TRUE : FALSE;
+  Fraction     = Negative ? 1000000000 - Fraction : Fraction;
+  *TntegerPart = Negative ? Integer / IntPara + 1 : Integer / IntPara;
+
+  for (I = 0; I < 20; I++) {
+    if (Bit >= IntPara) {
+      Frac20bit |= 1 << (19 - I);
+      Fraction  -= IntPara;
+    }
+
+    Fraction *= 2;
+    Bit       = Fraction;
+  }
+
+  if (!Negative) {
+    Pll2Reg = ((Frac20bit & 0xF0000) >> 16) | (1 << 5);
+  } else {
+    Frac20bit = (~Frac20bit + 1) & 0xfffff;
+    Pll2Reg   = 0x10 | ((Frac20bit & 0xF0000) >> 16) | (1 << 5);
+  }
+
+  Pll1Reg    = (Frac20bit & 0xFF00) >> 8;
+  Pll0Reg    = Frac20bit & 0xFF;
+  *HmdiE8Reg = (0x20 << 24) | (Pll2Reg << 16) | (Pll1Reg << 8) | Pll0Reg;
+}
+
+STATIC VOID
+HdmiPllSet (
+  INT32  PixelClock,
+  INT32  BitDepth
+  )
+{
+  INT32   pll9_reg = 0, pll8_reg = 0, pll7_reg = 0, pll6_reg = 0, pll5_reg = 0, pll4_reg = 0;
+  INT32   N           = 100;
+  INT32   RefClock    = 24;
+  INT32   hdmi_ec_reg = 0;
+  INT32   hdmi_f0_reg = 0;
+  UINT32  hdmi_e8_reg = 0;
+  // INT32 pow = 0;
+  INT32  BitClock = BitDepth == EIGHT_BPP ? PixelClock : PixelClock * 125 / 100;
+
+  INT32  TntegerPart = 0;
+
+  HdmiPllRegCal (BitClock, RefClock, N, &TntegerPart, &hdmi_e8_reg);
+
+  pll9_reg = 2 << 2 | PLL9_BIT0_1[BitDepth];
+  pll8_reg = (0 << 7) | (Pll8Bit5_6 (BitClock, N) << 5) | 1;
+  pll7_reg = 0x50;
+  pll6_reg = 0xD | (Pll6Bit4_5 (BitClock, N) << 4) | (2 << 6);
+  pll5_reg = 0x40 | Pll5Bit0_2 (BitClock, N);
+
+  // pow = (Pll8Bit5_6(BitClock, N));
+
+  pll4_reg = TntegerPart;
+
+  hdmi_ec_reg = (pll7_reg << 24) | (pll6_reg << 16) | (pll5_reg << 8) | pll4_reg;
+  hdmi_f0_reg = (pll9_reg << 8) | pll8_reg;
+
+  HdmiRegWrite (0xe8, hdmi_e8_reg);
+  HdmiRegWrite (0xec, hdmi_ec_reg);
+  HdmiRegWrite (0xf0, hdmi_f0_reg);
+}
+
+STATIC VOID
+HdmiWriteBits (
+  UINT32  Offset,
+  UINT32  Value,
+  UINT32  Mask,
+  UINT32  Shifts
+  )
+{
+  UINT32  RegVal;
+
+  RegVal  = HdmiRegRead (Offset);
+  RegVal &= ~(Mask << Shifts);
+  RegVal |= (Value << Shifts);
+  HdmiRegWrite (Offset, RegVal);
+}
+
+STATIC VOID
+HdmiPhyInit (
+  VOID
+  )
+{
+  UINT32  Value         = 0;
+  UINT32  PixelClock    = 148500;
+  UINT32  good_phase    = 0x00;
+  UINT32  bias_current  = 0x01;
+  UINT32  bias_risistor = 0x07;
+
+  INT32  BitDepth   = EIGHT_BPP;
+  INT32  ColorDepth = BitDepth == EIGHT_BPP ? 4 : 5;
+
+  // hdmi phy config
+  HdmiRegWrite (0xe8, 0x20200000);
+  HdmiRegWrite (0xec, 0x508d425a);
+  HdmiRegWrite (0xf0, 0x861);
+
+  HdmiRegWrite (0xe0, 0xAE5C410F);
+  HdmiWriteBits (0xe0, bias_current, 0x03, 29);
+  HdmiWriteBits (0xe0, bias_risistor, 0x0F, 18);
+  HdmiWriteBits (0xe0, good_phase, 0x03, 14);
+
+  Value = 0x0000000d | (ColorDepth << 4);
+  HdmiRegWrite (0x34, Value);
+
+  HdmiPllSet (PixelClock, BitDepth);
+  HdmiRegWrite (0xe4, 0x00);
+  HdmiRegWrite (0xe4, 0x03);
+  Value = HdmiRegRead (0xe4);
+
+  DEBUG ((DEBUG_VERBOSE, "%a() hdmi pll lock status 0x%x\n", __func__, Value));
+  // while ( (Value & 0x10000) != 0) {
+  //    Value = HdmiRegRead( 0xe4);
+  // }
+  gBS->Stall (100);
+
+  Value = 0x1C208000 | BitDepth;
+  HdmiRegWrite (0x28, Value);
+}
+
+STATIC EFI_STATUS
+HdmiClockInit (
+  VOID
+  )
+{
+  UINT32      Val;
+  EFI_STATUS  Ret;
+
+  /* deassert HDMI */
+  Val  = MmioRead32 (K1_APMU_BASE + APMU_HDMI_CLK_RES_CTRL);
+  Val |= (1 << 9);
+  MmioWrite32 (K1_APMU_BASE + APMU_HDMI_CLK_RES_CTRL, Val);
+  gBS->Stall (100);
+
+  /* enable HDMI clock */
+  Val  = MmioRead32 (K1_APMU_BASE + APMU_HDMI_CLK_RES_CTRL);
+  Val |= (1 << 0);
+  MmioWrite32 (K1_APMU_BASE + APMU_HDMI_CLK_RES_CTRL, Val);
+  gBS->Stall (100);
+
+  /* set HDMI clock to 491520000 */
+  /* enable PLL1_DIV5 clock: 491.52MHz */
+  Val  = MmioRead32 (K1_APB_SPARE_BASE + 0x104);
+  Val |= (1 << 4);
+  MmioWrite32 (K1_APB_SPARE_BASE + 0x104, Val);
+  gBS->Stall (100);
+  // select PLL1_DIV5 as clock soure, division = 1
+  Val  = MmioRead32 (K1_APMU_BASE + APMU_HDMI_CLK_RES_CTRL);
+  Val &= ~((0x07 << 5) | (0x0F << 1));
+  Val |= (1 << 5) | (0 << 1);
+  MmioWrite32 (K1_APMU_BASE + APMU_HDMI_CLK_RES_CTRL, Val);
+  Val |= (1 << 29);
+  MmioWrite32 (K1_APMU_BASE + APMU_HDMI_CLK_RES_CTRL, Val);
+
+  Ret = HdmiWaitStatus (K1_APMU_BASE + APMU_HDMI_CLK_RES_CTRL, 1 << 29, 0, 10);
+  if (EFI_ERROR (Ret)) {
+    DEBUG ((DEBUG_ERROR, "clk_set_rate mipi dsi mclk failed: %d\n", Ret));
+    return EFI_NO_RESPONSE;
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC EFI_STATUS
+HdmiPowerOn (
+  VOID
+  )
+{
+  INT32   loop;
+  UINT32  Val;
+
+  /* LCD */
+  Val  = MmioRead32 (K1_APMU_BASE + K1_HDMI_POWER_CTRL);
+  Val |= (1 << 0);
+  Val |= (1 << 4);
+  MmioWrite32 (K1_APMU_BASE + K1_HDMI_POWER_CTRL, Val);
+
+  gBS->Stall (310);
+
+  for (loop = 10000; loop >= 0; --loop) {
+    Val = MmioRead32 (K1_APMU_BASE + APMU_POWER_STATUS_REG);
+    if (Val & (1 << 15)) {
+      break;
+    }
+
+    gBS->Stall (6);
+  }
+
+  if (loop < 0) {
+    DEBUG ((DEBUG_ERROR, "power-on HDMI domain error\n"));
+    return EFI_NO_RESPONSE;
+  }
+
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+SpacemitHdmiProbe (
+  VOID
+  )
+{
+  EFI_STATUS  Ret;
+  BOOLEAN     IsConnected;
+
+  Ret = HdmiPowerOn ();
+  if (EFI_ERROR (Ret)) {
+    DEBUG ((DEBUG_ERROR, "hdmi power on failed: %d", Ret));
+    return EFI_DEVICE_ERROR;
+  }
+
+  Ret = HdmiClockInit ();
+  if (EFI_ERROR (Ret)) {
+    DEBUG ((DEBUG_ERROR, "hdmi clock enable failed: %d", Ret));
+    return EFI_DEVICE_ERROR;
+  }
+
+  Ret         = HdmiPhyWaitForHpd (100);
+  IsConnected = (EFI_SUCCESS == Ret);
+  if (!IsConnected) {
+    DEBUG ((DEBUG_INFO, "HDMI cannot get HPD signal\n"));
+    // return EFI_NO_MEDIA;
+  }
+
+  HdmiPhyInit ();
+  return EFI_SUCCESS;
+}
diff --git a/Silicon/Spacemit/K1/Drivers/HdmiGraphicsOutputDxe/HdmiGraphicsOutputDxe.c b/Silicon/Spacemit/K1/Drivers/HdmiGraphicsOutputDxe/HdmiGraphicsOutputDxe.c
