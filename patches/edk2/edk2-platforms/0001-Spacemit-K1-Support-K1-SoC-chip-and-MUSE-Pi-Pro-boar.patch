diff --git a/Silicon/Spacemit/K1/Drivers/LedControl/LedControl.c b/Silicon/Spacemit/K1/Drivers/LedControl/LedControl.c
new file mode 100755
index 0000000000..aaa7759340
--- /dev/null
+++ b/Silicon/Spacemit/K1/Drivers/LedControl/LedControl.c
@@ -0,0 +1,942 @@
+/**
+*
+*  Copyright (c) 2024, SpacemiT Co., Ltd. All rights reserved.
+*
+*  SPDX-License-Identifier: BSD-2-Clause-Patent
+*
+**/
+
+#include "LedControl.h"
+#include <Protocol/ReportStatusCodeHandler.h>
+#include <Library/ReportStatusCodeLib.h>
+#include <Library/DebugLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+
+extern EFI_GUID  gEfiRscHandlerProtocolGuid;
+extern EFI_GUID  gLedControlProtocolGuid;
+
+STATIC EMBEDDED_GPIO  *mGpio           = NULL;
+STATIC LED_CONTROL    *mLeds           = NULL;
+STATIC UINT32         mLedCount        = 0;
+STATIC BOOLEAN        mGpioInitialized = FALSE;
+
+// Blink control variables
+STATIC BOOLEAN  mBlinkActive     = FALSE;
+STATIC UINT32   mCurrentBlinkLed = 0;
+
+// Timer event to control LED blinking
+EFI_EVENT  mLedBlinkTimerEvent = NULL;
+BOOLEAN    mLedBlinkActive     = FALSE;
+UINT32     mLedBlinkPattern    = 0;
+UINT32     mLedBlinkCount      = 0;
+UINT32     mLedBlinkState      = 0;
+UINT32     mLedBlinkIndex      = 0;
+
+STATIC EFI_EVENT  mExitBootServicesEvent = NULL;
+
+/**
+ * Initialize GPIO protocol
+ *
+ * @retval EFI_SUCCESS     Initialization successful
+ * @retval Others          Initialization failed
+ */
+STATIC
+EFI_STATUS
+InitializeGpioProtocol (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  EFI_HANDLE  *HandleBuffer;
+  UINTN       HandleCount;
+  UINTN       Index;
+
+  if (mGpioInitialized) {
+    return EFI_SUCCESS;
+  }
+
+  // Locate GPIO protocol
+  Status = gBS->LocateHandleBuffer (
+                                    ByProtocol,
+                                    &gEmbeddedGpioProtocolGuid,
+                                    NULL,
+                                    &HandleCount,
+                                    &HandleBuffer
+                                    );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to locate GPIO protocol: %r\n", Status));
+    return Status;
+  }
+
+  // Get GPIO protocol
+  for (Index = 0; Index < HandleCount; Index++) {
+    Status = gBS->HandleProtocol (
+                                  HandleBuffer[Index],
+                                  &gEmbeddedGpioProtocolGuid,
+                                  (VOID **)&mGpio
+                                  );
+    if (!EFI_ERROR (Status)) {
+      break;
+    }
+  }
+
+  // Free handle buffer
+  gBS->FreePool (HandleBuffer);
+
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to get GPIO protocol: %r\n", Status));
+    return Status;
+  }
+
+  mGpioInitialized = TRUE;
+  return EFI_SUCCESS;
+}
+
+/**
+ * Initialize LED control
+ *
+ * @param[in] LedIndex     LED index (0-based)
+ *
+ * @retval EFI_SUCCESS     Initialization successful
+ * @retval EFI_NOT_FOUND   GPIO protocol not found
+ * @retval Others          Initialization failed
+ */
+EFI_STATUS
+EFIAPI
+LedInitialize (
+  IN UINT32  LedIndex
+  )
+{
+  EFI_STATUS        Status;
+  LED_CONFIG_ARRAY  *LedConfigs;
+  UINT32            GpioPin;
+  BOOLEAN           ActiveState;
+
+  // Initialize GPIO protocol
+  Status = InitializeGpioProtocol ();
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  // Get LED configuration
+  LedConfigs = (LED_CONFIG_ARRAY *)PcdGetPtr (PcdLedConfigs);
+  if ((LedConfigs == NULL) || (LedIndex >= LedConfigs->Num)) {
+    DEBUG ((DEBUG_ERROR, "LED: Invalid LED index: %d\n", LedIndex));
+    return EFI_INVALID_PARAMETER;
+  }
+
+  // Allocate LED control structure array
+  if (mLeds == NULL) {
+    Status = gBS->AllocatePool (
+                                EfiBootServicesData,
+                                sizeof (LED_CONTROL) * LedConfigs->Num,
+                                (VOID **)&mLeds
+                                );
+    if (EFI_ERROR (Status)) {
+      DEBUG ((DEBUG_ERROR, "LED: Failed to allocate memory for LED controls: %r\n", Status));
+      return Status;
+    }
+
+    // Initialize LED control structure
+    gBS->SetMem (mLeds, sizeof (LED_CONTROL) * LedConfigs->Num, 0);
+    mLedCount = LedConfigs->Num;
+  }
+
+  // Get LED configuration
+  GpioPin     = LedConfigs->Data[LedIndex].GpioPin;
+  ActiveState = LedConfigs->Data[LedIndex].ActiveState;
+
+  // Initialize LED
+  Status = LedInitializeEx (GpioPin, ActiveState);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  // Update LED control structure
+  mLeds[LedIndex].GpioPin       = GpioPin;
+  mLeds[LedIndex].ActiveState   = ActiveState;
+  mLeds[LedIndex].IsInitialized = TRUE;
+
+  return EFI_SUCCESS;
+}
+
+/**
+ * Initialize LED with specified GPIO pin
+ *
+ * @param[in] GpioPin      GPIO pin number
+ * @param[in] ActiveState  LED active state (TRUE=high active, FALSE=low active)
+ *
+ * @retval EFI_SUCCESS     Initialization successful
+ * @retval Others          Initialization failed
+ */
+EFI_STATUS
+EFIAPI
+LedInitializeEx (
+  IN UINT32   GpioPin,
+  IN BOOLEAN  ActiveState
+  )
+{
+  EFI_STATUS  Status;
+
+  // Initialize GPIO protocol
+  Status = InitializeGpioProtocol ();
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  // Configure GPIO as output mode
+  Status = mGpio->Set (mGpio, GpioPin, GPIO_MODE_OUTPUT_0);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to set GPIO %d as output: %r\n", GpioPin, Status));
+    return Status;
+  }
+
+  // Initial state is off
+  Status = mGpio->Set (mGpio, GpioPin, ActiveState ? GPIO_MODE_OUTPUT_0 : GPIO_MODE_OUTPUT_1);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to set initial state for GPIO %d: %r\n", GpioPin, Status));
+    return Status;
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+ * Set LED state
+ *
+ * @param[in] LedIndex     LED index (0-based)
+ * @param[in] State        LED state (TRUE=on, FALSE=off)
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+EFIAPI
+LedSetState (
+  IN UINT32   LedIndex,
+  IN BOOLEAN  State
+  )
+{
+  EFI_STATUS  Status;
+
+  // Check if LED is initialized
+  if ((mLeds == NULL) || (LedIndex >= mLedCount) || (!mLeds[LedIndex].IsInitialized)) {
+    Status = LedInitialize (LedIndex);
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+  }
+
+  // Set LED state
+  return LedSetStateEx (mLeds[LedIndex].GpioPin, State, mLeds[LedIndex].ActiveState);
+}
+
+/**
+ * Set LED state for specified GPIO pin
+ *
+ * @param[in] GpioPin      GPIO pin number
+ * @param[in] State        LED state (TRUE=on, FALSE=off)
+ * @param[in] ActiveState  LED active state (TRUE=high active, FALSE=low active)
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+EFIAPI
+LedSetStateEx (
+  IN UINT32   GpioPin,
+  IN BOOLEAN  State,
+  IN BOOLEAN  ActiveState
+  )
+{
+  EFI_STATUS  Status;
+  BOOLEAN     GpioState;
+
+  // Initialize GPIO protocol
+  Status = InitializeGpioProtocol ();
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  // Determine GPIO output level based on active state
+  GpioState = (State == ActiveState);
+
+  // Set GPIO state
+  Status = mGpio->Set (mGpio, GpioPin, GpioState ? GPIO_MODE_OUTPUT_1 : GPIO_MODE_OUTPUT_0);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to set GPIO %d state: %r\n", GpioPin, Status));
+    return Status;
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+ * Execute LED blink pattern
+ *
+ * @param[in] LedIndex     LED index (0-based)
+ * @param[in] Pattern      Predefined blink pattern
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+EFIAPI
+LedBlink (
+  IN UINT32  LedIndex,
+  IN UINT32  Pattern
+  )
+{
+  EFI_STATUS         Status;
+  LED_BLINK_PATTERN  BlinkPattern;
+  LED_CONFIG_ARRAY   *LedConfigs;
+
+  // Check if LED is initialized
+  if ((mLeds == NULL) || (LedIndex >= mLedCount) || (!mLeds[LedIndex].IsInitialized)) {
+    Status = LedInitialize (LedIndex);
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+  }
+
+  // Get LED configuration
+  LedConfigs = (LED_CONFIG_ARRAY *)PcdGetPtr (PcdLedConfigs);
+  if (LedConfigs == NULL) {
+    // Use default values
+    BlinkPattern.ShortTimeMs = 100;
+    BlinkPattern.PauseTimeMs = 200;
+    BlinkPattern.LongTimeMs  = 3000;
+  } else {
+    BlinkPattern.ShortTimeMs = LedConfigs->Timing.ShortTimeMs;
+    BlinkPattern.PauseTimeMs = LedConfigs->Timing.PauseTimeMs;
+    BlinkPattern.LongTimeMs  = LedConfigs->Timing.LongTimeMs;
+  }
+
+  // Set blink parameters based on pattern
+  switch (Pattern) {
+    case LED_PATTERN_NORMAL:
+      // Solid on
+      return LedSetState (LedIndex, TRUE);
+
+    case LED_PATTERN_BOOTLOADER:
+      // Short blink 1 time
+      BlinkPattern.BlinkCount = 1;
+      BlinkPattern.Repeat     = FALSE;
+      break;
+
+    case LED_PATTERN_RAM:
+      // Short blink 2 times
+      BlinkPattern.BlinkCount = 2;
+      BlinkPattern.Repeat     = FALSE;
+      break;
+
+    case LED_PATTERN_KERNEL:
+      // Short blink 3 times
+      BlinkPattern.BlinkCount = 3;
+      BlinkPattern.Repeat     = FALSE;
+      break;
+
+    case LED_PATTERN_GRUB:
+      // Short blink 4 times
+      BlinkPattern.BlinkCount = 4;
+      BlinkPattern.Repeat     = FALSE;
+      break;
+
+    default:
+      DEBUG ((DEBUG_ERROR, "LED: Unknown blink pattern: %d\n", Pattern));
+      return EFI_INVALID_PARAMETER;
+  }
+
+  // Execute blink
+  return LedBlinkEx (LedIndex, &BlinkPattern);
+}
+
+/**
+ * Execute custom LED blink pattern
+ *
+ * @param[in] LedIndex     LED index (0-based)
+ * @param[in] BlinkPattern Blink pattern parameters
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+EFIAPI
+LedBlinkEx (
+  IN UINT32             LedIndex,
+  IN LED_BLINK_PATTERN  *BlinkPattern
+  )
+{
+  EFI_STATUS  Status;
+  UINT32      Index;
+  UINT32      Count;
+
+  if (BlinkPattern == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  // Check if LED is initialized
+  if ((mLeds == NULL) || (LedIndex >= mLedCount) || (!mLeds[LedIndex].IsInitialized)) {
+    Status = LedInitialize (LedIndex);
+    if (EFI_ERROR (Status)) {
+      return Status;
+    }
+  }
+
+  // Record current blinking LED
+  mBlinkActive     = TRUE;
+  mCurrentBlinkLed = LedIndex;
+
+  // Execute blink pattern
+  Count = 0;
+  do {
+    // Execute specified number of short blinks
+    for (Index = 0; Index < BlinkPattern->BlinkCount; Index++) {
+      // Turn on LED
+      Status = LedSetState (LedIndex, TRUE);
+      if (EFI_ERROR (Status)) {
+        mBlinkActive = FALSE;
+        return Status;
+      }
+
+      // Short blink duration
+      MicroSecondDelay (BlinkPattern->ShortTimeMs * 1000);
+
+      // Turn off LED
+      Status = LedSetState (LedIndex, FALSE);
+      if (EFI_ERROR (Status)) {
+        mBlinkActive = FALSE;
+        return Status;
+      }
+
+      // Check if blinking should stop
+      if (!mBlinkActive) {
+        return EFI_SUCCESS;
+      }
+
+      // Blink interval
+      if (Index < (BlinkPattern->BlinkCount - 1)) {
+        MicroSecondDelay (BlinkPattern->PauseTimeMs * 1000);
+      }
+    }
+
+    // Long pause
+    MicroSecondDelay (BlinkPattern->LongTimeMs * 1000);
+
+    // Check if blinking should stop
+    if (!mBlinkActive) {
+      return EFI_SUCCESS;
+    }
+
+    Count++;
+  } while (BlinkPattern->Repeat && mBlinkActive);
+
+  mBlinkActive = FALSE;
+  return EFI_SUCCESS;
+}
+
+/**
+ * Stop LED blinking
+ *
+ * @param[in] LedIndex     LED index (0-based)
+ * @param[in] FinalState   Final LED state after stopping (TRUE=on, FALSE=off)
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+EFIAPI
+LedStopBlink (
+  IN UINT32   LedIndex,
+  IN BOOLEAN  FinalState
+  )
+{
+  // Check if this is the currently blinking LED
+  if (mBlinkActive && (mCurrentBlinkLed == LedIndex)) {
+    mBlinkActive = FALSE;
+  }
+
+  // Set final state
+  return LedSetState (LedIndex, FinalState);
+}
+
+/**
+ * Indicate system status
+ *
+ * @param[in] StatusCode   Status code (1-6, corresponding to different blink patterns)
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+EFIAPI
+LedIndicateStatus (
+  IN UINT32  StatusCode
+  )
+{
+  UINT32  LedIndex;
+
+  // Use the first LED to indicate status
+  LedIndex = 0;
+
+  // Set blink pattern based on status code
+  switch (StatusCode) {
+    case 1:  // Power error
+      DEBUG ((DEBUG_ERROR, "LED: Indicating power error\n"));
+      return LedSetState (LedIndex, TRUE);  // Solid on
+
+    case 2:                                // System boot complete
+      return LedSetState (LedIndex, TRUE); // Solid on
+
+    case 3:  // Bootloader error
+      DEBUG ((DEBUG_ERROR, "LED: Indicating bootloader error\n"));
+      return LedBlink (LedIndex, LED_PATTERN_BOOTLOADER);  // Short blink 1 time
+
+    case 4:  // RAM error
+      DEBUG ((DEBUG_ERROR, "LED: Indicating RAM error\n"));
+      return LedBlink (LedIndex, LED_PATTERN_RAM);  // Short blink 2 times
+
+    case 5:  // Kernel error
+      DEBUG ((DEBUG_ERROR, "LED: Indicating kernel error\n"));
+      return LedBlink (LedIndex, LED_PATTERN_KERNEL);  // Short blink 3 times
+
+    case 6:  // GRUB error
+      DEBUG ((DEBUG_ERROR, "LED: Indicating GRUB error\n"));
+      return LedBlink (LedIndex, LED_PATTERN_GRUB);  // Short blink 4 times
+
+    default:
+      DEBUG ((DEBUG_ERROR, "LED: Unknown status code: %d\n", StatusCode));
+      return EFI_INVALID_PARAMETER;
+  }
+}
+
+/**
+ * LED blink timer callback function
+ *
+ * @param[in] Event      Event handle
+ * @param[in] Context    Context pointer
+ */
+VOID
+EFIAPI
+LedBlinkTimerCallback (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  EFI_STATUS     Status;
+  UINT32         LedIndex         = 0; // Use the first LED
+  static UINT32  LongPauseCounter = 0;
+
+  if (!mLedBlinkActive) {
+    return;
+  }
+
+  // Control LED based on current state
+  switch (mLedBlinkState) {
+    case 0:  // LED on state
+      if (mLedBlinkIndex < mLedBlinkCount) {
+        // Turn on LED
+        Status = LedSetState (LedIndex, TRUE);
+        if (EFI_ERROR (Status)) {
+          DEBUG ((DEBUG_ERROR, "LED: Timer - Failed to turn on LED: %r\n", Status));
+          return;
+        }
+
+        // Switch to off state
+        mLedBlinkState = 1;
+      } else {
+        // All blinks completed, enter long on state
+        Status = LedSetState (LedIndex, TRUE);
+        if (EFI_ERROR (Status)) {
+          DEBUG ((DEBUG_ERROR, "LED: Timer - Failed to turn on LED for long pause: %r\n", Status));
+          return;
+        }
+
+        mLedBlinkState   = 2;
+        LongPauseCounter = 0;  // Reset long on counter
+      }
+
+      break;
+
+    case 1:  // LED off state
+      // Turn off LED
+      Status = LedSetState (LedIndex, FALSE);
+      if (EFI_ERROR (Status)) {
+        DEBUG ((DEBUG_ERROR, "LED: Timer - Failed to turn off LED: %r\n", Status));
+        return;
+      }
+
+      // Increment blink index
+      mLedBlinkIndex++;
+
+      // Switch back to on state
+      mLedBlinkState = 0;
+      break;
+
+    case 2:  // Long on state (3 seconds)
+      // Count every 200ms, 15 times for 3 seconds
+      LongPauseCounter++;
+
+      if (LongPauseCounter >= 15) {
+        // Turn off LED after 3 seconds
+        Status = LedSetState (LedIndex, FALSE);
+        if (EFI_ERROR (Status)) {
+          DEBUG ((DEBUG_ERROR, "LED: Timer - Failed to turn off LED after long pause: %r\n", Status));
+          return;
+        }
+
+        // Restart blink sequence
+        mLedBlinkIndex = 0;
+        mLedBlinkState = 0;
+
+        // Short delay before starting next round of blinking
+        // Keep LED off for 1 second
+        mLedBlinkState   = 3;
+        LongPauseCounter = 0;
+      }
+
+      break;
+
+    case 3:  // Blink interval state (1 second)
+      // Count every 200ms, 5 times for 1 second
+      LongPauseCounter++;
+
+      if (LongPauseCounter >= 5) {
+        // Restart blink sequence
+        mLedBlinkIndex = 0;
+        mLedBlinkState = 0;
+      }
+
+      break;
+  }
+}
+
+/**
+ * Start LED blink timer
+ *
+ * @param[in] Pattern    Blink pattern (5=short blink 3 times)
+ *
+ * @retval EFI_SUCCESS   Operation successful
+ * @retval Others        Operation failed
+ */
+EFI_STATUS
+StartLedBlinkTimer (
+  IN UINT32  Pattern
+  )
+{
+  EFI_STATUS  Status;
+
+  // Close timer if it already exists
+  if (mLedBlinkTimerEvent != NULL) {
+    gBS->CloseEvent (mLedBlinkTimerEvent);
+    mLedBlinkTimerEvent = NULL;
+  }
+
+  // Set blink parameters
+  mLedBlinkActive  = TRUE;
+  mLedBlinkPattern = Pattern;
+  mLedBlinkState   = 0;
+  mLedBlinkIndex   = 0;
+
+  // Set blink count based on pattern
+  switch (Pattern) {
+    case 5:  // Kernel error - short blink 3 times
+      mLedBlinkCount = 3;
+      break;
+
+    case 6:  // GRUB error - short blink 4 times
+      mLedBlinkCount = 4;
+      break;
+
+    default:
+      mLedBlinkCount = 1;
+      break;
+  }
+
+  // Create timer event
+  Status = gBS->CreateEvent (
+                             EVT_TIMER | EVT_NOTIFY_SIGNAL,
+                             TPL_CALLBACK,
+                             LedBlinkTimerCallback,
+                             NULL,
+                             &mLedBlinkTimerEvent
+                             );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to create blink timer event: %r\n", Status));
+    return Status;
+  }
+
+  // Set timer (200ms interval = 200,000 microseconds)
+  // Use 200,000 * 10 = 2,000,000 (2 million) nanoseconds as period
+  Status = gBS->SetTimer (
+                          mLedBlinkTimerEvent,
+                          TimerPeriodic,
+                          200 * 1000 * 10 // 200ms in 100ns units
+                          );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to set blink timer: %r\n", Status));
+    gBS->CloseEvent (mLedBlinkTimerEvent);
+    mLedBlinkTimerEvent = NULL;
+    return Status;
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+ * Stop LED blink timer
+ *
+ * @param[in] FinalState   Final LED state after stopping (TRUE=on, FALSE=off)
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+StopLedBlinkTimer (
+  IN BOOLEAN  FinalState
+  )
+{
+  EFI_STATUS  Status;
+  UINT32      LedIndex = 0;  // Use the first LED
+
+  // Stop blinking
+  mLedBlinkActive = FALSE;
+
+  // Close timer event
+  if (mLedBlinkTimerEvent != NULL) {
+    gBS->CloseEvent (mLedBlinkTimerEvent);
+    mLedBlinkTimerEvent = NULL;
+  }
+
+  // Set final LED state
+  Status = LedSetState (LedIndex, FinalState);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to set final LED state: %r\n", Status));
+    return Status;
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+ * Status code handler function
+ */
+EFI_STATUS
+EFIAPI
+LedStatusCodeHandler (
+  IN EFI_STATUS_CODE_TYPE   CodeType,
+  IN EFI_STATUS_CODE_VALUE  Value,
+  IN UINT32                 Instance,
+  IN EFI_GUID               *CallerId,
+  IN EFI_STATUS_CODE_DATA   *Data
+  )
+{
+  EFI_STATUS  Status;
+
+  // Check if it's an error code
+  if ((CodeType & EFI_STATUS_CODE_TYPE_MASK) == EFI_ERROR_CODE) {
+    // Check if it's a boot option load error
+    if ((Value == (EFI_SOFTWARE_DXE_BS_DRIVER | EFI_SW_DXE_BS_EC_BOOT_OPTION_LOAD_ERROR)) ||
+        (Value == (EFI_SOFTWARE_DXE_BS_DRIVER | EFI_SW_DXE_BS_EC_BOOT_OPTION_FAILED)))
+    {
+      DEBUG ((DEBUG_ERROR, "LED: Boot option load failed\n"));
+
+      // Use timer to control LED blinking - status 6: short blink 4 times and long on for 3 seconds in a loop
+      Status = StartLedBlinkTimer (6);
+      if (EFI_ERROR (Status)) {
+        DEBUG ((DEBUG_ERROR, "LED: Failed to start blink timer: %r\n", Status));
+
+        // Fall back to direct LED setting if timer start fails
+        Status = LedIndicateStatus (6);
+        if (EFI_ERROR (Status)) {
+          DEBUG ((DEBUG_ERROR, "LED: Failed to indicate boot file not found: %r\n", Status));
+        }
+      }
+    }
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+ * Register status code handler
+ */
+EFI_STATUS
+RegisterLedStatusCodeHandler (
+  VOID
+  )
+{
+  EFI_STATUS                Status;
+  EFI_RSC_HANDLER_PROTOCOL  *RscHandlerProtocol;
+
+  // Locate status code handler protocol
+  Status = gBS->LocateProtocol (
+                                &gEfiRscHandlerProtocolGuid,
+                                NULL,
+                                (VOID **)&RscHandlerProtocol
+                                );
+
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to locate RSC Handler Protocol: %r\n", Status));
+    return Status;
+  }
+
+  // Register status code handler function
+  Status = RscHandlerProtocol->Register (LedStatusCodeHandler, TPL_CALLBACK);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to register status code handler: %r\n", Status));
+    return Status;
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+ * Unregister LED status code handler before exiting boot services
+ */
+STATIC VOID
+EFIAPI
+UnregisterLedStatusCodeHandler (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  EFI_RSC_HANDLER_PROTOCOL  *RscHandlerProtocol;
+  EFI_STATUS                Status;
+
+  Status = gBS->LocateProtocol (
+                                &gEfiRscHandlerProtocolGuid,
+                                NULL,
+                                (VOID **)&RscHandlerProtocol
+                                );
+  if (!EFI_ERROR (Status)) {
+    // Unregister the handler
+    RscHandlerProtocol->Unregister (LedStatusCodeHandler);
+  }
+}
+
+/**
+ * Turn LED on
+ *
+ * @param[in] LedIndex     LED index (0-based)
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+EFIAPI
+LedTurnOn (
+  IN UINT32  LedIndex
+  )
+{
+  return LedSetState (LedIndex, TRUE);
+}
+
+/**
+ * Turn LED off
+ *
+ * @param[in] LedIndex     LED index (0-based)
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+EFIAPI
+LedTurnOff (
+  IN UINT32  LedIndex
+  )
+{
+  return LedSetState (LedIndex, FALSE);
+}
+
+// Protocol instance
+STATIC LED_CONTROL_PROTOCOL  mLedControlProtocol = {
+  LedTurnOn,
+  LedTurnOff,
+  LedBlink
+};
+
+/**
+ * LED control driver entry point
+ *
+ * @param[in] ImageHandle    Image handle
+ * @param[in] SystemTable    System table pointer
+ *
+ * @retval EFI_SUCCESS       Driver initialization successful
+ * @retval Others            Initialization failed
+ */
+EFI_STATUS
+EFIAPI
+LedControlDriverEntryPoint (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS        Status;
+  UINT32            LedIndex;
+  LED_CONFIG_ARRAY  *LedConfigs;
+
+  DEBUG ((DEBUG_INFO, "LED: Driver starting...\n"));
+
+  // Initialize GPIO protocol
+  Status = InitializeGpioProtocol ();
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to initialize GPIO protocol: %r\n", Status));
+    return Status;
+  }
+
+  // Get LED configuration
+  LedConfigs = (LED_CONFIG_ARRAY *)PcdGetPtr (PcdLedConfigs);
+  if ((LedConfigs == NULL) || (LedConfigs->Num == 0)) {
+    DEBUG ((DEBUG_ERROR, "LED: No LED configurations found\n"));
+    return EFI_NOT_FOUND;
+  }
+
+  // Initialize all LEDs
+  for (LedIndex = 0; LedIndex < LedConfigs->Num; LedIndex++) {
+    Status = LedInitialize (LedIndex);
+    if (EFI_ERROR (Status)) {
+      DEBUG ((DEBUG_ERROR, "LED: Failed to initialize LED %d: %r\n", LedIndex, Status));
+      // Continue initializing other LEDs
+    }
+  }
+
+  // Add exit boot services event to ensure unregistering status code handler
+  Status = gBS->CreateEvent (
+                             EVT_SIGNAL_EXIT_BOOT_SERVICES,
+                             TPL_CALLBACK,
+                             UnregisterLedStatusCodeHandler,
+                             NULL,
+                             &mExitBootServicesEvent
+                             );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to create exit boot services event: %r\n", Status));
+  }
+
+  // Register status code handler function
+  Status = RegisterLedStatusCodeHandler ();
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to register status code handler: %r\n", Status));
+    // Continue execution, don't exit due to registration failure
+  }
+
+  // Indicate system boot complete
+  Status = LedIndicateStatus (2);  // Status code 2 indicates system boot complete
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to indicate system boot complete: %r\n", Status));
+  }
+
+  // Install LED Control Protocol
+  Status = gBS->InstallMultipleProtocolInterfaces (
+                                                   &ImageHandle,
+                                                   &gLedControlProtocolGuid,
+                                                   &mLedControlProtocol,
+                                                   NULL
+                                                   );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "LED: Failed to install LED Control Protocol: %r\n", Status));
+    return Status;
+  }
+
+  return EFI_SUCCESS;
+}
diff --git a/Silicon/Spacemit/K1/Drivers/LedControl/LedControl.h b/Silicon/Spacemit/K1/Drivers/LedControl/LedControl.h
new file mode 100755
index 0000000000..a987c341ad
--- /dev/null
+++ b/Silicon/Spacemit/K1/Drivers/LedControl/LedControl.h
@@ -0,0 +1,189 @@
+/**
+*
+*  Copyright (c) 2024, SpacemiT Co., Ltd. All rights reserved.
+*
+*  SPDX-License-Identifier: BSD-2-Clause-Patent
+*
+**/
+
+#ifndef __LED_CONTROL_H__
+#define __LED_CONTROL_H__
+
+#include <Uefi.h>
+#include <Library/DebugLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/TimerLib.h>
+#include <Library/PcdLib.h>
+#include <Protocol/EmbeddedGpio.h>
+
+#include "LedPcdConfig.h"
+
+// LED control structure
+typedef struct {
+  UINT32     GpioPin;       // GPIO pin connected to LED
+  BOOLEAN    ActiveState;   // LED active state (TRUE=high active, FALSE=low active)
+  BOOLEAN    IsInitialized; // Initialization status
+} LED_CONTROL;
+
+// LED blink pattern structure
+typedef struct {
+  UINT32     BlinkCount;  // Number of blinks
+  UINT32     ShortTimeMs; // Short blink duration (milliseconds)
+  UINT32     PauseTimeMs; // Interval between blinks (milliseconds)
+  UINT32     LongTimeMs;  // Long on duration (milliseconds)
+  BOOLEAN    Repeat;      // Whether to repeat the pattern
+} LED_BLINK_PATTERN;
+
+// Define the LED Control Protocol GUID
+#define LED_CONTROL_PROTOCOL_GUID \
+  { 0x25E46BD7, 0x3ED8, 0xBBC0, { 0x2B, 0x4A, 0xFA, 0xD5, 0x2B, 0x1B, 0x65, 0x75 } }
+
+extern EFI_GUID gLedControlProtocolGuid;
+
+// LED Control Protocol structure
+typedef struct _LED_CONTROL_PROTOCOL {
+  // Turn LED on
+  EFI_STATUS (EFIAPI *TurnOn) (
+    IN UINT32  LedIndex
+  );
+  
+  // Turn LED off
+  EFI_STATUS (EFIAPI *TurnOff) (
+    IN UINT32  LedIndex
+  );
+  
+  // Blink LED with pattern
+  EFI_STATUS (EFIAPI *Blink) (
+    IN UINT32  LedIndex,
+    IN UINT32  Pattern
+  );
+} LED_CONTROL_PROTOCOL;
+
+/**
+ * Initialize LED control
+ *
+ * @param[in] LedIndex     LED index (0-based)
+ *
+ * @retval EFI_SUCCESS     Initialization successful
+ * @retval EFI_NOT_FOUND   GPIO protocol not found
+ * @retval Others          Initialization failed
+ */
+EFI_STATUS
+EFIAPI
+LedInitialize (
+  IN UINT32  LedIndex
+  );
+
+/**
+ * Initialize LED with specified GPIO pin
+ *
+ * @param[in] GpioPin      GPIO pin number
+ * @param[in] ActiveState  LED active state (TRUE=high active, FALSE=low active)
+ *
+ * @retval EFI_SUCCESS     Initialization successful
+ * @retval Others          Initialization failed
+ */
+EFI_STATUS
+EFIAPI
+LedInitializeEx (
+  IN UINT32   GpioPin,
+  IN BOOLEAN  ActiveState
+  );
+
+/**
+ * Set LED state
+ *
+ * @param[in] LedIndex     LED index (0-based)
+ * @param[in] State        LED state (TRUE=on, FALSE=off)
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+EFIAPI
+LedSetState (
+  IN UINT32   LedIndex,
+  IN BOOLEAN  State
+  );
+
+/**
+ * Set LED state for specified GPIO pin
+ *
+ * @param[in] GpioPin      GPIO pin number
+ * @param[in] State        LED state (TRUE=on, FALSE=off)
+ * @param[in] ActiveState  LED active state (TRUE=high active, FALSE=low active)
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+EFIAPI
+LedSetStateEx (
+  IN UINT32   GpioPin,
+  IN BOOLEAN  State,
+  IN BOOLEAN  ActiveState
+  );
+
+/**
+ * Execute LED blink pattern
+ *
+ * @param[in] LedIndex     LED index (0-based)
+ * @param[in] Pattern      Predefined blink pattern
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+EFIAPI
+LedBlink (
+  IN UINT32  LedIndex,
+  IN UINT32  Pattern
+  );
+
+/**
+ * Execute custom LED blink pattern
+ *
+ * @param[in] LedIndex     LED index (0-based)
+ * @param[in] BlinkPattern Blink pattern parameters
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+EFIAPI
+LedBlinkEx (
+  IN UINT32             LedIndex,
+  IN LED_BLINK_PATTERN  *BlinkPattern
+  );
+
+/**
+ * Stop LED blinking
+ *
+ * @param[in] LedIndex     LED index (0-based)
+ * @param[in] FinalState   Final LED state after stopping (TRUE=on, FALSE=off)
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+EFIAPI
+LedStopBlink (
+  IN UINT32   LedIndex,
+  IN BOOLEAN  FinalState
+  );
+
+/**
+ * Indicate system status
+ *
+ * @param[in] StatusCode   Status code (1-6, corresponding to different blink patterns)
+ *
+ * @retval EFI_SUCCESS     Operation successful
+ * @retval Others          Operation failed
+ */
+EFI_STATUS
+EFIAPI
+LedIndicateStatus (
+  IN UINT32  StatusCode
+  );
+
+#endif // __LED_CONTROL_H__
diff --git a/Silicon/Spacemit/K1/Drivers/LedControl/LedControl.inf b/Silicon/Spacemit/K1/Drivers/LedControl/LedControl.inf
