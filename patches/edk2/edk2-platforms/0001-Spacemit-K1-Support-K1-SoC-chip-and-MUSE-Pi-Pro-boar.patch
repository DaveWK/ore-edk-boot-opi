+  )
+{
+  EFI_STATUS          Status;
+  UINT64              I, MemSize;
+  MEMORY_LAYOUT_INFO  MemLayout[8];
+
+  Status = mPlatformInfoProtocol->GetPlatformInfo (
+                                                   mPlatformInfoProtocol,
+                                                   "mem_layout",
+                                                   MemLayout,
+                                                   ARRAY_SIZE (MemLayout)
+                                                   );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_WARN, "Couldn't get the board memory size - defaulting to 512 MB: %r\n", Status));
+    // The memory layout used in all known K1 SoC's starts at 0
+    MemLayout[0].PhysicalAddress = 0;
+    // The minimum RAM size used on any K1 model is 512 MByte
+    MemLayout[0].PhysicalSize = 512 * 0x100000;
+
+    MemLayout[1].PhysicalAddress = 0;
+    MemLayout[1].PhysicalSize    = 0;
+  }
+
+  for (I = 0; MemLayout[I].PhysicalSize != 0; I++) {
+    // Note: Type 19 addresses are expressed in KB, not bytes
+    mMemArrMapInfoType19.StartingAddress = MemLayout[I].PhysicalAddress / 1024;
+    MemSize                              = MemLayout[I].PhysicalSize / 1024;
+    mMemArrMapInfoType19.EndingAddress   = mMemArrMapInfoType19.StartingAddress + MemSize - 1;
+    LogSmbiosData ((EFI_SMBIOS_TABLE_HEADER *)&mMemArrMapInfoType19, mMemArrMapInfoType19Strings, NULL);
+  }
+}
+
+/***********************************************************************
+        Driver Entry
+************************************************************************/
+EFI_STATUS
+EFIAPI
+PlatformSmbiosDriverEntryPoint (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS  Status;
+
+  Status = gBS->LocateProtocol (
+                                &gSpacemitPlatformInfoProtocolGuid,
+                                NULL,
+                                (void **)&mPlatformInfoProtocol
+                                );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "Fail to locate PlatformInfo protocol %r\n", Status));
+    return Status;
+  }
+
+  CacheInfoUpdateSmbiosType7 ();                     // Add Type 7 first to get Cache handle for use in Type 4
+  ProcessorInfoUpdateSmbiosType4 (MAX_CPU_HART_NUM); // One example for creating and updating
+
+  PhyMemArrayInfoUpdateSmbiosType16 ();
+  MemDevInfoUpdateSmbiosType17 ();
+  MemArrMapInfoUpdateSmbiosType19 ();
+
+  return EFI_SUCCESS;
+}
