index 0000000000..581e9075ad
--- /dev/null
+++ b/Silicon/Spacemit/Override/MdeModulePkg/Bus/Pci/PciBusDxe/PciDeviceSupport.c
@@ -0,0 +1,1032 @@
+/** @file
+  Supporting functions implementation for PCI devices management.
+
