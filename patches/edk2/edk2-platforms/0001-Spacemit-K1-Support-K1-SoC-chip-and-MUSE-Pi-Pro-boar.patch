+    MiscBootInformation
+    ),
+};
+
+//
+// Number of Data Table entries.
+//
+UINTN  mSmbiosMiscDataTableEntries =
+  (sizeof (mSmbiosMiscDataTable)) / sizeof (SMBIOS_MISC_DATA_TABLE);
