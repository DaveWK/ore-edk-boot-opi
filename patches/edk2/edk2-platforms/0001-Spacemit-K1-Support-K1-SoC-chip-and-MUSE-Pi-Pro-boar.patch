+
+#include <Uefi.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+
+#include "MemInfoScreen.h"
+
+/**
+  This is function collects meminfo from NVParam
+
+  @param  Data                  The buffer to return the contents.
+
+  @retval EFI_SUCCESS           Get response data successfully.
+  @retval Other value           Failed to get meminfo from NVParam
+**/
+EFI_STATUS
+MemInfoNvparamGet (
+  OUT MEM_INFO_VARSTORE_DATA  *VarStoreConfig
+  )
+{
+  EFI_STATUS                    Status;
+  UINTN                         VarSize = sizeof (MEM_INFO_VARSTORE_DATA);
+  MEM_INFO_SCREEN_PRIVATE_DATA  *PrivateData;
+
+  ASSERT (VarStoreConfig != NULL);
+
+  PrivateData = MEM_INFO_SCREEN_PRIVATE_FROM_VARSTORECONFIG (VarStoreConfig);
+  Status      = gRT->GetVariable (
+                                  MEM_INFO_VARSTORE_NAME,
+                                  &gSpacemitProductVariableGuid,
+                                  NULL,
+                                  &VarSize,
+                                  VarStoreConfig
+                                  );
+
+  if ((EFI_ERROR (Status)) &&
+      EFI_ERROR (
+                 PrivateData->PlatformInfoProtocol->GetPlatformInfo (
+                                                                     PrivateData->PlatformInfoProtocol,
+                                                                     "ddr_datarate",
+                                                                     &VarStoreConfig->DDRSpeedSel,
+                                                                     sizeof (VarStoreConfig->DDRSpeedSel)
+                                                                     )
+                 ))
+  {
+    VarStoreConfig->DDRSpeedSel = PLATFORM_DDR_DEFAUL_DATARATE;
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+  This is function stores meminfo to corresponding NVParam
+
+  @param  VarStoreConfig         The contents for the variable.
+
+  @retval EFI_SUCCESS            Set data successfully.
+  @retval Other value            Failed to set meminfo to NVParam
+
+**/
+EFI_STATUS
+MemInfoNvparamSet (
+  IN MEM_INFO_VARSTORE_DATA  *VarStoreConfig
+  )
+{
+  EFI_STATUS  Status;
+
+  ASSERT (VarStoreConfig != NULL);
+
+  // Set environment variable using our custom GUID - store as ASCII
+  Status = gRT->SetVariable (
+                             MEM_INFO_VARSTORE_NAME,
+                             &gSpacemitProductVariableGuid,
+                             EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS,
+                             sizeof (MEM_INFO_VARSTORE_DATA),
+                             VarStoreConfig
+                             );
+
+  return Status;
+}
