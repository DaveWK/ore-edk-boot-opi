diff --git a/Silicon/Spacemit/K1/Drivers/GPIO/K1xGpioDxe.c b/Silicon/Spacemit/K1/Drivers/GPIO/K1xGpioDxe.c
new file mode 100755
index 0000000000..242af655b9
--- /dev/null
+++ b/Silicon/Spacemit/K1/Drivers/GPIO/K1xGpioDxe.c
@@ -0,0 +1,437 @@
+/**
+*
+*  Copyright (c) 2024, SpacemiT Co., Ltd. All rights reserved.
+*
+*  SPDX-License-Identifier: BSD-2-Clause-Patent
+*
+**/
+
+#include <Library/BaseMemoryLib.h>
+#include <Library/UefiRuntimeLib.h>
+#include <Library/MemoryManagementLib.h>
+#include <Uefi/UefiBaseType.h>
+
+#include "K1xGpioDxe.h"
+
+// Global variables
+STATIC K1X_GPIO  *mGpioInstance;
+
+// Device path template
+STATIC CONST struct {
+  VENDOR_DEVICE_PATH          Vendor;
+  EFI_DEVICE_PATH_PROTOCOL    End;
+} mDevicePathTemplate = {
+  {
+    {
+      HARDWARE_DEVICE_PATH,
+      HW_VENDOR_DP,
+      {
+        (UINT8)(sizeof (VENDOR_DEVICE_PATH)),
+        (UINT8)((sizeof (VENDOR_DEVICE_PATH)) >> 8),
+      },
+    },
+    // Use driver GUID
+    K1X_GPIO_DEVICE_GUID
+  },
+  {
+    END_DEVICE_PATH_TYPE,
+    END_ENTIRE_DEVICE_PATH_SUBTYPE,
+    {
+      (UINT8)(sizeof (EFI_DEVICE_PATH_PROTOCOL)),
+      (UINT8)((sizeof (EFI_DEVICE_PATH_PROTOCOL)) >> 8),
+    },
+  }
+};
+
+/**
+ * Get GPIO register base address
+ *
+ * @param[in]  Bank          GPIO bank number
+ *
+ * @retval     Register base address, or NULL if Bank is invalid
+ */
+STATIC
+K1X_GPIO_REGISTERS *
+GetGpioBase (
+  IN UINTN  Bank
+  )
+{
+  UINTN               BaseAddress;
+  STATIC CONST UINTN  BankOffset[K1X_GPIO_BANK_COUNT] = {
+    K1X_GPIO_BANK0_OFFSET,
+    K1X_GPIO_BANK1_OFFSET,
+    K1X_GPIO_BANK2_OFFSET,
+    K1X_GPIO_BANK3_OFFSET
+  };
+
+  if (Bank >= K1X_GPIO_BANK_COUNT) {
+    DEBUG ((DEBUG_ERROR, "K1X GPIO: Invalid GPIO bank %d\n", Bank));
+    return NULL;
+  }
+
+  BaseAddress = PcdGet64 (PcdGpioControllerBase);
+  return (K1X_GPIO_REGISTERS *)(BaseAddress + BankOffset[Bank]);
+}
+
+/**
+  Map GPIO controller MMIO regions to GCD space.
+
+  @retval None
+**/
+STATIC
+VOID
+GpioMmioRemap (
+  VOID
+  )
+{
+  // Map GPIO controller registers to MMIO space
+  MapRegToGcdMmioSpace (PcdGet64 (PcdGpioControllerBase), SIZE_4KB);
+  MapRegToGcdMmioSpace (K1_MFPR_BASE, SIZE_4KB);
+  MapRegToGcdMmioSpace (K1_APB_CLOCK, SIZE_4KB);
+}
+
+/**
+  Init GPIO controller clock and release the reset.
+
+  @retval None
+**/
+STATIC
+VOID
+GpioHwInit (
+  VOID
+  )
+{
+  // release reset for GPIO controller
+  MmioAnd32 (K1_APBC_GPIO_CLK_RST, ~0x03);
+  // enable clock for GPIO controller
+  MmioAndThenOr32 (K1_APBC_GPIO_CLK_RST, ~0x03, 0x03);
+}
+
+/**
+ * Get GPIO state
+ *
+ * @param[in]  This          GPIO protocol instance
+ * @param[in]  Gpio          GPIO pin number
+ * @param[out] Value         GPIO state
+ *
+ * @retval EFI_SUCCESS       Operation successful
+ * @retval EFI_INVALID_PARAMETER Invalid parameter
+ */
+STATIC
+EFI_STATUS
+EFIAPI
+K1xGpioGet (
+  IN  EMBEDDED_GPIO      *This,
+  IN  EMBEDDED_GPIO_PIN  Gpio,
+  OUT UINTN              *Value
+  )
+{
+  K1X_GPIO_REGISTERS  *GpioRegBank;
+  UINTN               GpioPin;
+  UINT32              RegValue;
+
+  if (Value == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  GpioPin = (UINTN)Gpio;
+  if (GpioPin >= K1X_MAX_GPIO) {
+    DEBUG ((DEBUG_ERROR, "K1X GPIO: Invalid GPIO %d\n", GpioPin));
+    return EFI_INVALID_PARAMETER;
+  }
+
+  GpioRegBank = GetGpioBase (GPIO_TO_REG (GpioPin));
+  if (GpioRegBank == NULL) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  // Read GPIO state
+  RegValue = MmioRead32 ((UINTN)&GpioRegBank->gplr);
+
+  // Return GPIO state
+  *Value = (RegValue & GPIO_TO_BIT (GpioPin)) ? 1 : 0;
+
+  return EFI_SUCCESS;
+}
+
+/**
+ * Set GPIO mode
+ *
+ * @param[in]  This          GPIO protocol instance
+ * @param[in]  Gpio          GPIO pin number
+ * @param[in]  Mode          GPIO mode
+ *
+ * @retval EFI_SUCCESS       Operation successful
+ * @retval EFI_INVALID_PARAMETER Invalid parameter
+ * @retval EFI_UNSUPPORTED   Unsupported mode
+ */
+STATIC
+EFI_STATUS
+EFIAPI
+K1xGpioSet (
+  IN  EMBEDDED_GPIO       *This,
+  IN  EMBEDDED_GPIO_PIN   Gpio,
+  IN  EMBEDDED_GPIO_MODE  Mode
+  )
+{
+  K1X_GPIO_REGISTERS  *GpioRegBank;
+  UINTN               GpioPin;
+
+  GpioPin = (UINTN)Gpio;
+  if (GpioPin >= K1X_MAX_GPIO) {
+    DEBUG ((DEBUG_ERROR, "K1X GPIO: Invalid GPIO %d\n", GpioPin));
+    return EFI_INVALID_PARAMETER;
+  }
+
+  GpioRegBank = GetGpioBase (GPIO_TO_REG (GpioPin));
+  if (GpioRegBank == NULL) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  switch (Mode) {
+    case GPIO_MODE_INPUT:
+      // Set as input
+      MmioWrite32 ((UINTN)&GpioRegBank->gcdr, GPIO_TO_BIT (GpioPin));
+      break;
+
+    case GPIO_MODE_OUTPUT_0:
+      // Set as output
+      MmioWrite32 ((UINTN)&GpioRegBank->gsdr, GPIO_TO_BIT (GpioPin));
+      // Set output to low
+      MmioWrite32 ((UINTN)&GpioRegBank->gpcr, GPIO_TO_BIT (GpioPin));
+      break;
+
+    case GPIO_MODE_OUTPUT_1:
+      // Set as output
+      MmioWrite32 ((UINTN)&GpioRegBank->gsdr, GPIO_TO_BIT (GpioPin));
+      // Set output to high
+      MmioWrite32 ((UINTN)&GpioRegBank->gpsr, GPIO_TO_BIT (GpioPin));
+      break;
+
+    default:
+      DEBUG ((DEBUG_ERROR, "K1X GPIO: Unsupported mode %d for GPIO %d\n", Mode, GpioPin));
+      return EFI_UNSUPPORTED;
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+ * Get GPIO mode
+ *
+ * @param[in]  This          GPIO protocol instance
+ * @param[in]  Gpio          GPIO pin number
+ * @param[out] Mode          GPIO mode
+ *
+ * @retval EFI_SUCCESS       Operation successful
+ * @retval EFI_INVALID_PARAMETER Invalid parameter
+ */
+STATIC
+EFI_STATUS
+EFIAPI
+K1xGpioGetMode (
+  IN  EMBEDDED_GPIO       *This,
+  IN  EMBEDDED_GPIO_PIN   Gpio,
+  OUT EMBEDDED_GPIO_MODE  *Mode
+  )
+{
+  K1X_GPIO_REGISTERS  *GpioRegBank;
+  UINTN               GpioPin;
+  UINT32              DirValue;
+  UINT32              LevelValue;
+
+  if (Mode == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  GpioPin = (UINTN)Gpio;
+  if (GpioPin >= K1X_MAX_GPIO) {
+    DEBUG ((DEBUG_ERROR, "K1X GPIO: Invalid GPIO %d\n", GpioPin));
+    return EFI_INVALID_PARAMETER;
+  }
+
+  GpioRegBank = GetGpioBase (GPIO_TO_REG (GpioPin));
+  if (GpioRegBank == NULL) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  // Read direction register
+  DirValue = MmioRead32 ((UINTN)&GpioRegBank->gpdr);
+
+  if (!(DirValue & GPIO_TO_BIT (GpioPin))) {
+    // Input mode
+    *Mode = GPIO_MODE_INPUT;
+  } else {
+    // Output mode, read level
+    LevelValue = MmioRead32 ((UINTN)&GpioRegBank->gplr);
+
+    if (LevelValue & GPIO_TO_BIT (GpioPin)) {
+      // Output high
+      *Mode = GPIO_MODE_OUTPUT_1;
+    } else {
+      // Output low
+      *Mode = GPIO_MODE_OUTPUT_0;
+    }
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+ * Set GPIO pull-up/pull-down
+ *
+ * @param[in]  This          GPIO protocol instance
+ * @param[in]  Gpio          GPIO pin number
+ * @param[in]  Pull          GPIO pull-up/pull-down
+ *
+ * @retval EFI_SUCCESS       Operation successful
+ * @retval EFI_INVALID_PARAMETER Invalid parameter
+ * @retval EFI_UNSUPPORTED   Unsupported on this hardware
+ */
+STATIC
+EFI_STATUS
+EFIAPI
+K1xGpioSetPull (
+  IN  EMBEDDED_GPIO       *This,
+  IN  EMBEDDED_GPIO_PIN   Gpio,
+  IN  EMBEDDED_GPIO_PULL  Pull
+  )
+{
+  UINTN  MfpReg;
+  UINTN  GpioPin;
+
+  GpioPin = (UINTN)Gpio;
+  if (GpioPin >= K1X_MAX_GPIO) {
+    DEBUG ((DEBUG_ERROR, "K1X GPIO: Invalid GPIO %d\n", GpioPin));
+    return EFI_INVALID_PARAMETER;
+  }
+
+  MfpReg = K1_MFPR_BASE + MFPR_REG_ADDR (GpioPin);
+
+  switch (Pull) {
+    case GPIO_PULL_UP:
+      MmioAndThenOr32 (MfpReg, ~MFP_PULL_MASK, MFP_PULL_UP);
+      break;
+
+    case GPIO_PULL_DOWN:
+      MmioAndThenOr32 (MfpReg, ~MFP_PULL_MASK, MFP_PULL_DOWN);
+      break;
+
+    case GPIO_PULL_NONE:
+      MmioAndThenOr32 (MfpReg, ~MFP_PULL_MASK, MFP_PULL_DIS);
+      break;
+
+    default:
+      DEBUG ((DEBUG_ERROR, "%a: Unsupported pull operation %d for GPIO %d\n", __func__, Pull, GpioPin));
+      return EFI_UNSUPPORTED;
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+ * Driver entry point
+ *
+ * @param[in]  ImageHandle   Image handle
+ * @param[in]  SystemTable   Pointer to system table
+ *
+ * @retval EFI_SUCCESS       Driver initialized successfully
+ * @retval Others            Failed to initialize driver
+ */
+EFI_STATUS
+EFIAPI
+K1xGpioDxeInitialize (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS                Status;
+  EFI_DEVICE_PATH_PROTOCOL  *GpioDevicePath;
+  UINTN                     ControllerCount;
+
+  DEBUG ((DEBUG_INFO, "K1X GPIO: Driver entry point called\n"));
+  GpioMmioRemap ();
+  GpioHwInit ();
+
+  // Set controller count to 1
+  ControllerCount = 1;
+
+  DEBUG ((DEBUG_INFO, "K1X GPIO: Controller count: %d\n", ControllerCount));
+  DEBUG ((DEBUG_INFO, "K1X GPIO: Pin count: %d\n", K1X_MAX_GPIO));
+
+  // Create device path
+  GpioDevicePath = DuplicateDevicePath ((EFI_DEVICE_PATH_PROTOCOL *)&mDevicePathTemplate);
+  if (GpioDevicePath == NULL) {
+    DEBUG ((DEBUG_ERROR, "K1X GPIO: Failed to create device path\n"));
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  DEBUG ((DEBUG_INFO, "K1X GPIO: Device path created successfully\n"));
+
+  // Allocate GPIO instance
+  mGpioInstance = AllocateZeroPool (sizeof (K1X_GPIO));
+  if (mGpioInstance == NULL) {
+    DEBUG ((DEBUG_ERROR, "K1X GPIO: Failed to allocate GPIO instance\n"));
+    FreePool (GpioDevicePath);
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  // Allocate SoC GPIO configuration
+  mGpioInstance->SoCGpio = AllocateZeroPool (sizeof (K1X_GPIO_CONTROLLER_CONFIG) * ControllerCount);
+  if (mGpioInstance->SoCGpio == NULL) {
+    DEBUG ((DEBUG_ERROR, "K1X GPIO: Failed to allocate SoC GPIO configuration\n"));
+    FreePool (mGpioInstance);
+    mGpioInstance = NULL;
+    FreePool (GpioDevicePath);
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  // Initialize GPIO instance
+  mGpioInstance->Signature       = K1X_GPIO_SIGNATURE;
+  mGpioInstance->GpioDeviceCount = ControllerCount;
+
+  // Initialize SoC GPIO configuration
+  mGpioInstance->SoCGpio[0].RegisterBase      = PcdGet64 (PcdGpioControllerBase);
+  mGpioInstance->SoCGpio[0].InternalGpioCount = K1X_MAX_GPIO;
+
+  DEBUG (
+         (DEBUG_INFO, "K1X GPIO: Controller[0] base: 0x%lx, pins: %d\n",
+          mGpioInstance->SoCGpio[0].RegisterBase,
+          mGpioInstance->SoCGpio[0].InternalGpioCount)
+         );
+
+  // Initialize GPIO protocol
+  mGpioInstance->GpioProtocol.Get     = K1xGpioGet;
+  mGpioInstance->GpioProtocol.Set     = K1xGpioSet;
+  mGpioInstance->GpioProtocol.GetMode = K1xGpioGetMode;
+  mGpioInstance->GpioProtocol.SetPull = K1xGpioSetPull;
+
+  DEBUG ((DEBUG_INFO, "K1X GPIO: Protocol initialized\n"));
+
+  // Install protocols
+  Status = gBS->InstallMultipleProtocolInterfaces (
+                                                   &(mGpioInstance->Handle),
+                                                   &gEmbeddedGpioProtocolGuid,
+                                                   &(mGpioInstance->GpioProtocol),
+                                                   &gEfiDevicePathProtocolGuid,
+                                                   GpioDevicePath,
+                                                   NULL
+                                                   );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "K1X GPIO: Failed to install protocols: %r\n", Status));
+    goto ErrInstallProtocol;
+  }
+
+  DEBUG ((DEBUG_INFO, "K1X GPIO: Protocols installed successfully on handle 0x%p\n", mGpioInstance->Handle));
+
+  DEBUG ((DEBUG_INFO, "K1X GPIO: Driver initialized successfully\n"));
+  return EFI_SUCCESS;
+
+ErrInstallProtocol:
+  FreePool (mGpioInstance->SoCGpio);
+  FreePool (mGpioInstance);
+  mGpioInstance = NULL;
+  FreePool (GpioDevicePath);
+
+  return Status;
+}
diff --git a/Silicon/Spacemit/K1/Drivers/GPIO/K1xGpioDxe.h b/Silicon/Spacemit/K1/Drivers/GPIO/K1xGpioDxe.h
new file mode 100755
index 0000000000..9d7c4869ba
--- /dev/null
+++ b/Silicon/Spacemit/K1/Drivers/GPIO/K1xGpioDxe.h
@@ -0,0 +1,252 @@
+/**
+*
+*  Copyright (c) 2024, SpacemiT Co., Ltd. All rights reserved.
+*
+*  SPDX-License-Identifier: BSD-2-Clause-Patent
+*
+**/
+
+#ifndef __K1X_GPIO_H__
+#define __K1X_GPIO_H__
+
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/DevicePathLib.h>
+#include <Library/IoLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/PcdLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiLib.h>
+#include <Protocol/EmbeddedGpio.h>
+#include <Uefi/UefiBaseType.h>
+
+#define K1X_GPIO_SIGNATURE  SIGNATURE_64 ('K', '1','X','_', 'G', 'P','I','O')
+
+#define K1_MFPR_BASE            (FixedPcdGet64(PcdSpacemitMFPRRegBase))
+#define K1_APB_CLOCK            (FixedPcdGet64(PcdSpacemitAPBClockRegBase))
+#define K1_APBC_GPIO_CLK_RST    (K1_APB_CLOCK + 8)
+
+/**
+ * GPIO register structure from U-Boot code
+ */
+typedef struct {
+  UINT32    gplr; // Pin Level Register - 0x0000
+  UINT32    pad0[2];
+  UINT32    gpdr; // Pin Direction Register - 0x000C
+  UINT32    pad1[2];
+  UINT32    gpsr; // Pin Output Set Register - 0x0018
+  UINT32    pad2[2];
+  UINT32    gpcr; // Pin Output Clear Register - 0x0024
+  UINT32    pad3[2];
+  UINT32    grer; // Rising-Edge Detect Enable Register - 0x0030
+  UINT32    pad4[2];
+  UINT32    gfer; // Falling-Edge Detect Enable Register - 0x003C
+  UINT32    pad5[2];
+  UINT32    gedr; // Edge Detect Status Register - 0x0048
+  UINT32    pad6[2];
+  UINT32    gsdr; // Bitwise Set of GPIO Direction Register - 0x0054
+  UINT32    pad7[2];
+  UINT32    gcdr; // Bitwise Clear of GPIO Direction Register - 0x0060
+  UINT32    pad8[2];
+  UINT32    gsrer; // Bitwise Set of Rising-Edge Detect Enable Register - 0x006C
+  UINT32    pad9[2];
+  UINT32    gcrer; // Bitwise Clear of Rising-Edge Detect Enable Register - 0x0078
+  UINT32    pad10[2];
+  UINT32    gsfer; // Bitwise Set of Falling-Edge Detect Enable Register - 0x0084
+  UINT32    pad11[2];
+  UINT32    gcfer; // Bitwise Clear of Falling-Edge Detect Enable Register - 0x0090
+  UINT32    pad12[2];
+  UINT32    apmask; // Bitwise Mask of Edge Detect Register - 0x009C
+} K1X_GPIO_REGISTERS;
+
+// GPIO group and bit calculation methods from U-Boot code
+#define GPIO_TO_REG(gp)    ((gp) >> 5)                       // Divide by 32 to get group number
+#define GPIO_TO_BIT(gp)    (1 << ((gp) & 0x1f))              // Get low 5 bits for bit offset
+#define GPIO_VAL(gp, val)  (((val) >> ((gp) & 0x1f)) & 0x01) // Extract bit value from register
+
+#ifndef K1X_MAX_GPIO
+#define K1X_MAX_GPIO  128
+#endif
+
+/* pin mux */
+#define MFP_MUX_MODE0  0
+#define MFP_MUX_MODE1  1
+#define MFP_MUX_MODE2  2
+#define MFP_MUX_MODE3  3
+#define MFP_MUX_MODE4  4
+#define MFP_MUX_MODE5  5
+#define MFP_MUX_MODE6  6
+#define MFP_MUX_MODE7  7
+
+/* edge detect */
+#define MFP_EDGE_NONE  (1 << 6)
+#define MFP_EDGE_RISE  (1 << 4)
+#define MFP_EDGE_FALL  (1 << 5)
+#define MFP_EDGE_BOTH  (3 << 4)
+
+/* driver strength*/
+#define MFP_PAD_1V8_DS0  (0 << 11)
+#define MFP_PAD_1V8_DS1  (1 << 11)
+#define MFP_PAD_1V8_DS2  (2 << 11)
+#define MFP_PAD_1V8_DS3  (3 << 11)
+
+/* pull up/down */
+#define MFP_PULL_DIS   (0 << 13) /* bit[15:13] 000 */
+#define MFP_PULL_UP    (6 << 13) /* bit[15:13] 110 */
+#define MFP_PULL_DOWN  (5 << 13) /* bit[15:13] 101 */
+#define MFP_PULL_MASK  (7 << 13) /* bit[15:13] 111 */
+
+/* pin Offset */
+#define PINID(x)  ((x) + 1)
+
+#define MFPR_REG_ADDR(x)                    \
+  ({                                        \
+    UINT32 MfprRegAddr;                     \
+    if ((x) >= 111)                         \
+      MfprRegAddr = 4 * PINID((x) + 19);    \
+    else if ((x) >= 86)                     \
+      MfprRegAddr = 4 * PINID((x) + 36);    \
+    else                                    \
+      MfprRegAddr = 4 * PINID(x);           \
+    MfprRegAddr;                            \
+  })
+
+// GPIO register group offset definitions
+#define K1X_GPIO_BANK_COUNT    4
+#define K1X_GPIO_BANK0_OFFSET  0
+#define K1X_GPIO_BANK1_OFFSET  4
+#define K1X_GPIO_BANK2_OFFSET  8
+#define K1X_GPIO_BANK3_OFFSET  0x100
+
+// GPIO controller configuration structure
+typedef struct {
+  UINTN    RegisterBase;      // Register base address
+  UINTN    InternalGpioCount; // Number of GPIO pins
+} K1X_GPIO_CONTROLLER_CONFIG;
+
+typedef struct {
+  EMBEDDED_GPIO                 GpioProtocol;
+  K1X_GPIO_CONTROLLER_CONFIG    *SoCGpio;
+  UINTN                         GpioDeviceCount;
+  UINT64                        Signature;
+  EFI_HANDLE                    Handle;
+} K1X_GPIO;
+
+// K1X GPIO device GUID
+#define K1X_GPIO_DEVICE_GUID \
+  { \
+    0x8E586847, 0xEE4B, 0x86E6, { 0x9A, 0x34, 0x5C, 0x45, 0x51, 0xA2, 0xDC, 0x85 } \
+  }
+
+/**
+ * Function declarations
+ */
+
+/**
+ * Get GPIO register base address
+ *
+ * @param[in]  Bank          GPIO bank number
+ *
+ * @retval     Register base address, or NULL if Bank is invalid
+ */
+STATIC
+K1X_GPIO_REGISTERS *
+GetGpioBase (
+  IN UINTN  Bank
+  );
+
+/**
+ * Get GPIO state
+ *
+ * @param[in]  This          GPIO protocol instance
+ * @param[in]  Gpio          GPIO pin number
+ * @param[out] Value         GPIO state
+ *
+ * @retval EFI_SUCCESS       Operation successful
+ * @retval EFI_INVALID_PARAMETER Invalid parameter
+ */
+STATIC
+EFI_STATUS
+EFIAPI
+K1xGpioGet (
+  IN  EMBEDDED_GPIO      *This,
+  IN  EMBEDDED_GPIO_PIN  Gpio,
+  OUT UINTN              *Value
+  );
+
+/**
+ * Set GPIO mode
+ *
+ * @param[in]  This          GPIO protocol instance
+ * @param[in]  Gpio          GPIO pin number
+ * @param[in]  Mode          GPIO mode
+ *
+ * @retval EFI_SUCCESS       Operation successful
+ * @retval EFI_INVALID_PARAMETER Invalid parameter
+ * @retval EFI_UNSUPPORTED   Unsupported mode
+ */
+STATIC
+EFI_STATUS
+EFIAPI
+K1xGpioSet (
+  IN  EMBEDDED_GPIO       *This,
+  IN  EMBEDDED_GPIO_PIN   Gpio,
+  IN  EMBEDDED_GPIO_MODE  Mode
+  );
+
+/**
+ * Get GPIO mode
+ *
+ * @param[in]  This          GPIO protocol instance
+ * @param[in]  Gpio          GPIO pin number
+ * @param[out] Mode          GPIO mode
+ *
+ * @retval EFI_SUCCESS       Operation successful
+ * @retval EFI_INVALID_PARAMETER Invalid parameter
+ */
+STATIC
+EFI_STATUS
+EFIAPI
+K1xGpioGetMode (
+  IN  EMBEDDED_GPIO       *This,
+  IN  EMBEDDED_GPIO_PIN   Gpio,
+  OUT EMBEDDED_GPIO_MODE  *Mode
+  );
+
+/**
+ * Set GPIO pull-up/pull-down
+ *
+ * @param[in]  This          GPIO protocol instance
+ * @param[in]  Gpio          GPIO pin number
+ * @param[in]  Pull          GPIO pull-up/pull-down
+ *
+ * @retval EFI_SUCCESS       Operation successful
+ * @retval EFI_INVALID_PARAMETER Invalid parameter
+ * @retval EFI_UNSUPPORTED   Unsupported on this hardware
+ */
+STATIC
+EFI_STATUS
+EFIAPI
+K1xGpioSetPull (
+  IN  EMBEDDED_GPIO       *This,
+  IN  EMBEDDED_GPIO_PIN   Gpio,
+  IN  EMBEDDED_GPIO_PULL  Pull
+  );
+
+/**
+ * Driver entry point
+ *
+ * @param[in]  ImageHandle   Image handle
+ * @param[in]  SystemTable   Pointer to system table
+ *
+ * @retval EFI_SUCCESS       Driver initialized successfully
+ * @retval Others            Failed to initialize driver
+ */
+EFI_STATUS
+EFIAPI
+K1xGpioDxeInitialize (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  );
+
+#endif // __K1X_GPIO_H__
