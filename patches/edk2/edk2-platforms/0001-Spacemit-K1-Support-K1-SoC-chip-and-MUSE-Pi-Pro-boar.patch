index 0000000000..f6066d54c4
--- /dev/null
+++ b/Silicon/Spacemit/Drivers/RamDiskRegisterDxe/RamDiskRegisterDxe.c
@@ -0,0 +1,74 @@
+/** @file
+  A driver to register a RAM disk.
+
+  Copyright (c) 2024, SpacemiT Co., Ltd. All rights reserved.<BR>
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <Uefi.h>
+#include <Library/UefiDriverEntryPoint.h>
+#include <Library/PcdLib.h>
+#include <Library/DebugLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Protocol/RamDisk.h>
+
+EFI_STATUS
+EFIAPI
+RamDiskRegisterDxeEntryPoint (
+  IN EFI_HANDLE         ImageHandle,
+  IN EFI_SYSTEM_TABLE   *SystemTable
+  )
+{
+  EFI_STATUS                 Status;
+  EFI_RAM_DISK_PROTOCOL      *RamDisk;
+  EFI_DEVICE_PATH_PROTOCOL   *DevicePath;
+  UINT64                     Base;
+  UINT64                     Size;
+
+  Status = EFI_UNSUPPORTED;
+
+  if (FeaturePcdGet (PcdRamDiskSupported)) {
+    Status = gBS->LocateProtocol (&gEfiRamDiskProtocolGuid, NULL, (VOID**)&RamDisk);
+    if (EFI_ERROR (Status)) {
+      DEBUG ((
+        DEBUG_ERROR,
+        "%a: Couldn't find RAM Disk Protocol - %r\n",
+        __func__,
+        Status
+        ));
+      return Status;
+    }
+
+    Base = PcdGet64 (PcdRamDiskBase);
+    Size = PcdGet64 (PcdRamDiskSize);
+    if (Base == 0xffffffffffffffff || Size == 0) {
+      DEBUG ((
+        DEBUG_ERROR,
+        "%a: Invalid RAM Disk base or size (PcdRamDiskBase: 0x%lx, PcdRamDiskSize: 0x%lx)\n",
+        __func__,
+        Base,
+        Size
+        ));
+      return EFI_INVALID_PARAMETER;
+    }
+
+    Status = RamDisk->Register (
+                    (UINTN)Base,
+                    (UINTN)Size,
+                    &gEfiVirtualDiskGuid,
+                    NULL,
+                    &DevicePath
+                    );
+    if (EFI_ERROR (Status)) {
+      DEBUG ((
+        DEBUG_ERROR,
+        "%a: Failed to register RAM Disk - %r\n",
+        __func__,
+        Status
+        ));
+    }
+  }
+
+  return Status;
+}
