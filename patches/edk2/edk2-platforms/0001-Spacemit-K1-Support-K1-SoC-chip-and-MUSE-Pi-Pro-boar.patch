diff --git a/Silicon/Spacemit/K1/Drivers/UsbHcdInitDxe/GpioLib.h b/Silicon/Spacemit/K1/Drivers/UsbHcdInitDxe/GpioLib.h
new file mode 100644
index 0000000000..71fc796600
--- /dev/null
+++ b/Silicon/Spacemit/K1/Drivers/UsbHcdInitDxe/GpioLib.h
@@ -0,0 +1,149 @@
+/** @file
+
+  Copyright 2025, SpacemiT Co., Ltd. All rights reserved.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#ifndef USB_GPIOLIB_H_
+#define USB_GPIOLIB_H_
+
+#include <Library/IoLib.h>
+
+#define K1_APMU_BASE  (FixedPcdGet64(PcdSpacemitAPMURegBase))
+#define K1_MPMU_BASE  (FixedPcdGet64(PcdSpacemitMPMURegBase))
+#define K1_MFPR_BASE  (FixedPcdGet64(PcdSpacemitMFPRRegBase))
+
+/* pin Offset */
+#define PINID(x)  ((x) + 1)
+
+#define MFPR_REG_ADDR(x)                                                       \
+  ({                                                                           \
+    UINT32 MfprRegAddr;                                                        \
+    if ((x) >= 111)                                                            \
+      MfprRegAddr = 4 * PINID((x) + 19);                                       \
+    else if ((x) >= 86)                                                        \
+      MfprRegAddr = 4 * PINID((x) + 36);                                       \
+    else                                                                       \
+      MfprRegAddr = 4 * PINID(x);                                              \
+    MfprRegAddr;                                                               \
+  })
+
+#define GPIO_97   PINID(120)
+#define GPIO_123  PINID(142)
+#define GPIO_124  PINID(143)
+#define GPIO_127  PINID(146)
+
+/* pin mux */
+#define MUX_MODE0  0
+#define MUX_MODE1  1
+#define MUX_MODE2  2
+#define MUX_MODE3  3
+#define MUX_MODE4  4
+#define MUX_MODE5  5
+#define MUX_MODE6  6
+#define MUX_MODE7  7
+
+/* edge detect */
+#define EDGE_NONE  (1 << 6)
+#define EDGE_RISE  (1 << 4)
+#define EDGE_FALL  (1 << 5)
+#define EDGE_BOTH  (3 << 4)
+
+/* driver strength*/
+#define PAD_1V8_DS0  (0 << 11)
+#define PAD_1V8_DS1  (1 << 11)
+#define PAD_1V8_DS2  (2 << 11)
+#define PAD_1V8_DS3  (3 << 11)
+
+/* pull up/down */
+#define PULL_DIS   (0 << 13) /* bit[15:13] 000 */
+#define PULL_UP    (6 << 13) /* bit[15:13] 110 */
+#define PULL_DOWN  (5 << 13) /* bit[15:13] 101 */
+
+#define USB_GPIO_PIN_CONFIG(x)  ((x) | EDGE_NONE | PULL_DIS | PAD_1V8_DS2)
+
+// GPIO pin Index, GPIO multi-function ID
+typedef struct {
+  UINT32    Index;
+  UINT32    PinId;
+  UINT32    Mux;
+} GPIO_Pin_Config;
+
+struct gpio_reg {
+  UINT32    Gplr;       /* Pin Level Register - 0x0000 */
+  UINT32    Pad0[2];
+  UINT32    Gpdr;       /* Pin Direction Register - 0x000C */
+  UINT32    Pad1[2];
+  UINT32    Gpsr;       /* Pin Output Set Register - 0x0018 */
+  UINT32    Pad2[2];
+  UINT32    Gpcr;       /* Pin Output Clear Register - 0x0024 */
+  UINT32    Pad3[2];
+  UINT32    Grer;       /* Rising-Edge Detect Enable Register - 0x0030 */
+  UINT32    Pad4[2];
+  UINT32    Gfer;       /* Falling-Edge Detect Enable Register - 0x003C */
+  UINT32    Pad5[2];
+  UINT32    Gedr;       /* Edge Detect Status Register - 0x0048 */
+  UINT32    Pad6[2];
+  UINT32    Gsdr;       /* Bitwise Set of GPIO Direction Register - 0x0054 */
+  UINT32    Pad7[2];
+  UINT32    Gcdr;       /* Bitwise Clear of GPIO Direction Register - 0x0060 */
+  UINT32    Pad8[2];
+  UINT32    Gsrer;      /* Bitwise Set of Rising-Edge Detect Enable
+                           Register - 0x006C */
+  UINT32    Pad9[2];
+  UINT32    Gcrer;      /* Bitwise Clear of Rising-Edge Detect Enable
+                           Register - 0x0078 */
+  UINT32    Pad10[2];
+  UINT32    Gsfer;      /* Bitwise Set of Falling-Edge Detect Enable
+                           Register - 0x0084 */
+  UINT32    Pad11[2];
+  UINT32    Gcfer;      /* Bitwise Clear of Falling-Edge Detect Enable
+                           Register - 0x0090 */
+  UINT32    Pad12[2];
+  UINT32    Apmask;     /* Bitwise Mask of Edge Detect Register - 0x009C */
+};
+
+#define K1X_GPIO_BASE  0xD4019000
+
+#define GPIO_BASE(index) \
+({ \
+const unsigned long offset[] = {0, 4, 8, 0x100}; \
+(struct gpio_reg *)(K1X_GPIO_BASE + offset[(index >> 5)]); \
+})
+
+#define GPIO_TO_BIT(gp)  (1 << (gp & 0x1f))
+#define GPIO_OUT_HIGH  1
+#define GPIO_OUT_LOW   0
+VOID
+GpioConfigureOutput (
+  UINT8  Index,
+  UINT8  Value
+  )
+{
+  /* Set Gpio Output */
+  MmioWrite32 ((UINTN)&GPIO_BASE (Index)->Gsdr, GPIO_TO_BIT (Index));
+  if (Value) {
+    MmioWrite32 ((UINTN)&GPIO_BASE (Index)->Gpsr, GPIO_TO_BIT (Index));
+  } else {
+    MmioWrite32 ((UINTN)&GPIO_BASE (Index)->Gpcr, GPIO_TO_BIT (Index));
+  }
+}
+
+#define GpioEnableConfig(config, Port, I) \
+  for (Port = 0; Port < ARRAY_SIZE(config); Port++) { \
+    for (I = 0; I < ARRAY_SIZE(config[0]); I++) { \
+      MmioWrite32( \
+          K1_MFPR_BASE + MFPR_REG_ADDR(config[Port][I].PinId), \
+          USB_GPIO_PIN_CONFIG(config[Port][I].Mux)); \
+    } \
+  } \
+  for (Port = 0; Port < ARRAY_SIZE(config); Port++) { \
+    for (I = 0; I < ARRAY_SIZE(config[0]); I++) { \
+      GpioConfigureOutput(config[Port][I].Index, 1); \
+      MicroSecondDelay (10 * 1000); \
+    } \
+  }
+
+#endif
diff --git a/Silicon/Spacemit/K1/Drivers/UsbHcdInitDxe/UsbHcd.c b/Silicon/Spacemit/K1/Drivers/UsbHcdInitDxe/UsbHcd.c
