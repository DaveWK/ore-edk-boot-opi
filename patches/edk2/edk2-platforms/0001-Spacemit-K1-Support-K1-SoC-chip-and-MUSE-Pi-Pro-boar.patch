+
+/**
+  Emmc hardware initialization.
+
+**/
+STATIC
+VOID
+EmmcHwInit (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance
+  )
+{
+  UINT32  Value, Timeout;
+  UINT32  ClkSrc, ClkDiv;
+
+  ClkSrc = SDHC_DEFAULT_CLOCK_SRC;
+  ClkDiv = SDHC_DEFAULT_CLOCK_DIV;
+  EmmcClkPrepare (ClkSrc, ClkDiv);
+
+  Value  = MmioRead32 (PMU_SDH0_CLK_CTRL);
+  Value |= (PMU_SDH_AXI_RST | PMU_SDH_AXICLK_EN);
+  MmioWrite32 (PMU_SDH0_CLK_CTRL, Value);
+
+  Value  = MmioRead32 (PMU_EMMC_CLK_CTRL);
+  Value |= (ClkSrc << PMU_SDH_CLK_SEL_BASE | ClkDiv << PMU_SDH_CLK_DIV_BASE);
+  MmioWrite32 (PMU_EMMC_CLK_CTRL, Value);
+
+  Value |= (PMU_SDH_RST | PMU_SDH_CLK_EN | PMU_SDH_CLK_FC_REQ);
+  MmioWrite32 (PMU_EMMC_CLK_CTRL, Value);
+  Timeout = 100;
+  while (Timeout) {
+    Value = MmioRead32 (PMU_EMMC_CLK_CTRL);
+    if ((Value & PMU_SDH_CLK_FC_REQ) == 0) {
+      break;
+    }
+
+    Timeout--;
+    gBS->Stall (10);
+  }
+
+  if (!Timeout) {
+    DEBUG ((DEBUG_ERROR, "%a, waiting for PMU_SDH_CLK_FC_REQ Timeout\n", __func__));
+  }
+
+  /* calculate the sdh input clk */
+  switch (ClkSrc) {
+    case SDH_CLK_SRC_0:
+      Value = SDH_CLK_SRC_0_FREQ;
+      break;
+    case SDH_CLK_SRC_1:
+      Value = SDH_CLK_SRC_1_FREQ;
+      break;
+    case SDH_CLK_SRC_2:
+      Value = SDH_CLK_SRC_2_FREQ;
+      break;
+    case SDH_CLK_SRC_3:
+      Value = SDH_CLK_SRC_3_FREQ;
+      break;
+    default:
+      Value = SDH_CLK_SRC_0_FREQ;
+      break;
+  }
+
+  MmcHcInstance->BmParams.ClkRate = Value / (ClkDiv + 1);
+
+  InitSdhc (MmcHcInstance, SDHC_HOST_BUS_VOLTAGE_1V8);
+}
+
+/**
+  Set the input/output settings for the SD card.
+
+  @param[in] Clk     The clock frequency for the SD card.
+  @param[in] Width   The bus width for data transfer.
+  @param[in] TimingMode     Timing mode, HS200, HS400...
+
+  @retval EFI_SUCCESS             The input/output settings were set successfully.
+  @retval EFI_UNSUPPORTED         The specified bus width is not supported.
+
+**/
+EFI_STATUS
+BmSdSetIos (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN UINT32                        Clk,
+  IN UINT32                        Width,
+  IN UINT32                        TimingMode
+  )
+{
+  // only support HS52, HS26 mode
+  if ((EMMCBACKWARD == TimingMode) || (EMMCHS52 == TimingMode) || (EMMCHS26 == TimingMode)) {
+    SetSdhcBusClock (MmcHcInstance, Clk);
+    SetSdhcBusWidth (MmcHcInstance, Width);
+    return EFI_SUCCESS;
+  } else {
+    DEBUG ((DEBUG_ERROR, "Unsupported timing mode: %d\n", TimingMode));
+    return EFI_UNSUPPORTED;
+  }
+}
+
+/**
+  Prepare the SD card for data transfer.
+  Set the number and size of data blocks before sending IO commands to the SD card.
+
+  @param[in]  Lba       Logical Block Address.
+  @param[in]  Buf       Buffer Address.
+  @param[in]  Size      Size of Data Blocks.
+
+  @retval EFI_SUCCESS             The SD card was prepared successfully.
+  @retval Other                   An error occurred during the preparation of the SD card.
+
+**/
+EFI_STATUS
+BmSdPrepare (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN INT32                         Lba,
+  IN UINTN                         Buf,
+  IN UINTN                         Size
+  )
+{
+  UINTN   LoadAddr;
+  UINTN   Base;
+  UINT32  BlockCnt;
+  UINT32  BlockSize;
+  UINT32  Tmp;
+
+  LoadAddr = Buf;
+
+  if (Size >= MMC_BLOCK_SIZE) {
+    // CMD17, 18, 24, 25
+    // ASSERT (((LoadAddr & MMC_BLOCK_MASK) == 0) && ((Size % MMC_BLOCK_SIZE) == 0));
+    BlockSize = MMC_BLOCK_SIZE;
+    BlockCnt  = Size / MMC_BLOCK_SIZE;
+  } else {
+    // ACMD51
+    ASSERT (((LoadAddr & 4) == 0) && ((Size % 4) == 0));
+    BlockSize = Size;
+    BlockCnt  = 1;
+  }
+
+  Base = MmcHcInstance->BmParams.RegBase;
+
+  if (!(MmcHcInstance->BmParams.Flags & MMC_USE_PIO)) {
+    MmioWrite16 (Base + SDHC_BLOCK_COUNT, BlockCnt);
+    // 512K bytes SDMA buffer boundary
+    MmioWrite16 (Base + SDHC_BLOCK_SIZE, SDHC_MAKE_BLKSZ (7, BlockSize));
+
+    // select SDMA
+    Tmp  = MmioRead32 (Base + SDHC_HOST_CRTL);
+    Tmp &= ~SDHC_HOST_SELECT_DMA_MASK;
+    Tmp |= SDHC_HOST_SELECT_SDMA;
+    MmioWrite32 (Base + SDHC_HOST_CRTL, Tmp);
+
+    ASSERT ((LoadAddr >> 32) == 0);
+    MmioWrite32 (Base + SDHC_DMA_ADDR, LoadAddr);
+
+    WriteBackInvalidateDataCacheRange ((void *)Buf, Size);
+  } else {
+    MmioWrite16 (Base + SDHC_BLOCK_SIZE, BlockSize);
+    MmioWrite16 (Base + SDHC_BLOCK_COUNT, BlockCnt);
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+  SD card sends command to read data blocks.
+
+  @param[in]  Lba       Logical Block Address.
+  @param[in]  Buf       Buffer Address.
+  @param[in]  Size      Size of Data Blocks.
+
+  @retval  EFI_SUCCESS             The command to read data blocks was sent successfully.
+  @retval  EFI_TIMEOUT             The command transmission or data transfer timed out.
+
+**/
+EFI_STATUS
+BmSdRead (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN INT32                         Lba,
+  IN UINT32                        *Buf,
+  IN UINTN                         Size
+  )
+{
+  UINTN       Base;
+  UINT32      *Data;
+  UINT32      BlockSize;
+  UINT32      BlockCnt;
+  EFI_STATUS  Status;
+
+  Base      = MmcHcInstance->BmParams.RegBase;
+  Data      = Buf;
+  BlockSize = 0;
+  BlockCnt  = 0;
+  Status    = EFI_SUCCESS;
+
+  BmSdPrepare (MmcHcInstance, Lba, (UINTN)Buf, Size);
+  Status = SdSendCmdWithData (MmcHcInstance, &MmcHcInstance->PreviousCmd);
+  if (EFI_SUCCESS != Status) {
+    return Status;
+  }
+
+  if (MmcHcInstance->BmParams.Flags & MMC_USE_PIO) {
+    BlockSize  = MmioRead16 (Base + SDHC_BLOCK_SIZE);
+    BlockCnt   = Size / BlockSize;
+    BlockSize /= 4;
+
+    for (INT32 I = 0; I < BlockCnt; I++) {
+      Status = SdHcCheckStatus (MmcHcInstance, SDHC_STATE_RX_READY);
+      if (EFI_SUCCESS != Status) {
+        return Status;
+      }
+
+      for (INT32 j = 0; j < BlockSize; j++, Data++) {
+        *Data = MmioRead32 (Base + SDHC_FIFO_ADDR);
+      }
+    }
+
+    return SdHcWaitData0Up (MmcHcInstance);
+  } else {
+    return EFI_SUCCESS;
+  }
+}
+
+/**
+  SD card sends commands to write data blocks.
+
+  @param[in]  Lba       Logical Block Address.
+  @param[in]  Buf       Buffer Address.
+  @param[in]  Size      Size of Data Blocks.
+
+  @retval  EFI_SUCCESS             The command to write data blocks was sent successfully.
+  @retval  EFI_TIMEOUT             The command transmission or data transfer timed out.
+
+**/
+EFI_STATUS
+BmSdWrite (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN INT32                         Lba,
+  IN UINT32                        *Buf,
+  IN UINTN                         Size
+  )
+{
+  UINTN       Base;
+  UINT32      *Data;
+  UINT32      BlockSize;
+  UINT32      BlockCnt;
+  EFI_STATUS  Status;
+
+  Base      = MmcHcInstance->BmParams.RegBase;
+  Data      = Buf;
+  BlockSize = 0;
+  BlockCnt  = 0;
+  Status    = EFI_SUCCESS;
+
+  BmSdPrepare (MmcHcInstance, Lba, (UINTN)Buf, Size);
+  Status = SdSendCmdWithData (MmcHcInstance, &MmcHcInstance->PreviousCmd);
+  if (EFI_SUCCESS != Status) {
+    return Status;
+  }
+
+  if (MmcHcInstance->BmParams.Flags & MMC_USE_PIO) {
+    BlockSize  = MmioRead16 (Base + SDHC_BLOCK_SIZE);
+    BlockCnt   = Size / BlockSize;
+    BlockSize /= 4;
+
+    for (INT32 I = 0; I < BlockCnt; I++) {
+      Status = SdHcCheckStatus (MmcHcInstance, SDHC_STATE_TX_READY);
+      if (EFI_SUCCESS != Status) {
+        return Status;
+      }
+
+      for (INT32 j = 0; j < BlockSize; j++, Data++) {
+        MmioWrite32 (Base + SDHC_FIFO_ADDR, *Data);
+      }
+    }
+
+    Status = SdHcCheckStatus (MmcHcInstance, SDHC_STATE_XFER_COMPLETE);
+    if (EFI_SUCCESS != Status) {
+      return Status;
+    }
+
+    return SdHcWaitData0Up (MmcHcInstance);
+  } else {
+    return EFI_SUCCESS;
+  }
+}
