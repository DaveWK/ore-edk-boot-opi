+/** @file
+  Platform memory management library.
+
+  Copyright (c) 2024, Spacemit Limited. All rights reserved.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#include <PiDxe.h>
+#include <Uefi/UefiBaseType.h>
+
+#include <Library/DebugLib.h>
+#include <Library/DxeServicesTableLib.h>
+
+/**
+  Map controller register to GCD memory map io space.
+
+  @param  Base                  Controller register base address.
+  @param  Size                  Controller register size.
+
+  @retval EFI_SUCCESS           Map controller register to GCD MMIO space successful.
+  @retval EFI_NOT_AVAILABLE_YET The attributes cannot be set because CPU architectural protocol is
+                                not available yet.
+  @retval Others                As the error code indicates
+
+**/
+EFI_STATUS
+EFIAPI
+MapRegToGcdMmioSpace (
+  IN UINT64  Base,
+  IN UINT64  Size
+  )
+{
+  EFI_STATUS  Status;
+  UINT64      AlignBase, AlignSize;
+
+  //
+  // Controller register base may be not aligned to the page size,
+  // which is not accepted when setting memory space attributes.
+  //
+  AlignBase = Base & ~(SIZE_4KB - 1);
+  AlignSize = (Base - AlignBase + Size + SIZE_4KB - 1) & ~(SIZE_4KB - 1);
+
+  Status = gDS->AddMemorySpace (
+                                EfiGcdMemoryTypeMemoryMappedIo,
+                                AlignBase,
+                                AlignSize,
+                                EFI_MEMORY_UC
+                                );
+  if (EFI_ERROR (Status)) {
+    DEBUG (
+           (DEBUG_ERROR,
+            "%a: failed to add GCD memory space for region [0x%Lx+0x%Lx)\n",
+            __func__, Base, Size)
+           );
+    return Status;
+  }
+
+  Status = gDS->SetMemorySpaceAttributes (AlignBase, AlignSize, EFI_MEMORY_UC);
+  if (EFI_ERROR (Status)) {
+    DEBUG (
+           (DEBUG_ERROR,
+            "%a: failed to set memory space attributes for region [0x%Lx+0x%Lx)\n",
+            __func__, Base, Size)
+           );
+  }
+
+  return Status;
+}
+
+/**
+  Map controller register to GCD runtime memory map io space.
+
+  @param  Base                  Controller register base address.
+  @param  Size                  Controller register size.
+
+  @retval EFI_SUCCESS           Map controller register to GCD MMIO space successful.
+  @retval EFI_NOT_AVAILABLE_YET The attributes cannot be set because CPU architectural protocol is
+                                not available yet.
+  @retval Others                As the error code indicates
+
+**/
+EFI_STATUS
+EFIAPI
+MapRegToGcdRunTimeMmioSpace (
+  IN UINT64  Base,
+  IN UINT64  Size
+  )
+{
+  EFI_STATUS  Status;
+  UINT64      AlignBase, AlignSize;
+
+  //
+  // Controller register base may be not aligned to the page size,
+  // which is not accepted when setting memory space attributes.
+  //
+  AlignBase = Base & ~(SIZE_4KB - 1);
+  AlignSize = (Base - AlignBase + Size + SIZE_4KB - 1) & ~(SIZE_4KB - 1);
+
+  Status = gDS->AddMemorySpace (
+                                EfiGcdMemoryTypeMemoryMappedIo,
+                                AlignBase,
+                                AlignSize,
+                                EFI_MEMORY_UC | EFI_MEMORY_RUNTIME
+                                );
+  if (EFI_ERROR (Status)) {
+    DEBUG (
+           (DEBUG_ERROR,
+            "%a: failed to add GCD memory space for region [0x%Lx+0x%Lx)\n",
+            __func__, Base, Size)
+           );
+    return Status;
+  }
+
+  Status = gDS->SetMemorySpaceAttributes (AlignBase, AlignSize, EFI_MEMORY_UC | EFI_MEMORY_RUNTIME);
+  if (EFI_ERROR (Status)) {
+    DEBUG (
+           (DEBUG_ERROR,
+            "%a: failed to set memory space attributes for region [0x%Lx+0x%Lx)\n",
+            __func__, Base, Size)
+           );
+  }
+
+  return Status;
+}
+
