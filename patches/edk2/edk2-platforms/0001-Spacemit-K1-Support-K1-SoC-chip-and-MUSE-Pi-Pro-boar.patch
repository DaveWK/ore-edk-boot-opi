diff --git a/Silicon/Spacemit/Library/PciSegmentLib/PciSegmentLib.c b/Silicon/Spacemit/Library/PciSegmentLib/PciSegmentLib.c
new file mode 100755
index 0000000000..33dfc5f81e
--- /dev/null
+++ b/Silicon/Spacemit/Library/PciSegmentLib/PciSegmentLib.c
@@ -0,0 +1,1449 @@
+/** @file
+  PCI Segment Library
+
+  Copyright (c) 2016 - 2017, Intel Corporation. All rights reserved.<BR>
+  Copyright (c) 2024, SpacemiT Co., Ltd. All rights reserved.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#include <PiDxe.h>
+#include <Library/BaseLib.h>
+#include <Library/DebugLib.h>
+#include <Library/IoLib.h>
+#include <Library/PcdLib.h>
+#include <Library/PciSegmentLib.h>
+#include <Library/PciRootBrdigeResourceConfig.h>
+
+typedef enum {
+  PciCfgWidthUint8      = 0,
+  PciCfgWidthUint16,
+  PciCfgWidthUint32,
+  PciCfgWidthMax
+} PCI_CFG_WIDTH;
+
+/**
+  Assert the validity of a PCI Segment address.
+  A valid PCI Segment address should not contain 1's in bits 28..31 and 48..63
+
+  @param  A The address to validate.
+  @param  M Additional bits to assert to be zero.
+
+**/
+#define ASSERT_INVALID_PCI_SEGMENT_ADDRESS(A,M) \
+  ASSERT (((A) & (0xffff0000f0000000ULL | (M))) == 0)
+
+//
+// Global varible to cache pointer to Pci Root Bridge Resource Config Aarry
+//
+STATIC PCI_ROOT_BRIDGE_RESOURCE_CONFIG_ARRAY   *mRootBridges = NULL;
+
+/**
+  Internal function to get PCI configuration space mmio base address.
+
+  @param  Address   The address that encodes the PCI Segment, Bus, Device, Function,
+                    and Register.
+
+  @return The mmio base address for PCI configuration space.
+
+**/
+STATIC
+UINT64
+PciSegmentLibGetConfigBase (
+  IN  UINT64      Address
+  )
+{
+  UINTN                                   Index;
+  UINT16                                  Segment;
+  UINT64                                  ConfigBase;
+
+  Segment    = (UINT16) (Address >> 32);
+  ConfigBase = MAX_UINT64;
+
+  if (mRootBridges) {
+    for (Index = 0; Index < mRootBridges->ArrayNum; Index++) {
+      if (mRootBridges->ArrayData[Index].Segment == Segment &&
+          mRootBridges->ArrayData[Index].IsEnabled) {
+        ConfigBase = mRootBridges->ArrayData[Index].ConfigBase;
+        break;
+      }
+    }
+  }
+
+  return ConfigBase;
+}
+
+/**
+  Internal worker function to read a PCI configuration register.
+
+  @param  Address   The address that encodes the PCI Segment, Bus, Device, Function,
+                    and Register.
+  @param  Width     The width of data to read
+
+  @return The value read from the PCI configuration register.
+
+**/
+STATIC
+UINT32
+PciSegmentLibReadWorker (
+  IN  UINT64                      Address,
+  IN  PCI_CFG_WIDTH               Width
+  )
+{
+  UINT64    Base;
+
+  Base = PciSegmentLibGetConfigBase (Address);
+  if (Base == MAX_UINT64) {
+    return 0;
+  }
+
+  switch (Width) {
+    case PciCfgWidthUint8:
+      return MmioRead8 (Base + (UINT32)Address);
+    case PciCfgWidthUint16:
+      return MmioRead16 (Base + (UINT32)Address);
+    case PciCfgWidthUint32:
