+STATIC
+VOID
+SdhcMmioRemap (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance
+  )
+{
+  MapRegToGcdMmioSpace (MmcHcInstance->BmParams.RegBase, SIZE_4KB);
+  MapRegToGcdMmioSpace (K1_APMU_BASE, SIZE_4KB);
+}
+
+/**
+  Initialize the SD card.
+
+  This function performs the initialization of the SD card hardware and settings.
+
+  @param[in] Flags     Initialization flags.
+
+  @retval EFI_SUCCESS  The SD card was initialized successfully.
+
+**/
+EFI_STATUS
+SdInit (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance
+  )
+{
+  DEBUG ((DEBUG_INFO, "SD initializing %dHz\n", MmcHcInstance->BmParams.ClkSource));
+
+  SdhcMmioRemap (MmcHcInstance);
+
+  SdPhyInit (MmcHcInstance);
+
+  if (!MmcHcInstance->BmParams.IsEmmc) {
+    SdHwInit (MmcHcInstance);
+  } else {
+    EmmcHwInit (MmcHcInstance);
+  }
+
+  return EFI_SUCCESS;
+}
