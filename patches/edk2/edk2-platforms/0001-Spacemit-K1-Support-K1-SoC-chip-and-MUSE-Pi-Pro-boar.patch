+#define EFI_ACPI_6_6_RHCT_MMU_TYPE_SV39   0x0
+#define EFI_ACPI_6_6_RHCT_MMU_TYPE_SV48   0x1
+#define EFI_ACPI_6_6_RHCT_MMU_TYPE_SV57   0x2
