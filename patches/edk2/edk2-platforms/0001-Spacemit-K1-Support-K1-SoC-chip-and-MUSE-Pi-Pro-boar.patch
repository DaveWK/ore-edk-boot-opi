+
+STATIC inline void
+PcieDbiWriteEnable (
+  IN UINT32   Port,
+  IN BOOLEAN  En
+  )
+{
+  UINT32  Val;
+
+  Val = K1PcieDbiRead32 (Port, DW_PCIE_MISC_CONTROL_1_OFF);
+  if (En) {
+    Val |= DW_PCIE_DBI_RO_WR_EN;
+  } else {
+    Val &= ~DW_PCIE_DBI_RO_WR_EN;
+  }
+
+  K1PcieDbiWrite32 (Port, DW_PCIE_MISC_CONTROL_1_OFF, Val);
+}
+
+INT32
+GetLinkSpeed (
+  IN UINT32  Port
+  )
+{
+  return (K1PcieDbiRead32 (Port, PCIE_LINK_STATUS_REG) &
+          PCIE_LINK_STATUS_SPEED_MASK) >> PCIE_LINK_STATUS_SPEED_OFF;
+}
+
