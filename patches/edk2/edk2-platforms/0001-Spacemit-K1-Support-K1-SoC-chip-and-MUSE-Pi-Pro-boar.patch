index 0000000000..c81c5e09c8
--- /dev/null
+++ b/Silicon/Spacemit/K1/Drivers/UsbHcdInitDxe/UsbHcd.c
@@ -0,0 +1,470 @@
+/** @file
+
+  Copyright 2017, 2020 NXP
+  Copyright 2025, SpacemiT Co., Ltd. All rights reserved.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#include <Library/BaseLib.h>
+#include <Library/DebugLib.h>
+#include <Library/IoLib.h>
+#include <Library/NonDiscoverableDeviceRegistrationLib.h>
+#include <Library/TimerLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/MemoryManagementLib.h>
+
+#include "UsbHcd.h"
+#include "GpioLib.h"
+#include "UsbPhy.h"
+
+STATIC
+VOID
+Dwc3SetQuirk (
+  IN DWC3  *Dwc3Reg
+  )
+{
+  UINT32  ClearBits, SetBits;
+
+  ClearBits = 0;
+  /* snps,dis_u3_susphy_quirk */
+  ClearBits |= DWC3_GUSB3PIPECTL_SUSPHY;
+  /* snps,dis-del-phy-power-chg-quirk */
+  ClearBits |= DWC3_GUSB3PIPECTL_DEPOCHANGE;
+  MmioAnd32 ((UINTN)&Dwc3Reg->GUsb3PipeCtl[0], ~ClearBits);
+
+  ClearBits = 0;
+  /* snps,dis_enblslpm_quirk */
+  ClearBits |= DWC3_GUSB2PHYCFG_ENBLSLPM;
+  /* snps,dis_u2_susphy_quirk */
+  ClearBits |= DWC3_GUSB2PHYCFG_SUSPHY;
+  MmioAnd32 ((UINTN)&Dwc3Reg->GUsb2PhyCfg[0], ~ClearBits);
+
+  SetBits = 0;
+  /* snps,dis-tx-ipgap-linecheck-quirk */
+  SetBits |= DWC3_GUCTL1_TX_IPGAP_LINECHECK_DIS;
+  /* snps,parkmode-disable-ss-quirk */
+  SetBits |= DWC3_GUCTL1_PARKMODE_DISABLE_SS;
+  MmioOr32 ((UINTN)&Dwc3Reg->GUctl1, SetBits);
+}
+
+STATIC
+EFI_STATUS
+Dwc3CoreInit (
+  IN DWC3  *Dwc3Reg
+  )
+{
+  UINT32  Revision;
+  UINT32  Reg;
+  UINTN   Dwc3Hwparams1;
+
+  Revision = MmioRead32 ((UINTN)&Dwc3Reg->GSnpsId);
+  //
+  // This should read as 0x5533, ascii of U3(DWC_usb3) followed by revision num
+  //
+  if ((Revision & DWC3_GSNPSID_MASK) != DWC3_SYNOPSYS_ID) {
+    DEBUG (
+           (DEBUG_ERROR,
+            "This is not a DesignWare USB3 DRD Core, GSnpsId: %x.\n", Revision)
+           );
+    return EFI_NOT_FOUND;
+  }
+
+  Reg  = MmioRead32 ((UINTN)&Dwc3Reg->GCtl);
+  Reg &= ~DWC3_GCTL_SCALEDOWN_MASK;
+  Reg &= ~DWC3_GCTL_DISSCRAMBLE;
+
+  Dwc3Hwparams1 = MmioRead32 ((UINTN)&Dwc3Reg->GHwParams1);
+
+  if (DWC3_GHWPARAMS1_EN_PWROPT (Dwc3Hwparams1) ==
+      DWC3_GHWPARAMS1_EN_PWROPT_CLK)
+  {
+    Reg &= ~DWC3_GCTL_DSBLCLKGTNG;
+  } else {
+    DEBUG ((DEBUG_WARN, "No power optimization available.\n"));
+  }
+
+  if ((Revision & DWC3_RELEASE_MASK) < DWC3_RELEASE_190a) {
+    Reg |= DWC3_GCTL_U2RSTECN;
+  }
+
+  MmioWrite32 ((UINTN)&Dwc3Reg->GCtl, Reg);
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+VOID
+Dwc3SetMode (
+  IN DWC3    *Dwc3Reg,
+  IN UINT32  Mode
+  )
+{
+  MmioAndThenOr32 (
+                   (UINTN)&Dwc3Reg->GCtl,
+                   ~(DWC3_GCTL_PRTCAPDIR (DWC3_GCTL_PRTCAP_OTG)),
+                   DWC3_GCTL_PRTCAPDIR (Mode)
+                   );
+}
+
+STATIC
+EFI_STATUS
+XhciCoreInit (
+  IN UINTN  UsbReg
+  )
+{
+  EFI_STATUS  Status;
+  DWC3        *Dwc3Reg;
+
+  Dwc3Reg = (VOID *)(UsbReg + DWC3_REG_OFFSET);
+
+  /* UTMI 8 mode */
+  MmioAndThenOr32 (
+                   (UINTN)&Dwc3Reg->GUsb2PhyCfg[0],
+                   ~(DWC3_GUSB2PHYCFG_PHYIF_MASK | DWC3_GUSB2PHYCFG_USBTRDTIM_MASK),
+                   DWC3_GUSB2PHYCFG_PHYIF (UTMI_PHYIF_8_BIT) | DWC3_GUSB2PHYCFG_USBTRDTIM (USBTRDTIM_UTMI_8_BIT)
+                   );
+
+  Dwc3SetQuirk (Dwc3Reg);
+
+  Status = Dwc3CoreInit (Dwc3Reg);
+  if (EFI_ERROR (Status)) {
+    DEBUG (
+           (DEBUG_ERROR, "Dwc3CoreInit Failed for controller 0x%x (0x%r) \n",
+            UsbReg, Status)
+           );
+
+    return Status;
+  }
+
+  Dwc3SetMode (Dwc3Reg, DWC3_GCTL_PRTCAP_HOST);
+
+  return Status;
+}
+
+STATIC
+EFI_STATUS
+MvUsbPhyEnable (
+  VOID  *PhyBase
+  )
+{
+  UINT32  Loop = 50 * 1000;
+  UINT32  Temp;
+
+  do {
+    Temp = MmioRead32 ((UINTN)PhyBase + USB2_PHY_REG01);
+    if (Temp & USB2_PHY_REG01_PLL_IS_READY) {
+      break;
+    }
+
+    MicroSecondDelay (50);
+  } while (--Loop);
+
+  if (Loop == 0) {
+    DEBUG ((DEBUG_ERROR, "%a: Wait PHY_REG01[PLLREADY] timeout\n", __func__));
+    return EFI_DEVICE_ERROR;
+  }
+
+  /* release usb2 phy internal reset and enable clock gating */
+  MmioWrite32 ((UINTN)PhyBase + USB2_PHY_REG01, 0x60ef);
+  MmioWrite32 ((UINTN)PhyBase + USB2_PHY_REG0D, 0x1c);
+
+  MmioAndThenOr32 (
+                   (UINTN)PhyBase + USB2_ANALOG_REG14_13,
+                   ~(USB2_ANALOG_HSDAC_ISEL_MASK),
+                   (USB2_ANALOG_HSDAC_ISEL_15_INC | USB2_ANALOG_HSDAC_IREG_EN)
+                   );
+
+  /* auto clear host disc*/
+  MmioOr32 ((UINTN)PhyBase + USB2_PHY_REG04, USB2_PHY_REG04_AUTO_CLEAR_DIS);
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+Usb3PhyEnable (
+  VOID  *PhyBase
+  )
+{
+  UINT32  Temp;
+
+  // Write initial values to registers
+  MmioWrite32 (
+               (UINTN)PhyBase + SPACEMIT_COMBPHY_USB_REG1,
+               SPACEMIT_COMBPHY_USB_REG1_VAL
+               );
+  Temp = MmioRead32 ((UINTN)PhyBase + SPACEMIT_COMBPHY_USB_REG2);
+
+  MmioWrite32 (
+               (UINTN)PhyBase + SPACEMIT_COMBPHY_USB_REG2,
+               SPACEMIT_COMBPHY_USB_REG2_VAL
+               );
+
+  MmioWrite32 (
+               (UINTN)PhyBase + SPACEMIT_COMBPHY_USB_REG3,
+               SPACEMIT_COMBPHY_USB_REG3_VAL
+               );
+  MmioWrite32 (
+               (UINTN)PhyBase + SPACEMIT_COMBPHY_USB_REG4,
+               SPACEMIT_COMBPHY_USB_REG4_VAL
+               );
+
+  /* Wait for PLL to be ready */
+  UINT32  Loops = 50 * SPACEMIT_COMBPHY_WAIT_TIMEOUT;
+
+  do {
+    Temp = MmioRead32 ((UINTN)PhyBase + SPACEMIT_COMBPHY_USB_PLL_REG);
+    if ((Temp & SPACEMIT_COMBPHY_USB_PLL_MASK) ==
+        SPACEMIT_COMBPHY_USB_PLL_VAL)
+    {
+      break;
+    }
+
+    MicroSecondDelay (50);
+  } while (--Loops);
+
+  if (Loops == 0) {
+    DEBUG ((DEBUG_ERROR, "%a: USB3 PHY PLL init timeout!\n", __func__));
+    return EFI_TIMEOUT;
+  }
+
+  /* Update LFPS threshold */
+  MmioAndThenOr32 ((UINTN)PhyBase + 0x58, ~(0x7 << 8), (0x3 << 8));
+
+  return EFI_SUCCESS;
+}
+
+VOID
+UsbGpioEnable (
+  VOID
+  )
+{
+  UINT8            Port, I;
+  GPIO_Pin_Config  config[][3] = {
+    // TODO: Only Support MUSE-Pi, MUSE-Pi2 with this config.
+    {
+      { 127, GPIO_127,   MUX_MODE0 },
+      { 123, GPIO_123,   MUX_MODE0 },
+      { 79,  PINID (79), MUX_MODE0 },
+    },
+  };
+
+  GpioEnableConfig (config, Port, I);
+}
+
+EFIAPI
+EFI_STATUS
+InitializeXhciController (
+  IN NON_DISCOVERABLE_DEVICE  *This
+  )
+{
+  EFI_STATUS            Status;
+  EFI_PHYSICAL_ADDRESS  UsbReg = This->Resources->AddrRangeMin;
+
+  DEBUG ((DEBUG_ERROR, "XHCI: Initialize DWC3 at 0x%lX\n", UsbReg));
+
+  Status = XhciCoreInit (UsbReg);
+
+  if (EFI_ERROR (Status)) {
+    DEBUG (
+           (DEBUG_ERROR,
+            "XHCI: Controller init Failed for 0x%lX (0x%r)\n", UsbReg, Status)
+           );
+    return EFI_DEVICE_ERROR;
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+VOID
+RegisterXhc (
+  UINT64  XhciControllerAddr
+  )
+{
+  EFI_STATUS  Status;
+
+  Status = RegisterNonDiscoverableMmioDevice (
+                                              NonDiscoverableDeviceTypeXhci,
+                                              NonDiscoverableDeviceDmaTypeNonCoherent,
+                                              InitializeXhciController,
+                                              NULL,
+                                              1,
+                                              XhciControllerAddr,
+                                              DWC3_XHCI_REGS_SIZE
+                                              );
+  if (EFI_ERROR (Status)) {
+    DEBUG (
+           (DEBUG_ERROR, "Failed to register EHCI device 0x%x, error 0x%r \n",
+            XhciControllerAddr, Status)
+           );
+  }
+}
+
+STATIC
+VOID
+RegisterEhc (
+  UINT64  EhciControllerAddr
+  )
+{
+  EFI_STATUS  Status;
+
+  Status = RegisterNonDiscoverableMmioDevice (
+                                              NonDiscoverableDeviceTypeEhci,
+                                              NonDiscoverableDeviceDmaTypeNonCoherent,
+                                              NULL,
+                                              NULL,
+                                              1,
+                                              EhciControllerAddr,
+                                              MV_EHCI_REGS_SIZE
+                                              );
+  if (EFI_ERROR (Status)) {
+    DEBUG (
+           (DEBUG_ERROR, "Failed to register EHCI device 0x%x, error 0x%r \n",
+            EhciControllerAddr, Status)
+           );
+  }
+}
+
+/**
+  This function gets registered as a callback to perform USB controller
+intialization
+
+  @param  Event         Event whose notification function is being invoked.
+  @param  Context       Pointer to the notification function's context.
+
+**/
+VOID EFIAPI
+UsbEndOfDxeCallback (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  UINT64      XhciControllerAddr;
+  UINT64      Ehci0ControllerAddr, Ehci1ControllerAddr;
+  BOOLEAN     Usb0Enabled, Usb1Enabled, Usb2Enabled, Usb3Enabled;
+  EFI_STATUS  Status;
+
+  gBS->CloseEvent (Event);
+
+  Ehci0ControllerAddr = PcdGet64 (PcdUsb0BaseAddr);
+  Ehci1ControllerAddr = PcdGet64 (PcdUsb1BaseAddr);
+  XhciControllerAddr  = PcdGet64 (PcdUsb3BaseAddr);
+  Usb0Enabled         = PcdGetBool (PcdUsb0Enable);
+  Usb1Enabled         = PcdGetBool (PcdUsb1Enable);
+  Usb2Enabled         = PcdGetBool (PcdUsb2Enable);
+  Usb3Enabled         = PcdGetBool (PcdUsb3Enable);
+
+  MapRegToGcdMmioSpace (K1_MFPR_BASE, SIZE_4KB);
+  MapRegToGcdMmioSpace (K1_APMU_BASE, SIZE_4KB);
+  MapRegToGcdMmioSpace (K1_MPMU_BASE, SIZE_4KB);
+  MapRegToGcdMmioSpace (K1X_GPIO_BASE, SIZE_4KB);
+
+  MapRegToGcdMmioSpace (PcdGet64 (PcdUsb0PhyBaseAddr), SIZE_4KB);
+  MapRegToGcdMmioSpace (PcdGet64 (PcdUsb1PhyBaseAddr), SIZE_4KB);
+  MapRegToGcdMmioSpace (PcdGet64 (PcdUsb2PhyBaseAddr), SIZE_4KB);
+  MapRegToGcdMmioSpace (PcdGet64 (PcdUsb3PhyBaseAddr), SIZE_4KB);
+  MapRegToGcdMmioSpace (PcdGet64 (PcdCombPhySelAddr) & ~(0xFFF), SIZE_4KB);
+
+  MapRegToGcdMmioSpace (XhciControllerAddr, SIZE_64KB);
+  MapRegToGcdMmioSpace (Ehci0ControllerAddr, SIZE_64KB);
+  MapRegToGcdMmioSpace (Ehci1ControllerAddr, SIZE_64KB);
+
+  //
+  // Resets and clocks
+  //
+
+  if (Usb0Enabled) {
+    MmioOr32 (K1X_APMU_BASE + 0x5c, BIT1);
+    MicroSecondDelay (10);
+    MmioOr32 (K1X_APMU_BASE + 0x5c, BIT0);
+
+    Status = MvUsbPhyEnable ((VOID *)PcdGet64 (PcdUsb1PhyBaseAddr));
+    if (Status != EFI_SUCCESS) {
+      return;
+    }
+
+    RegisterEhc (Ehci0ControllerAddr);
+  }
+
+  if (Usb1Enabled) {
+    MmioOr32 (K1X_APMU_BASE + 0x5c, BIT5);
+    MicroSecondDelay (10);
+    MmioOr32 (K1X_APMU_BASE + 0x5c, BIT4);
+
+    Status = MvUsbPhyEnable ((VOID *)PcdGet64 (PcdUsb1PhyBaseAddr));
+    if (Status != EFI_SUCCESS) {
+      return;
+    }
+
+    RegisterEhc (Ehci1ControllerAddr);
+  }
+
+  if (Usb2Enabled || Usb3Enabled) {
+    /* USB3 Clk, Rst */
+    MmioOr32 (K1X_APMU_BASE + 0x5c, BIT8);
+    // MmioAnd32(K1X_APMU_BASE + 0x5c, ~(BIT9 | BIT10 | BIT11));
+    MicroSecondDelay (10);
+    MmioOr32 (K1X_APMU_BASE + 0x5c, (BIT9 | BIT10 | BIT11));
+
+    if (Usb3Enabled) {
+      /* Set Pipe3 Combphy to USB3 mode */
+      // MmioAnd32((UINTN)PcdGet64(PcdCombPhySelAddr), ~SPACEMIT_COMBPHY_MODE_SEL);
+      MmioOr32 ((UINTN)PcdGet64 (PcdCombPhySelAddr), SPACEMIT_COMBPHY_MODE_SEL);
+
+      /* USB3&PCIE0 Phy Shared Rst */
+      MmioAndThenOr32 (K1X_APMU_BASE + 0x3cc, BIT3 | BIT4 | BIT5, BIT8);
+      MmioAndThenOr32 (K1X_APMU_BASE + 0x3cc, ~BIT8, BIT3 | BIT4 | BIT5);
+
+      /* Enable USB PHYs */
+      Status = Usb3PhyEnable ((VOID *)PcdGet64 (PcdUsb3PhyBaseAddr));
+      if (Status != EFI_SUCCESS) {
+        return;
+      }
+    }
+
+    Status = MvUsbPhyEnable ((VOID *)PcdGet64 (PcdUsb2PhyBaseAddr));
+    if (Status != EFI_SUCCESS) {
+      return;
+    }
+
+    RegisterXhc (XhciControllerAddr);
+  }
+
+  UsbGpioEnable ();
+}
+
+/**
+  The Entry Point of module. It follows the standard UEFI driver model.
+
+  @param[in] ImageHandle   The firmware allocated handle for the EFI image.
+  @param[in] SystemTable   A pointer to the EFI System Table.
+
+  @retval EFI_SUCCESS      The entry point is executed successfully.
+  @retval other            Some error occurs when executing this entry point.
+
+**/
+EFI_STATUS
+EFIAPI
+InitializeUsbHcd (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS  Status;
+  EFI_EVENT   EndOfDxeEvent;
+
+  Status =
+    gBS->CreateEventEx (
+                        EVT_NOTIFY_SIGNAL,
+                        TPL_CALLBACK,
+                        UsbEndOfDxeCallback,
+                        NULL,
+                        &gEfiEndOfDxeEventGroupGuid,
+                        &EndOfDxeEvent
+                        );
+
+  return Status;
+}
diff --git a/Silicon/Spacemit/K1/Drivers/UsbHcdInitDxe/UsbHcd.h b/Silicon/Spacemit/K1/Drivers/UsbHcdInitDxe/UsbHcd.h
new file mode 100644
index 0000000000..40b4ae8fd4
--- /dev/null
+++ b/Silicon/Spacemit/K1/Drivers/UsbHcdInitDxe/UsbHcd.h
@@ -0,0 +1,201 @@
+/** @file
+
+  Copyright 2017, 2020 NXP
+  Copyright 2025, SpacemiT Co., Ltd. All rights reserved.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#ifndef USB_HCD_H_
+#define USB_HCD_H_
+
+#include <Base.h>
+
+#define K1X_APMU_BASE  (FixedPcdGet64(PcdSpacemitAPMURegBase))
+#define K1X_MPMU_BASE  (FixedPcdGet64(PcdSpacemitMPMURegBase))
+#define K1X_MFPR_BASE  (FixedPcdGet64(PcdSpacemitMFPRRegBase))
+
+#define PMUA_USB_CLK_RES_CTRL                (K1X_APMU_BASE + 0x5c)
+#define PMUA_USB_CLK_RES_CTRL_USB_AXICLK_EN  (0x1 << 1)
+#define PMUA_USB_CLK_RES_CTRL_USB_AXI_RST    (0x1 << 0)
+
+/// MV EHCI
+#define MV_EHCI_REGS_SIZE  0x4000
+
+/// DWC3 XHCI
+
+/* Global constants */
+#define DWC3_GSNPSID_MASK    0xffff0000
+#define DWC3_SYNOPSYS_ID     0x55330000
+#define DWC3_RELEASE_MASK    0xffff
+#define DWC3_REG_OFFSET      0xC100
+#define DWC3_RELEASE_190a    0x190a
+#define DWC3_RELEASE_330a    0x330a
+#define DWC3_XHCI_REGS_SIZE  0x8000
+
+/* Global Configuration Register */
+#define DWC3_GCTL_U2RSTECN  BIT16
+#define DWC3_GCTL_PRTCAPDIR(N)  ((N) << 12)
+#define DWC3_GCTL_PRTCAP_HOST    1
+#define DWC3_GCTL_PRTCAP_OTG     3
+#define DWC3_GCTL_CORESOFTRESET  BIT11
+#define DWC3_GCTL_SCALEDOWN(N)  ((N) << 4)
+#define DWC3_GCTL_SCALEDOWN_MASK  DWC3_GCTL_SCALEDOWN(3)
+#define DWC3_GCTL_DISSCRAMBLE     BIT3
+#define DWC3_GCTL_DSBLCLKGTNG     BIT0
+
+/* Global HWPARAMS1 Register */
+#define DWC3_GHWPARAMS1_EN_PWROPT(N)  (((N) & (3 << 24)) >> 24)
+#define DWC3_GHWPARAMS1_EN_PWROPT_CLK  1
+
+/* Global UCTL1 Register */
+#define DWC3_GUCTL1_DEV_DECOUPLE_L1L2_EVT        BIT31
+#define DWC3_GUCTL1_TX_IPGAP_LINECHECK_DIS       BIT28
+#define DWC3_GUCTL1_DEV_FORCE_20_CLK_FOR_30_CLK  BIT26
+#define DWC3_GUCTL1_DEV_L1_EXIT_BY_HW            BIT24
+#define DWC3_GUCTL1_PARKMODE_DISABLE_SS          BIT17
+#define DWC3_GUCTL1_PARKMODE_DISABLE_HS          BIT16
+#define DWC3_GUCTL2_RST_ACTBITLATER              BIT14
+#define DWC3_GUCTL1_RESUME_OPMODE_HS_HOST        BIT10
+
+/* Global USB2 PHY Configuration Register */
+#define DWC3_GUSB2PHYCFG_PHYSOFTRST         BIT31
+#define DWC3_GUSB2PHYCFG_U2_FREECLK_EXISTS  BIT30
+#define DWC3_GUSB2PHYCFG_USBTRDTIM(N)  (((N) & 0xf) << 10)
+#define DWC3_GUSB2PHYCFG_USBTRDTIM_MASK  DWC3_GUSB2PHYCFG_USBTRDTIM(0xf)
+#define DWC3_GUSB2PHYCFG_SUSPHY          BIT6
+#define DWC3_GUSB2PHYCFG_ENBLSLPM        BIT0
+#define DWC3_GUSB2PHYCFG_PHYIF(n)  ((n) << 3)
+#define DWC3_GUSB2PHYCFG_PHYIF_MASK      DWC3_GUSB2PHYCFG_PHYIF(1)
+#define DWC3_GUSB2PHYCFG_USBTRDTIM_MASK  DWC3_GUSB2PHYCFG_USBTRDTIM(0xf)
+#define USBTRDTIM_UTMI_8_BIT             9
+#define USBTRDTIM_UTMI_16_BIT            5
+#define UTMI_PHYIF_16_BIT                1
+#define UTMI_PHYIF_8_BIT                 0
+
+/* Global USB3 PIPE Control Register */
+#define DWC3_GUSB3PIPECTL_PHYSOFTRST    BIT31
+#define DWC3_GUSB3PIPECTL_U2SSINP3OK    BIT29
+#define DWC3_GUSB3PIPECTL_DISRXDETINP3  BIT28
+#define DWC3_GUSB3PIPECTL_UX_EXIT_PX    BIT27
+#define DWC3_GUSB3PIPECTL_REQP1P2P3     BIT24
+#define DWC3_GUSB3PIPECTL_DEP1P2P3(n)  ((n) << 19)
+#define DWC3_GUSB3PIPECTL_DEP1P2P3_MASK  DWC3_GUSB3PIPECTL_DEP1P2P3(7)
+#define DWC3_GUSB3PIPECTL_DEP1P2P3_EN    DWC3_GUSB3PIPECTL_DEP1P2P3(1)
+#define DWC3_GUSB3PIPECTL_DEPOCHANGE     BIT18
