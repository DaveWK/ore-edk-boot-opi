+#define SDHC_STATE_INT_B                BIT10   //INT_B,bit10
+#define SDHC_STATE_INT_C                BIT11   //INT_C,bit11
+#define SDHC_STATE_RETUNINIG_INT        BIT12   //Re_tuning Event,bit12
