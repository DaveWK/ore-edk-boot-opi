+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN UINT32                        Clk,
+  IN UINT32                        Width,
+  IN UINT32                        TimingMode);
+
+/**
+  Prepare the SD card for data transfer.
