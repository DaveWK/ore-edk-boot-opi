+#define SDHC_CLOCK_FREQUENCY_25MHZ      (25 * 1000 * 1000)
+#define SDHC_CLOCK_FREQUENCY_12_5MH     (12500 * 1000)
+#define SDHC_CLOCK_FREQUENCY_6MHZ       (6 * 1000 * 1000)
