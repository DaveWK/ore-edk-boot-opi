diff --git a/Silicon/Spacemit/Override/MdeModulePkg/Bus/Pci/PciBusDxe/PciRomTable.c b/Silicon/Spacemit/Override/MdeModulePkg/Bus/Pci/PciBusDxe/PciRomTable.c
