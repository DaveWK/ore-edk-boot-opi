+++ b/Silicon/Spacemit/K1/Drivers/SdHostDxe/SdHostDxe.c
@@ -0,0 +1,468 @@
+/** @file
+  This file implements the SD host controller driver for UEFI systems.
+  The file contains the implementation of the EFI_MMC_HOST_PROTOCOL, which provides
+  the necessary interfaces for handling communication and data transfer with SD cards.
+
+  Copyright (c) 2017, Andrei Warkentin <andrey.warkentin@gmail.com>
+  Copyright (c) Microsoft Corporation. All rights reserved.
+  Copyright (c) 2023, Academy of Intelligent Innovation, Shandong Universiy, China.P.R. All rights reserved.<BR>
+  Copyright (c) 2024, Spacemit. All rights reserved.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#include <Uefi.h>
+#include <Library/BaseLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/DebugLib.h>
+#include <Library/DevicePathLib.h>
+#include <Library/IoLib.h>
+#include <Library/PcdLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/TimerLib.h>
+
+#include <Protocol/BlockIo.h>
+#include <Protocol/DevicePath.h>
+
+#include "SdHci.h"
+#include "MmcHostPcdConfig.h"
+
+/**
+  Check if the SD card is read-only.
+
+  @param[in] This      Pointer to the EFI_MMC_HOST_PROTOCOL instance.
+
+  @retval FALSE        The SD card is not read-only.
+
+**/
+STATIC
+BOOLEAN
+SdIsReadOnly (
+  IN EFI_MMC_HOST_PROTOCOL  *This
+  )
+{
+  return FALSE;
+}
+
+/**
+  Build the device path for the SD card.
+
+  @param[in]  This           Pointer to the EFI_MMC_HOST_PROTOCOL instance.
+  @param[out] DevicePath     Pointer to the location to store the newly created device path.
+
+  @retval EFI_SUCCESS        The device path is built successfully.
+
+**/
+STATIC
+EFI_STATUS
+SdBuildDevicePath (
+  IN  EFI_MMC_HOST_PROTOCOL     *This,
+  OUT EFI_DEVICE_PATH_PROTOCOL  **DevicePath
+  )
+{
+  EFI_DEVICE_PATH_PROTOCOL      *NewDevicePathNode;
+  EFI_GUID                      DevicePathGuid = EFI_CALLER_ID_GUID;
+  MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance = MMCHC_INSTANCE_FROM_THIS (This);
+
+  DEBUG ((DEBUG_VERBOSE, "SdHost: SdBuildDevicePath ()\n"));
+
+  if (MmcHcInstance->BmParams.IsEmmc) {
+    NewDevicePathNode = CreateDeviceNode (MESSAGING_DEVICE_PATH, MSG_EMMC_DP, sizeof (EMMC_DEVICE_PATH));
+    CopyGuid (&((VENDOR_DEVICE_PATH *)NewDevicePathNode)->Guid, &DevicePathGuid);
+  } else {
+    NewDevicePathNode = CreateDeviceNode (MESSAGING_DEVICE_PATH, MSG_SD_DP, sizeof (SD_DEVICE_PATH));
+    CopyGuid (&((VENDOR_DEVICE_PATH *)NewDevicePathNode)->Guid, &DevicePathGuid);
+  }
+
+  *DevicePath = NewDevicePathNode;
+
+  return EFI_SUCCESS;
+}
+
+/**
+  Send a command to the SD card.
+
+  @param[in] This       Pointer to the EFI_MMC_HOST_PROTOCOL instance.
+  @param[in] MmcCmd     The MMC command to send.
+  @param[in] Argument   The argument for the command.
+  @param[in] Type       The type of response expected.
+  @param[in] Buffer     Pointer to the buffer to store the response.
+
+  @retval EFI_SUCCESS   The command was sent successfully and the response was retrieved.
+  @retval Other         An error occurred while sending a command.
+**/
+STATIC
+EFI_STATUS
+SdSendCommand (
+  IN EFI_MMC_HOST_PROTOCOL  *This,
+  IN MMC_CMD                MmcCmd,
+  IN UINT32                 Argument
+  )
+{
+  EFI_STATUS                    Status;
+  MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance = MMCHC_INSTANCE_FROM_THIS (This);
+
+  Status = BmSdSendCmd (MmcHcInstance, MmcCmd, Argument);
+
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "SdSendCommand %d Error, Status=%r.\n", MMC_GET_INDX (MmcCmd), Status));
+    return Status;
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC EFI_STATUS
+SdReceiveResponse (
+  IN EFI_MMC_HOST_PROTOCOL  *This,
+  IN MMC_RESPONSE_TYPE      Type,
+  IN UINT32                 *Buffer
+  )
+{
+  MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance = MMCHC_INSTANCE_FROM_THIS (This);
+
+  return BmSdReceiveResponse (MmcHcInstance, Type, Buffer);
+}
+
+/**
+  Read block data from an SD card.
+
+  @param[in] This       Pointer to the EFI_MMC_HOST_PROTOCOL instance.
+  @param[in] Lba        Logical Block Address of the starting block to read.
+  @param[in] Length     Number of blocks to read.
+  @param[in] Buffer     Pointer to the buffer to store the read data.
+
+  @retval EFI_SUCCESS   The operation completed successfully.
+  @retval Other         The operation failed.
+
+**/
+STATIC
+EFI_STATUS
+SdReadBlockData (
+  IN  EFI_MMC_HOST_PROTOCOL  *This,
+  IN  EFI_LBA                Lba,
+  IN  UINTN                  Length,
+  OUT UINT32                 *Buffer
+  )
+{
+  EFI_STATUS                    Status;
+  MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance = MMCHC_INSTANCE_FROM_THIS (This);
+
+  ASSERT (Buffer != NULL);
+  ASSERT (Length % 4 == 0);
+
+  Status = BmSdRead (MmcHcInstance, Lba, Buffer, Length);
+
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "SdReadBlockData Error, Status=%r.\n", Status));
+    return Status;
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+  Write block data to an SD card.
+
+  @param[in] This       Pointer to the EFI_MMC_HOST_PROTOCOL instance.
+  @param[in] Lba        Logical Block Address of the starting block to write.
+  @param[in] Length     Number of blocks to write.
+  @param[in] Buffer     Pointer to the buffer containing the data to be written.
+
+  @retval EFI_SUCCESS   The operation completed successfully.
+  @retval Other         The operation failed.
+
+**/
+STATIC
+EFI_STATUS
+SdWriteBlockData (
+  IN EFI_MMC_HOST_PROTOCOL  *This,
+  IN EFI_LBA                Lba,
+  IN UINTN                  Length,
+  IN UINT32                 *Buffer
+  )
+{
+  EFI_STATUS                    Status;
+  MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance = MMCHC_INSTANCE_FROM_THIS (This);
+
+  ASSERT (Buffer != NULL);
+  ASSERT (Length % MMC_BLOCK_SIZE == 0);
+
+  Status = BmSdWrite (MmcHcInstance, Lba, Buffer, Length);
+
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "SdWriteBlockData Error, Status=%r.\n", Status));
+    return Status;
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+  Set the I/O settings for an SD card.
+
+  @param[in]  This           Pointer to the EFI_MMC_HOST_PROTOCOL instance.
+  @param[in]  BusClockFreq   Bus clock frequency in Hz.
+  @param[in]  BusWidth       Bus width setting.
+  @param[in]  TimingMode     Timing mode, HS200, HS400...
+
+  @retval EFI_SUCCESS        The operation completed successfully.
+  @retval Other              The operation failed.
+
+**/
+STATIC
+EFI_STATUS
+SdSetIos (
+  IN EFI_MMC_HOST_PROTOCOL  *This,
+  IN  UINT32                BusClockFreq,
+  IN  UINT32                BusWidth,
+  IN  UINT32                TimingMode
+  )
+{
+  EFI_STATUS                    Status;
+  MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance = MMCHC_INSTANCE_FROM_THIS (This);
+
+  DEBUG ((DEBUG_INFO, "%a: Setting Freq %u Hz\n", __func__, BusClockFreq));
+  DEBUG ((DEBUG_INFO, "%a: Setting BusWidth %u\n", __func__, BusWidth));
+
+  Status = BmSdSetIos (MmcHcInstance, BusClockFreq, BusWidth, TimingMode);
+
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "SdSetIos Error, Status=%r.\n", Status));
+    return Status;
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+  Notify the state of the SD card.
+
+  @param[in]  This    Pointer to the EFI_MMC_HOST_PROTOCOL instance.
+  @param[in]  State   State of the SD card.
+
+  @retval EFI_SUCCESS       The operation completed successfully.
+  @retval EFI_NOT_READY     The card detection has not completed yet.
+  @retval Other             The operation failed.
+
+**/
+STATIC
+EFI_STATUS
+SdNotifyState (
+  IN EFI_MMC_HOST_PROTOCOL  *This,
+  IN MMC_STATE              State
+  )
+{
+  MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance = MMCHC_INSTANCE_FROM_THIS (This);
+
+  // Stall all operations except init until card detection has occurred.
+  if ((State != MmcHwInitializationState) && (MmcHcInstance->BmParams.CardDetectState != CardDetectCompleted)) {
+    return EFI_NOT_READY;
+  }
+
+  switch (State) {
+    case MmcHwInitializationState:
+      DEBUG ((DEBUG_VERBOSE, "MmcHwInitializationState\n", State));
+
+      EFI_STATUS  Status = SdInit (MmcHcInstance);
+      if (EFI_ERROR (Status)) {
+        DEBUG ((DEBUG_ERROR, "SdHost: SdNotifyState(): Fail to initialize!\n"));
+        return Status;
+      }
+
+      break;
+    case MmcIdleState:
+      DEBUG ((DEBUG_VERBOSE, "MmcIdleState\n", State));
+      break;
+    case MmcReadyState:
+      DEBUG ((DEBUG_VERBOSE, "MmcReadyState\n", State));
+      break;
+    case MmcIdentificationState:
+      DEBUG ((DEBUG_VERBOSE, "MmcIdentificationState\n", State));
+      break;
+    case MmcStandByState:
+      DEBUG ((DEBUG_VERBOSE, "MmcStandByState\n", State));
+      break;
+    case MmcTransferState:
+      DEBUG ((DEBUG_VERBOSE, "MmcTransferState\n", State));
+      break;
+    case MmcSendingDataState:
+      DEBUG ((DEBUG_VERBOSE, "MmcSendingDataState\n", State));
+      break;
+    case MmcReceiveDataState:
+      DEBUG ((DEBUG_VERBOSE, "MmcReceiveDataState\n", State));
+      break;
+    case MmcProgrammingState:
+      DEBUG ((DEBUG_VERBOSE, "MmcProgrammingState\n", State));
+      break;
+    case MmcDisconnectState:
+    case MmcInvalidState:
+    default:
+      DEBUG ((DEBUG_ERROR, "SdHost: SdNotifyState(): Invalid State: %d\n", State));
+      ASSERT (0);
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+  Check if an SD card is present.
+
+  @param[in]  This    Pointer to the EFI_MMC_HOST_PROTOCOL instance.
+
+  @retval TRUE        An SD card is present.
+  @retval FALSE       No SD card is present.
+
+**/
+STATIC
+BOOLEAN
+SdIsCardPresent (
+  IN EFI_MMC_HOST_PROTOCOL  *This
+  )
+{
+  MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance = MMCHC_INSTANCE_FROM_THIS (This);
+
+  //
+  // If we are already in progress (we may get concurrent calls)
+  // or completed the detection, just return the current value.
+  //
+  //   if (MmcHcInstance->BmParams.CardDetectState != CardDetectRequired) {
+  //     return MmcHcInstance->BmParams.CardIsPresent;
+  //   }
+
+  MmcHcInstance->BmParams.CardDetectState = CardDetectInProgress;
+  MmcHcInstance->BmParams.CardIsPresent   = FALSE;
+
+  if (SDCARD_STATUS_INSERTED == BmSdCardDetect (MmcHcInstance)) {
+    MmcHcInstance->BmParams.CardIsPresent   = TRUE;
+    MmcHcInstance->BmParams.CardDetectState = CardDetectCompleted;
+    return MmcHcInstance->BmParams.CardIsPresent;
+  } else {
+    DEBUG ((DEBUG_VERBOSE, "SdIsCardPresent: Error SdCardDetect.\n"));
+    MmcHcInstance->BmParams.CardDetectState = CardDetectRequired;
+    return FALSE;
+  }
+}
+
+/**
+  Check if the SD card supports multi-block transfers.
+
+  @param[in]  This     Pointer to the EFI_MMC_HOST_PROTOCOL instance.
+
+  @retval TRUE         The SD card supports multi-block transfers.
+
+**/
+BOOLEAN
+SdIsMultiBlock (
+  IN EFI_MMC_HOST_PROTOCOL  *This
+  )
+{
+  MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance = MMCHC_INSTANCE_FROM_THIS (This);
+
+  return MmcHcInstance->BmParams.IsMultiBlock;
+}
+
+EFI_MMC_HOST_PROTOCOL  gMmcHost = {
+  MMC_HOST_PROTOCOL_REVISION,
+  SdIsCardPresent,
+  SdIsReadOnly,
+  SdBuildDevicePath,
+  SdNotifyState,
+  SdSendCommand,
+  SdReceiveResponse,
+  SdReadBlockData,
+  SdWriteBlockData,
+  SdSetIos,
+  SdIsMultiBlock
+};
+
+/**
+  Initialize the SD host.
+
+  @param[in]  ImageHandle    The image handle.
+  @param[in]  SystemTable    The system table.
+
+  @retval EFI_SUCCESS        The operation completed successfully.
+  @retval Other              The operation failed.
+**/
+EFI_STATUS
+SdHostInitialize (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS                        Status;
+  MMC_HOST_CONTROLLER_INSTANCE      *MmcHcInstance;
+  MMC_HOST_CONTROLLER_CONFIG_ARRAY  *MmcHostConfigs;
+  INTN                              I;
+
+  // Get mmc Host controller configuration from PCD
+  MmcHostConfigs = (MMC_HOST_CONTROLLER_CONFIG_ARRAY *)PcdGetPtr (PcdMmcHostConfigs);
+
+  for (I = 0; I < MmcHostConfigs->Num; I++) {
+    DEBUG ((DEBUG_INFO, "MmcHost(%d): Initialize\n", I));
+
+    MmcHcInstance = AllocateZeroPool (sizeof (MMC_HOST_CONTROLLER_INSTANCE));
+    if (MmcHcInstance == NULL) {
+      return EFI_OUT_OF_RESOURCES;
+    }
+
+    MmcHcInstance->Signature = MMCHC_SIGNATURE;
+    CopyMem (&MmcHcInstance->MmcHost, &gMmcHost, sizeof (EFI_MMC_HOST_PROTOCOL));
+
+    MmcHcInstance->BmParams.RegBase         = MmcHostConfigs->Controller[I].RegBase;
+    MmcHcInstance->BmParams.ClkSource       = MmcHostConfigs->Controller[I].SourceClkMHz * 1000000;
+    MmcHcInstance->BmParams.BusWidth        = MmcHostConfigs->Controller[I].BusWidth;
+    MmcHcInstance->BmParams.IsEmmc          = MmcHostConfigs->Controller[I].IsEmmc;
+    MmcHcInstance->BmParams.IsMultiBlock    = !MmcHostConfigs->Controller[I].DisableMultiBlock;
+    MmcHcInstance->BmParams.CardIn          = SDCARD_STATUS_UNKNOWN;
+    MmcHcInstance->BmParams.CardIsPresent   = FALSE;
+    MmcHcInstance->BmParams.CardDetectState = CardDetectRequired;
+
+    if (MmcHostConfigs->Controller[I].PIOTransferMode) {
+      MmcHcInstance->BmParams.Flags = MMC_USE_PIO;
+    } else {
+      MmcHcInstance->BmParams.Flags = MMC_USE_DMA;
+    }
+
+    Status = gBS->InstallMultipleProtocolInterfaces (
+                                                     &MmcHcInstance->Handle,
+                                                     &gEmbeddedMmcHostProtocolGuid,
+                                                     &MmcHcInstance->MmcHost,
+                                                     NULL
+                                                     );
+    if (EFI_ERROR (Status)) {
+      DEBUG ((DEBUG_ERROR, "%a: Failed to install EmbeddedMmcHost protocols\n", __func__));
+      FreePool (MmcHcInstance);
+      continue;
+    }
+
+    if (!MmcHcInstance->BmParams.IsEmmc) {
+      MmcHcInstance->BmParams.DetectGpio  = MmcHostConfigs->Controller[I].DetectGpio;
+      MmcHcInstance->BmParams.PluginState = MmcHostConfigs->Controller[I].PluginState;
+
+      Status = gBS->LocateProtocol (
+                                    &gEmbeddedGpioProtocolGuid,
+                                    NULL,
+                                    (VOID **)&MmcHcInstance->Gpio
+                                    );
+
+      if (EFI_ERROR (Status)) {
+        Status = gBS->UninstallMultipleProtocolInterfaces (
+                                                           MmcHcInstance->Handle,
+                                                           &gEmbeddedMmcHostProtocolGuid,
+                                                           &MmcHcInstance->MmcHost,
+                                                           NULL
+                                                           );
+        FreePool (MmcHcInstance);
+        continue;
+      }
+
+      MmcHcInstance->Gpio->Set (MmcHcInstance->Gpio, MmcHcInstance->BmParams.DetectGpio, GPIO_MODE_INPUT);
+      MmcHcInstance->Gpio->SetPull (MmcHcInstance->Gpio, MmcHcInstance->BmParams.DetectGpio, GPIO_PULL_UP);
+    }
+  }
+
+  return Status;
+}
