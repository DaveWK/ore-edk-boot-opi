+// RIMT IOMMU Node Flags
+//  Bit[0]: IOMMU is a PCIe device
+#define EFI_ACPI_6_6_RIMT_IOMMU_NODE_FLAG_IS_PCIE_DEVICE        (1 << 0)
+#define EFI_ACPI_6_6_RIMT_IOMMU_NODE_FLAG_IS_PLATFORM_DEVICE    (0 << 0)
