index 0000000000..954e2a52ee
--- /dev/null
+++ b/Silicon/Spacemit/K1/Drivers/SdHostDxe/SdHci.c
@@ -0,0 +1,1159 @@
+/** @file
+  The implementation for handling SD card operations using the SD Host Controller Interface (SDHCI).
+
+  Copyright (c) 2016-2017, ARM Limited and Contributors. All rights reserved.
+  Copyright (c) 2023, Academy of Intelligent Innovation, Shandong Universiy, China.P.R. All rights reserved.<BR>
+  Copyright (c) 2024, Spacemit. All rights reserved.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#include <Uefi.h>
+#include <Base.h>
+#include <Library/BaseLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/DebugLib.h>
+#include <Library/IoLib.h>
+#include <Library/PcdLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/CacheMaintenanceLib.h>
+
+#include "SdHci.h"
+#include <Library/MemoryManagementLib.h>
+
+/**
+  Save commands, send command during next transfer stage.
+
+  @param    Cmd   Command sent to SD card.
+
+**/
+STATIC
+EFI_STATUS
+SdSaveMmcCmd (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN OUT _MMC_CMD                  *Cmd
+  )
+{
+  CopyMem (&MmcHcInstance->PreviousCmd, Cmd, sizeof (_MMC_CMD));
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+SdHcPollRegStatus (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN UINT32                        RegOffset,
+  IN UINT32                        Mask,
+  IN UINT32                        Value,
+  IN UINT32                        TimeoutMs
+  )
+{
+  UINTN   Base;
+  UINT32  TimeoutUs;
+
+  Base = MmcHcInstance->BmParams.RegBase;
+
+  TimeoutUs = TimeoutMs * 1000;
+  while (1) {
+    if (Value == (MmioRead32 (Base + RegOffset) & Mask)) {
+      break;
+    }
+
+    gBS->Stall (1);
+    if (!TimeoutUs--) {
+      DEBUG (
+             (DEBUG_ERROR,
+              "Timeout while poll SdHc 0x%x for Val 0x%x!\n", RegOffset, Value)
+             );
+      return EFI_TIMEOUT;
+    }
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+  SD card sends command with response block data.
+
+  @param    Cmd   Command sent to SD card.
+
+  @retval EFI_SUCCESS             The command with response block data was sent successfully.
+  @retval EFI_DEVICE_ERROR        There was an error during the command transmission or response handling.
+  @retval EFI_TIMEOUT             The command transmission or response handling timed out.
+
+**/
+STATIC
+EFI_STATUS
+SdHcCheckStatus (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN UINT32                        Mask
+  )
+{
+  UINTN   Base;
+  UINT32  Timeout, State;
+
+  Base = MmcHcInstance->BmParams.RegBase;
+
+  Timeout = 100000;
+  while (1) {
+    State = MmioRead32 (Base + SDHC_NORMAL_STATE);
+    if (State & SDHC_STATE_ERR_INT) {
+      DEBUG (
+             (
+              DEBUG_ERROR, "%a: interrupt error: 0x%x\n",
+              __func__, MmioRead32 (Base + SDHC_NORMAL_STATE))
+             );
+      return EFI_DEVICE_ERROR;
+    }
+
+    if (Mask == (State & Mask)) {
+      MmioWrite32 (Base + SDHC_NORMAL_STATE, Mask);
+      break;
+    }
+
+    gBS->Stall (1);
+    if (!Timeout--) {
+      DEBUG ((DEBUG_ERROR, "%a: Timeout while check status 0x%x!\n", __func__, Mask));
+      return EFI_TIMEOUT;
+    }
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+SdHcWaitData0Up (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance
+  )
+{
+  UINTN   Base;
+  UINT32  Timeout = 150000, State;
+
+  Base = MmcHcInstance->BmParams.RegBase;
+  while (1) {
+    // check data0
+    State = MmioRead32 (Base + SDHC_PRESENT_STATE);
+    if (State & SDHC_PRESENT_DATA0_LEVEL) {
+      break;
+    }
+
+    gBS->Stall (1);
+    if (!Timeout--) {
+      DEBUG ((DEBUG_INFO, "check DATA[0] pull up timeout: 0x%x\n", State));
+      return EFI_TIMEOUT;
+    }
+  }
+
+  return EFI_SUCCESS;
+}
+
+STATIC
+inline BOOLEAN
+IsAppCmd (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance
+  )
+{
+  return MmcHcInstance->PreviousCmd.CmdIdx == MMC_CMD55;
+}
+
+BOOLEAN
+IsBusyCmd (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN  UINT32                       MmcCmd
+  )
+{
+  if (IsAppCmd (MmcHcInstance)) {
+    return FALSE;
+  }
+
+  return MmcCmd == MMC_CMD7 || MmcCmd == MMC_CMD12;
+}
+
+STATIC
+BOOLEAN
+IsWriteCmd (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN  UINT32                       MmcCmd
+  )
+{
+  if (IsAppCmd (MmcHcInstance)) {
+    return FALSE;
+  }
+
+  return MmcCmd == MMC_CMD24 || MmcCmd == MMC_CMD25;
+}
+
+STATIC
+BOOLEAN
+IsReadCmd (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN  UINT32                       MmcCmd,
+  IN  UINT32                       Argument
+  )
+{
+  if ((MmcCmd == MMC_CMD8) && !IsAppCmd (MmcHcInstance)) {
+    if (CMD8_MMC_ARG == Argument) {
+      DEBUG ((DEBUG_VERBOSE, "Sending MMC CMD8 variant\n"));
+      return TRUE;
+    } else {
+      ASSERT (CMD8_SD_ARG == Argument);
+      DEBUG ((DEBUG_VERBOSE, "Sending SD CMD8 variant\n"));
+      return FALSE;
+    }
+  }
+
+  return
+    (MmcCmd == MMC_CMD17 && !IsAppCmd (MmcHcInstance)) ||
+    (MmcCmd == MMC_CMD18 && !IsAppCmd (MmcHcInstance)) ||
+    (MmcCmd == MMC_CMD13 && IsAppCmd (MmcHcInstance)) ||
+    (MmcCmd == MMC_ACMD22 && IsAppCmd (MmcHcInstance)) ||
+    (MmcCmd == MMC_ACMD51 && IsAppCmd (MmcHcInstance));
+}
+
+/**
+  SD card sends command with response block data.
+
+  @param    Cmd   Command sent to SD card.
+
+  @retval EFI_SUCCESS             The command with response block data was sent successfully.
+  @retval EFI_DEVICE_ERROR        There was an error during the command transmission or response handling.
+  @retval EFI_TIMEOUT             The command transmission or response handling timed out.
+
+**/
+STATIC
+EFI_STATUS
+SdSendCmdWithData (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN OUT _MMC_CMD                  *Cmd
+  )
+{
+  UINTN   Base;
+  UINT32  Mode;
+  UINT32  State;
+  UINT32  DmaAddr;
+  UINT32  Flags, Mask;
+  UINT32  Timeout;
+
+  Base  = MmcHcInstance->BmParams.RegBase;
+  Mode  = 0;
+  Flags = 0;
+
+  switch (Cmd->CmdIdx) {
+    case MMC_CMD18:
+      Mode |= SDHC_MODE_AUTO12_ENABLE | SDHC_MODE_MULTI_BLOCK;
+    case MMC_CMD17:
+    case MMC_CMD8:
+    case MMC_ACMD51:
+      Mode |= SDHC_MODE_BLKCNT_ENABLE | SDHC_MODE_DATA_READ;
+      break;
+
+    case MMC_CMD25:
+      Mode |= SDHC_MODE_AUTO12_ENABLE | SDHC_MODE_MULTI_BLOCK;
+    case MMC_CMD24:
+    case MMC_CMD16:
+      Mode |= SDHC_MODE_BLKCNT_ENABLE & ~SDHC_MODE_DATA_READ;
+      break;
+
+    default:
+      ASSERT (0);
+  }
+
+  if (!(MmcHcInstance->BmParams.Flags & MMC_USE_PIO)) {
+    Mode |= SDHC_MODE_DMA_ENABLE;
+  }
+
+  // make sure cmd and data line is clear
+  Mask = SDHC_PRESENT_CCMD_INHIBIT | SDHC_PRESENT_DCMD_INHIBIT;
+  if (EFI_SUCCESS != SdHcPollRegStatus (MmcHcInstance, SDHC_PRESENT_STATE, Mask, 0, 100)) {
+    return EFI_TIMEOUT;
+  }
+
+  // clean all interrupt bits
+  MmioWrite32 (Base + SDHC_NORMAL_STATE, 0xffffffff);
+  // MmioWrite16 (Base + SDHC_CMD_MODE, Mode);
+  MmioWrite32 (Base + SDHC_ARG, Cmd->CmdArg);
+
+  Flags  = SDHC_RES_TYPE_48BIT | SDHC_FLAG_CHECK_CRC | SDHC_FLAG_CHECK_INDEX;
+  Flags |= SDHC_FLAG_DATA_PRESENT;
+
+  // issue the Cmd
+  MmioWrite32 (Base + SDHC_CMD_MODE, SDHC_MAKE_CMD (MMC_GET_INDX (Cmd->CmdIdx), Flags, Mode));
+
+  if (!(MmcHcInstance->BmParams.Flags & MMC_USE_PIO)) {
+    // check cmd/data transfer complete
+    Timeout = 1000000;
+    while (1) {
+      State = MmioRead32 (Base + SDHC_NORMAL_STATE);
+      if (State & SDHC_STATE_ERR_INT) {
+        DEBUG ((DEBUG_ERROR, "%a: interrupt error: 0x%x\n", __func__, MmioRead32 (Base + SDHC_NORMAL_STATE)));
+        return EFI_DEVICE_ERROR;
+      }
+
+      if (State & SDHC_STATE_CMD_COMPLETE) {
+        MmioWrite32 (Base + SDHC_NORMAL_STATE, SDHC_STATE_CMD_COMPLETE);
+      }
+
+      if (State & SDHC_STATE_DMA_INT) {
+        DmaAddr = MmioRead32 (Base + SDHC_DMA_ADDR);
+        MmioWrite32 (Base + SDHC_DMA_ADDR, DmaAddr);
+        MmioWrite32 (Base + SDHC_NORMAL_STATE, SDHC_STATE_DMA_INT);
+      }
+
+      if (State & SDHC_STATE_XFER_COMPLETE) {
+        MmioWrite32 (Base + SDHC_NORMAL_STATE, SDHC_STATE_XFER_COMPLETE);
+        break;
+      }
+
+      gBS->Stall (1);
+      if (!Timeout--) {
+        DEBUG ((DEBUG_ERROR, "%a: Timeout!\n", __func__));
+        return EFI_TIMEOUT;
+      }
+    }
+  } else {
+    // check Cmd complete
+    return SdHcCheckStatus (MmcHcInstance, SDHC_STATE_CMD_COMPLETE);
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+  SD card sends command without response block data.
+
+  @param    Cmd   Command to by SD card.
+
+  @retval EFI_SUCCESS             The command without response block data was sent successfully.
+  @retval EFI_DEVICE_ERROR        There was an error during the command transmission or response handling.
+  @retval EFI_TIMEOUT             The command transmission or response handling timed out.
+
+**/
+STATIC
+EFI_STATUS
+SdSendCmdWithoutData (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN OUT _MMC_CMD                  *Cmd
+  )
+{
+  UINTN   Base;
+  UINT32  Flags, Mask;
+
+  Base  = MmcHcInstance->BmParams.RegBase;
+  Flags = 0x0;
+
+  if (Cmd->CmdIdx & MMC_CMD_LONG_RESPONSE) {
+    Flags |= SDHC_RES_TYPE_136BIT;
+  } else if (Cmd->CmdIdx & MMC_CMD_WAIT_RESPONSE) {
+    Flags |= SDHC_RES_TYPE_48BIT;
+  } else {
+    Flags |= SDHC_RES_TYPE_NONE;
+  }
+
+  if (0 == (Cmd->CmdIdx & MMC_CMD_NO_CRC_RESPONSE)) {
+    Flags |= SDHC_FLAG_CHECK_CRC;
+  }
+
+  if (MMC_CMD12 == Cmd->CmdIdx) {
+    Mask  = SDHC_PRESENT_CCMD_INHIBIT;
+    Flags = (Flags & (~SDHC_RES_TYPE)) | SDHC_RES_TYPE_NONE;
+  } else {
+    Mask = SDHC_PRESENT_CCMD_INHIBIT | SDHC_PRESENT_DCMD_INHIBIT;
+  }
+
+  // make sure cmd and data line is clear
+  if (EFI_SUCCESS != SdHcPollRegStatus (MmcHcInstance, SDHC_PRESENT_STATE, Mask, 0, 100)) {
+    return EFI_TIMEOUT;
+  }
+
+  // clean all error status
+  MmioWrite32 (Base + SDHC_NORMAL_STATE, 0xffffffff);
+  // issue the Cmd
+  MmioWrite32 (Base + SDHC_ARG, Cmd->CmdArg);
+  MmioWrite32 (Base + SDHC_CMD_MODE, SDHC_MAKE_CMD (MMC_GET_INDX (Cmd->CmdIdx), Flags, 0));
+
+  // check Cmd complete
+  return SdHcCheckStatus (MmcHcInstance, SDHC_STATE_CMD_COMPLETE);
+}
+
+/**
+  SD card sends command.
+
+  @param[in]  MmcCmd    Command ID and response type.
+  @param[in]  Arg       Command argument.
+
+  @retval  EFI_SUCCESS             The command was sent successfully.
+  @retval  EFI_DEVICE_ERROR        There was an error during the command transmission or response handling.
+  @retval  EFI_TIMEOUT             The command transmission or response handling timed out.
+
+**/
+EFI_STATUS
+EFIAPI
+BmSdSendCmd (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN  MMC_CMD                      MmcCmd,
+  IN  UINT32                       Arg
+  )
+{
+  EFI_STATUS  Status;
+  _MMC_CMD    Cmd;
+
+  DEBUG (
+         (DEBUG_VERBOSE, "%a: SDHC Cmd=%d, Arg=0x%x, ResponseType=0x%x\n",
+          __func__, MMC_GET_INDX (MmcCmd), Arg, MmcCmd >> 16)
+         );
+
+  ZeroMem (&Cmd, sizeof (_MMC_CMD));
+
+  Cmd.CmdIdx = MmcCmd;
+  Cmd.CmdArg = Arg;
+
+  // when read or write data, need set block count and size before send command
+  if (!IsReadCmd (MmcHcInstance, MmcCmd, Arg) && !IsWriteCmd (MmcHcInstance, MmcCmd)) {
+    Status = SdSendCmdWithoutData (MmcHcInstance, &Cmd);
+  }
+
+  SdSaveMmcCmd (MmcHcInstance, &Cmd);
+  return Status;
+}
+
+EFI_STATUS
+BmSdReceiveResponse (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN MMC_RESPONSE_TYPE             Type,
+  IN UINT32                        *Buffer
+  )
+{
+  UINTN  Base;
+
+  Base = MmcHcInstance->BmParams.RegBase;
+
+  if (Buffer == NULL) {
+    DEBUG ((DEBUG_ERROR, "SdHost: %a: Input Buffer is NULL\n", __func__));
+    return EFI_INVALID_PARAMETER;
+  }
+
+  if (Type == MMC_RESPONSE_TYPE_R1) {
+    Buffer[0] = MmioRead32 (Base + SDHC_RESP0);
+    DEBUG (
+           (DEBUG_VERBOSE, "SdHost: %a(Type: %x), Buffer[0]: %08x\n",
+            __func__, Type, Buffer[0])
+           );
+  } else {
+    Buffer[0] = MmioRead32 (Base + SDHC_RESP0);
+    Buffer[1] = MmioRead32 (Base + SDHC_RESP1);
+    Buffer[2] = MmioRead32 (Base + SDHC_RESP2);
+    Buffer[3] = MmioRead32 (Base + SDHC_RESP3);
+
+    DEBUG (
+           (DEBUG_VERBOSE,
+            "SdHost: %a(Type: %x), Buffer[0-3]: %08x, %08x, %08x, %08x\n",
+            __func__, Type, Buffer[0], Buffer[1], Buffer[2], Buffer[3])
+           );
+  }
+
+  return EFI_SUCCESS;
+}
+
+/**
+  Change clock frequency of SDHC.
+
+  @param[in] Clk       The clock frequency of SDHC.
+
+**/
+STATIC VOID
+SetSdhcBusClock (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN INT32                         Clk
+  )
+{
+  INT32   Div;
+  UINTN   Base;
+  UINT32  Value, Timeout;
+
+  // maintain precision by rounding
+  Div = (MmcHcInstance->BmParams.ClkSource + Clk) / (2 * Clk);
+  if (Div > SDCLK_FREQUENCY_SECLECT_MAX) {
+    Div = SDCLK_FREQUENCY_SECLECT_MAX;
+  }
+
+  Base = MmcHcInstance->BmParams.RegBase;
+
+  // Set TX_INT_CLK_SEL and Clear TX_MUX_SEL for HS modes to guarantee hold time
+  Value  = MmioRead32 (Base + SDHC_TX_CFG);
+  Value |= SDHC_TX_CFG_INT_CLK_SEL;
+  Value &= (~SDHC_TX_CFG_MUX_SEL);
+  MmioWrite32 (Base + SDHC_TX_CFG, Value);
+
+  // Clear HS200 flag for backward, HS26, HS52 modes
+  Value  = MmioRead32 (Base + SDHC_MMC_CTRL);
+  Value &= ~SDHC_MMC_MMC_HS200;
+  MmioWrite32 (Base + SDHC_MMC_CTRL, Value);
+
+  // stop bus clock
+  Value  = MmioRead32 (Base + SDHC_CLK_CRTL);
+  Value &= (~SDHC_CLOCK_TO_CARD_ENABLE);
+  MmioWrite32 (Base + SDHC_CLK_CRTL, Value);
+
+  // set bus clock and start clock
+  Value &= SDHC_CLOCK_FREQUENCY_MASK;
+  Value |= ((Div & 0xFF) << 8);
+  Value |= ((Div & 0x300) >> 2);
+  Value |= SDHC_CLOCK_INTERNAL_ENABLE;
+  MmioWrite32 (Base + SDHC_CLK_CRTL, Value);
+
+  // wait for clock to become stable
+  Timeout = 10000;
+  while (Timeout) {
+    gBS->Stall (1);
+    Value = MmioRead32 (Base + SDHC_CLK_CRTL);
+    if (Value & SDHC_CLOCK_INTERNAL_STABLE) {
+      break;
+    }
+
+    Timeout--;
+  }
+
+  if (Timeout <= 0) {
+    DEBUG ((DEBUG_ERROR, "%a: SD PLL setting FAILED!\n", __func__));
+  }
+
+  // start bus clock
+  Value  = MmioRead32 (Base + SDHC_CLK_CRTL);
+  Value |= SDHC_CLOCK_TO_CARD_ENABLE;
+  MmioWrite32 (Base + SDHC_CLK_CRTL, Value);
+  DEBUG ((DEBUG_INFO, "Set SD CLK_CRTL 0x%x\n", Value));
+}
+
+/**
+  Change transfer data width of SDHC.
+
+  @param[in] Width       The data witdh of SDHC.
+
+**/
+STATIC VOID
+SetSdhcBusWidth (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  IN INT32                         Width
+  )
+{
+  UINT32  Value;
+
+  switch (Width) {
+    case 1:
+      Width = SDHC_HOST_BUS_WIDTH_1BIT;
+      break;
+    case 4:
+      Width = SDHC_HOST_BUS_WIDTH_4BIT;
+      break;
+    case 8:
+      Width = SDHC_HOST_BUS_WIDTH_8BIT;
+      break;
+    default:
+      ASSERT (0);
+  }
+
+  Value  = MmioRead32 (MmcHcInstance->BmParams.RegBase + SDHC_HOST_CRTL);
+  Value &= SDHC_HOST_BUS_WIDTH_MASK;
+  Value |= Width;
+  MmioWrite32 (MmcHcInstance->BmParams.RegBase + SDHC_HOST_CRTL, Value);
+}
+
+/**
+  Detect the status of the SD card.
+
+  @return The status of the SD card:
+          - SDCARD_STATUS_INSERTED:      The SD card is inserted.
+          - SDCARD_STATUS_NOT_INSERTED:  The SD card is not inserted.
+          - SDCARD_STATUS_UNKNOWN:       The status of the SD card is unknown.
+
+**/
+INT32
+BmSdCardDetect (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance
+  )
+{
+  UINTN  GpioInput;
+
+  DEBUG ((DEBUG_VERBOSE, "%a: %d.\n", __func__, __LINE__));
+
+  // for EMMC it is always in the board; for sdcard, need detect it through GPIO
+  if ((MmcHcInstance->BmParams.IsEmmc) ||
+      ((EFI_SUCCESS == MmcHcInstance->Gpio->Get (MmcHcInstance->Gpio, MmcHcInstance->BmParams.DetectGpio, &GpioInput))
+       && (MmcHcInstance->BmParams.PluginState == GpioInput)))
+  {
+    MmcHcInstance->BmParams.CardIn = SDCARD_STATUS_INSERTED;
+  } else {
+    MmcHcInstance->BmParams.CardIn = SDCARD_STATUS_NOT_INSERTED;
+  }
+
+  DEBUG ((DEBUG_VERBOSE, "%a: %d, GpioInput: %d.\n", __func__, __LINE__, GpioInput));
+  return MmcHcInstance->BmParams.CardIn;
+}
+
+/**
+  set bus voltage
+
+**/
+STATIC void
+SetSdhcBusVoltage (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  UINT32                           Voltage
+  )
+{
+  UINT32  Data;
+
+  Data  = MmioRead32 (MmcHcInstance->BmParams.RegBase + SDHC_HOST_CRTL);
+  Data &= SDHC_HOST_BUS_VOLTAGE_MASK;
+  Data |= Voltage;
+  Data |= SDHC_HOST_BUS_POWER_ENABLE;
+  MmioWrite32 (MmcHcInstance->BmParams.RegBase + SDHC_HOST_CRTL, Data);
+}
+
+/**
+  provide first 74 clocks before any cmd after power up
+
+**/
+STATIC void
+GenerateSdhc74Clocks (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance
+  )
+{
+  UINT32  Data;
+  INT32   Timeout;
+  UINTN   Base;
+
+  Base = MmcHcInstance->BmParams.RegBase;
+  // clear and enable misc_int first
+  Data  = MmioRead32 (Base + SDHC_MMC_CTRL);
+  Data |= SDHC_MMC_MISC_INT_EN | SDHC_MMC_MISC_INT;
+  MmioWrite32 (Base + SDHC_MMC_CTRL, Data);
+
+  // generate 74 clocks
+  Data  = MmioRead32 (Base + SDHC_LEGACY_CTRL);
+  Data &= SDHC_LEGACY_CTRL_GEN_PAD_CLK_CNT_MASK;
+  Data |= (0x4A << 24) | SDHC_LEGACY_CTRL_GEN_PAD_CLK_ON;
+  MmioWrite32 (Base + SDHC_LEGACY_CTRL, Data);
+
+  Timeout = 100;
+  while (Timeout) {
+    gBS->Stall (100);
+    Data = MmioRead32 (Base + SDHC_MMC_CTRL);
+    if (Data & SDHC_MMC_MISC_INT) {
+      break;
+    }
+
+    Timeout--;
+  }
+
+  if (Timeout <= 0) {
+    DEBUG ((DEBUG_ERROR, "74 clocks generate Timeout\n"));
+  }
+
+  // clear misc_int
+  Data  = MmioRead32 (Base + SDHC_MMC_CTRL);
+  Data |= SDHC_MMC_MISC_INT;
+  MmioWrite32 (Base + SDHC_MMC_CTRL, Data);
+
+  // disable misc_int
+  Data  = MmioRead32 (Base + SDHC_MMC_CTRL);
+  Data &= (~SDHC_MMC_MISC_INT_EN);
+  MmioWrite32 (Base + SDHC_MMC_CTRL, Data);
+}
+
+/**
+  Initialize the eMMC PHY.
+
+**/
+STATIC
+VOID
+EmmcPhyInit (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance
+  )
+{
+  UINT32  Data;
+  UINTN   Base;
+
+  Base = MmcHcInstance->BmParams.RegBase;
+
+  Data  = MmioRead32 (Base + SDHC_MMC_CTRL);
+  Data |= SDHC_MMC_TYPE_EMMC;
+  MmioWrite32 (Base + SDHC_MMC_CTRL, Data);
+
+  // phy power up
+  Data  = MmioRead32 (Base + SDHC_PHY_CTRL);
+  Data |= 0x01;
+  MmioWrite32 (Base + SDHC_PHY_CTRL, Data);
+  gBS->Stall (1000);
+
+  // phy clock source pll lock set
+  Data  = MmioRead32 (Base + SDHC_PHY_CTRL);
+  Data |= 0x02;
+  MmioWrite32 (Base + SDHC_PHY_CTRL, Data);
+
+  Data  = MmioRead32 (Base + SDHC_PHY_PADCFG);
+  Data |= (1 << SDHC_RX_BIAS_CTRL_SHIFT);
+  MmioWrite32 (Base + SDHC_PHY_PADCFG, Data);
+
+  Data  = MmioRead32 (Base + SDHC_MMC_CTRL);
+  Data &= ~SDHC_MMC_ENHANCE_STROBE_EN;
+  MmioWrite32 (Base + SDHC_MMC_CTRL, Data);
+}
+
+/**
+  SD controller initialization.
+
+**/
+STATIC void
+InitSdhc (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance,
+  UINT32                           Voltage
+  )
+{
+  UINT32  Data;
+  UINTN   Base;
+
+  Base = MmcHcInstance->BmParams.RegBase;
+
+  // full reset controller
+  Data  = MmioRead32 (Base + SDHC_CLK_CRTL);
+  Data |= SDHC_CLOCK_SOFT_RESET_ALL;
+  MmioWrite32 (Base + SDHC_CLK_CRTL, Data);
+  gBS->Stall (100);
+
+ #ifdef SDH_SUPPORT_INLINE_ENCRYPT
+  /* disable hw crypto */
+  Data  = MmioRead32 (Base + SDHC_DLINE_CFG);
+  Data |= (0x1 << 8);
+  MmioWrite32 (Base + SDHC_DLINE_CFG, Data);
+ #endif
+
+  // set timeout value
+  Data  = MmioRead32 (Base + SDHC_CLK_CRTL);
+  Data &= SDHC_CLOCK_TIMEOUT_MASK;
+  Data |= SDHC_CLOCK_DEFAULT_TIMEOUT;
+  MmioWrite32 (Base + SDHC_CLK_CRTL, Data);
+
+  // disable all interrupt
+  MmioWrite32 (Base + SDHC_INT_ENABLE, 0);
+  // enable all interrupt status
+  MmioWrite32 (Base + SDHC_STATE_ENABLE, 0xFFFFFFFF);
+  // clear all interrupt
+  MmioWrite32 (Base + SDHC_NORMAL_STATE, 0xFFFFFFFF);
+
+  SetSdhcBusVoltage (MmcHcInstance, Voltage);
+  gBS->Stall (100);
+
+  if (!MmcHcInstance->BmParams.IsEmmc) {
+    Data  = MmioRead32 (Base + SDHC_TX_CFG);
+    Data |= SDHC_TX_CFG_INT_CLK_SEL;
+    Data &= (~SDHC_TX_CFG_MUX_SEL);
+    MmioWrite32 (Base + SDHC_TX_CFG, Data);
+  } else {
+    EmmcPhyInit (MmcHcInstance);
+  }
+
+  // set bus clock 200KHZ, 1bit Data width
+  BmSdSetIos (MmcHcInstance, SDHC_CLOCK_FREQUENCY_200KHZ, 1, EMMCBACKWARD);
+
+  // provide first 74 clocks before any cmd after power up
+  GenerateSdhc74Clocks (MmcHcInstance);
+}
+
+/**
+  SD card hardware initialization.
+
+**/
+STATIC
+VOID
+SdHwInit (
+  IN MMC_HOST_CONTROLLER_INSTANCE  *MmcHcInstance
+  )
+{
+  INT32   RetryCount;
+  UINT32  Value;
+
+  /* bit0 all sdh axi reset */
+  /* bit3 all sdh axi clock enable */
+  Value  = MmioRead32 (PMU_SDH0_CLK_CTRL);
+  Value |= (PMU_SDH_AXI_RST | PMU_SDH_AXICLK_EN);
+  MmioWrite32 (PMU_SDH0_CLK_CTRL, Value);
+
+  /* bit1 SD SDH Peripheral Reset */
+  /* bit4 SD SDH Peripheral Clock Enable */
+  /* bit6-7 SD SDH Clock source Select */
+  /* bit8-10 SD SDH Clock Frequency Divisor */
+  Value |= (SDH_CLK_SRC_0 << PMU_SDH_CLK_SEL_BASE | 1 << PMU_SDH_CLK_DIV_BASE);
+  MmioWrite32 (PMU_SD_CLK_CTRL, Value);
+
+  Value |= (PMU_SDH_RST | PMU_SDH_CLK_EN | PMU_SDH_CLK_FC_REQ);
+  MmioWrite32 (PMU_SD_CLK_CTRL, Value);
+
+  RetryCount = 100;
+  while (RetryCount) {
+    Value = MmioRead32 (PMU_SD_CLK_CTRL);
+    if ((Value & PMU_SDH_CLK_FC_REQ) == 0) {
+      break;
+    }
+
+    RetryCount--;
+    gBS->Stall (10);
+  }
+
+  if (!RetryCount) {
+    DEBUG ((DEBUG_ERROR, "%a: SD init Timeout\n", __func__));
+  }
+
+  InitSdhc (MmcHcInstance, SDHC_HOST_BUS_VOLTAGE_3V3);
+}
