# EDK2 inputs for the OrangePi R2S and RV2 (SpacemiT K1). scripts/fetch-edk2.py
# fetches each base, applies patches/edk2/<project>/*.patch with git am and
# checks the result against the tree below.
#
# edk2: plain TianoCore, no patches (the commit the K1 port was developed on).
EDK2_URL=https://github.com/tianocore/edk2.git
EDK2_BASE=fbe0805b2091393406952e84724188f8c1941837
EDK2_TREE=f0ddf2aa9c2ca88b92e26266bc6ac1790d1e3d93
EDK2_SUBMODULES="BaseTools/Source/C/BrotliCompress/brotli MdeModulePkg/Library/BrotliCustomDecompressLib/brotli MdePkg/Library/BaseFdtLib/libfdt CryptoPkg/Library/OpensslLib/openssl CryptoPkg/Library/MbedTlsLib/mbedtls MdeModulePkg/Universal/RegularExpressionDxe/oniguruma MdePkg/Library/MipiSysTLib/mipisyst RedfishPkg/Library/JsonLib/jansson SecurityPkg/DeviceSecurity/SpdmLib/libspdm"
#
# edk2-platforms: TianoCore plus SpacemiT's four K1 commits (bianbu-maker/
# edk2-platforms k1 at 1bad7a5403), kept here as patches with their authors.
EDK2_PLATFORMS_URL=https://github.com/tianocore/edk2-platforms.git
EDK2_PLATFORMS_BASE=ff3c7adf07854bf3bb82f3362ac8ec2b03c14710
EDK2_PLATFORMS_TREE=6681ad2c9f071ed5833de0861695f3c5b7711eee
EDK2_PLATFORMS_SUBMODULES=all
#
# Local mirror branches: ~/src/edk2 and ~/src/edk2-platforms board/orangepi-r2s
# and board/orangepi-rv2 (xitely/edk2, xitely/edk2-platforms on Forgejo).
